# Keep line endings as LF everywhere, including checkouts on Windows. Shell scripts break
# otherwise.
* text=auto eol=lf
*.png binary
*.glb binary
*.bin binary
# The decisions log is only ever appended to: two agents adding lines at once both keep theirs,
# with no conflict, as changelogs commonly merge.
docs/decisions-log.md merge=union
# The decisions index is written from docs/decisions/ (D389). Two agents adding rows at once both
# keep theirs; a merge that leaves it wrong fails the docs check, and --render mends it.
docs/decisions.md merge=union
