# Keep line endings as LF everywhere, including checkouts on Windows. Shell scripts break
# otherwise.
* text=auto eol=lf
# Binary assets and source art live in Git LFS (D525): the repository holds a pointer, the file
# itself is fetched on checkout. Every file of these types, however small, so the rule is the
# extension alone and the hooks can check it (tools/git/lfs.ts). `-text` keeps git's line-ending
# conversion and text merges off them, as `binary` did. Models and their buffers:
*.glb filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.vox filter=lfs diff=lfs merge=lfs -text
# Images and textures:
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.ktx2 filter=lfs diff=lfs merge=lfs -text
*.dds filter=lfs diff=lfs merge=lfs -text
# Motion capture (text, but generated, large and never diffed):
*.bvh filter=lfs diff=lfs merge=lfs -text
# Sound, video and fonts:
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text
# Bevy's crates we carry a change to (D184) keep their few binaries in git: bevy_pbr compiles its
# .ktx2 files in with include_bytes!, which must never read a pointer.
patches/**/*.ktx2 -filter binary
patches/**/*.png -filter binary
# The decisions log is only ever appended to: two agents adding lines at once both keep theirs,
# with no conflict, as changelogs commonly merge.
docs/decisions-log.md merge=union
# Indexes rendered from files of their own (D389, D409) merge row by row (tools/docs/merge.ts,
# which `cargo xtask` sets up as `merge.rendered`): two agents adding a decision or a note at once
# both keep theirs, in order. What it cannot merge is a conflict that --render mends.
docs/decisions.md merge=rendered
research/README.md merge=rendered
