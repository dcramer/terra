// The ruin at night (iso-art): an action RPG's night fight in a ruined court, a knight
// against an ogre and a tree monster on broken flagstones between fallen walls, lit by the
// moon and by braziers and torches. `--biome ruin`, or `--scene ruin`.
// The schema: spike/iso/src/kit/biome.rs; how to add a biome: the iso-art skill's kit.md.
(
    kind: [Night],
    refs: "ruin",
    // Its scatter, decals, water, effects and life are still ruin/'s own code; they move here
    // as the kit's jobs land. The court's paving and its maps are the layout's (ruin/ground.rs).
    layout: Ruin,
    light: (preset: "ruin-night"),
    ground: (
        // The court's flags (kit/laid.rs): Poly Haven's Large Grey Tiles at their true 3 m,
        // grime in the joints, cracks, the stone grain, moss and puddles where the court's
        // maps lay them.
        laid: (
            material: "large_grey_tiles",
            metres: 3.0,
            joints: 0.3,
            // Sand and soil in the joints, not black lines (the open court read clean CG,
            // judge 261107-0250-ruin).
            sand: 0.75,
            // No drawn crack web (at 0.25 "crack lines that look drawn on", judge 261107-0150).
            cracks: 1.0,
            grain: (0.5, 0.6),
            moss: Site("mossy"),
            wet: Site("puddled"),
            // The scan's three courses and their joints, off its colour map: each flag its
            // own value, warmth and roughness.
            courses: [
                (0.008, [0.069, 0.443, 0.705]),
                (0.345, [0.086, 0.399, 0.726]),
                (0.677, [0.005, 0.337, 0.630]),
            ],
            spread: (0.22, 0.3),
            dirt: 0.7,
            damp: 0.6,
            feet: Site("walls"),
        ),
    ),
    // The rain pool by the west brazier, the kit's water (kit/water.rs, ruin/water.rs, iso-kit
    // j38): a skin 2 cm over the flags (their settling is 1.5 cm about 0.01), so its line is
    // the face's fade over ruin/water.rs's depth, out on whole flags, not the paving's cut
    // ("stepped polygon rims and no wet edge", judge 261107-0302). Dark and still: a few cm
    // over the sunk flags shows them dim, black where they broke; the fires and the fight in
    // its mirror, each fire's streak across it, the moon's lane faint (as the marsh's).
    water: (
        kind: Pond,
        level: 0.03,
        deep: Srgb(0.02, 0.019, 0.018),
        absorb: (24.0, 22.0, 20.0),
        shore: 0.008,
        mirror: (lift: 2.0, distort: 0.02),
        ripples: (fine: 0.7, broad: 3.0, steep: 0.02, calm: 0.9),
        streaks: (glitter: 0.1, gain: 0.6, key: 0.1, dash: 1.0),
    ),
    // The staged fight's effects (biomes/effects/, kit/effects.rs).
    effects: [(preset: "slash"), (preset: "hit-spark"), (preset: "smoke-puff"), (preset: "spell-burst"), (preset: "bolt")],
)
