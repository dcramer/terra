// A city street at night after rain (iso-kit j11): a kerbed road between pavements, tall
// fronts to the north with storeys of windows, low shops to the south, sodium lamps over the
// road and neon signs on the walls, each lighting the wet asphalt in its colour. Drawn by the
// kit's Street layout (kit/street.rs); rain, steam, holograms, drones and litter are later
// jobs. The schema: spike/iso/src/kit/biome.rs; how to add a biome: the iso-art skill's kit.md.
(
    kind: [Night, Rain],
    refs: "neon-street",
    layout: Street,
    street: (
        road: 7.0,
        walk: 3.2,
        kerb: (0.3, 0.15),
        length: 70.0,
        focus: (0.0, -4.0),
        // Just after rain: a film of the water (8 mm, a third of a puddle's mirror at its
        // 2 cm shore) over all the paving, so the lights streak across the whole wet road.
        film: 0.008,
        // The road: Poly Haven's worn Asphalt 02 at its 3 m, its own long cracks a little
        // darker (`joints` darkens what its occlusion marks: 1 clean, 0 black), none of the
        // kit's crack web (crazing reads as dried mud on asphalt), the detail grain fine as
        // its aggregate; wet all over and standing in patches and along the gutters.
        asphalt: (
            material: "asphalt_02",
            metres: 3.0,
            joints: 0.6,
            cracks: 1.0,
            grain: (0.2, 0.7),
            wet: Site("puddled"),
            dirt: 0.3,
            grit: 0.25,
            damp: 0.9,
            feet: Site("walls"),
            // A city road's marks (kit/laid.rs), the road along x, its lanes' middles at z
            // ±1.75: three patched repairs; dripped oil down each lane's middle and the
            // wheel paths' rubber either side; worn white centre dashes (3 m every 9 m), a
            // zebra crossing (seven 0.5 m stripes a metre apart) with a stop line each side,
            // and double yellow lines along both kerbs.
            marks: [
                (kind: Patch, at: (-7.5, 1.4), size: (3.2, 1.1), amount: 0.9),
                (kind: Patch, at: (7.5, -1.6), size: (1.6, 1.4), turn: 4.0, amount: 0.8),
                (kind: Patch, at: (-10.5, -2.4), size: (0.9, 0.7), turn: -6.0, amount: 0.7),
                (kind: Stain, at: (0.0, 0.0), size: (80.0, 0.7), every: (0.0, 3.5),
                 count: (1, 2), amount: 0.6),
                (kind: Stain, at: (0.0, 1.75), size: (80.0, 0.45), every: (0.0, 1.7),
                 count: (1, 2), amount: 0.45),
                (kind: Stain, at: (0.0, -1.75), size: (80.0, 0.45), every: (0.0, 1.7),
                 count: (1, 2), amount: 0.45),
                (kind: White, at: (3.0, 0.0), size: (3.0, 0.12), every: (9.0, 0.0),
                 count: (9, 1), amount: 0.75),
                (kind: White, at: (-1.5, 0.0), size: (3.0, 0.5), every: (0.0, 1.0),
                 count: (1, 7), amount: 0.8),
                (kind: White, at: (-4.0, 1.75), size: (0.3, 3.3), amount: 0.7),
                (kind: White, at: (1.0, -1.75), size: (0.3, 3.3), amount: 0.7),
                // The gutters: the last 0.3 m of road at each kerb, where the run-off
                // and its silt lie, darker under the double yellows.
                (kind: Stain, at: (0.0, 0.0), size: (80.0, 0.3), every: (0.0, 6.7),
                 count: (1, 2), amount: 0.8),
                (kind: Yellow, at: (0.0, 0.0), size: (80.0, 0.1), every: (0.0, 6.5),
                 count: (1, 2), amount: 0.65),
                (kind: Yellow, at: (0.0, 0.0), size: (80.0, 0.1), every: (0.0, 6.1),
                 count: (1, 2), amount: 0.65),
            ],
        ),
        kerbs: (
            material: "granite_tile_04",
            metres: 2.0,
            joints: 0.3,
            cracks: 1.0,
            grain: (0.4, 0.5),
            wet: Site("gutter"),
            damp: 0.6,
        ),
        // The north fronts' faces are bays of Poly Haven's apartments facade (kit/facade.rs,
        // iso-kit j26), its scenes: 0 door-large, 1 door-small, 2 shop-window (two sash
        // windows to the ground), 3 plain, 4 window-large, 5 window-double, 6 window-small,
        // 7 window-offset, 8 crown, 9 pier. The street storey's plain bays stand behind the
        // rollershutters (their models' middles 1 m along from their `at`), its shop windows
        // under the signs; heights are whole 3 m storeys. Behind the glass each bay is a room
        // 2.2 m deep (kit/rooms.rs, iso-kit j37): lit warm or cold, some by a TV's blue
        // alone, some with blinds or curtains part drawn, some dark or shuttered, by a hash.
        fronts: [
            (side: North, along: (-35.0, -9.0), height: 15.0, material: "concrete_wall_006",
             metres: 2.0, roof: "asphalt_02",
             bays: (model: "models/iso/city/facade-apartments.glb",
                    ground: [2, 1, 2, 3, 0, 2, 3, 2, 1], upper: [5, 4, 5, 6], top: 8, pier: 9,
                    lit: 0.4, shops: (0.85, 8.0), nits: 6.0,
                    colours: [Srgb(1.0, 0.72, 0.42), Srgb(0.62, 0.8, 1.0)],
                    paint: Srgb(0.78, 0.5, 0.4), grime: 0.35,
                    back: 2.2,
                    rooms: (tv: 0.2, blinds: 0.25, curtains: 0.25, shut: 0.3,
                            cloth: [Srgb(0.55, 0.12, 0.1), Srgb(0.75, 0.62, 0.4)],
                            shutters: [Srgb(0.42, 0.45, 0.43), Srgb(0.45, 0.35, 0.25)]))),
            (side: North, along: (-9.0, 6.0), height: 9.0, material: "rusty_corrugated_iron",
             metres: 2.0, tint: (0.7, 0.7, 0.72), roof: "asphalt_02",
             bays: (model: "models/iso/city/facade-apartments.glb",
                    ground: [3, 2, 1, 3, 2], upper: [6, 7], top: 8, pier: 9,
                    lit: 0.4, shops: (0.85, 8.0), nits: 5.0,
                    colours: [Srgb(1.0, 0.72, 0.42), Srgb(1.0, 0.85, 0.6)],
                    paint: Srgb(0.9, 0.84, 0.68), grime: 0.45,
                    back: 2.2,
                    rooms: (tv: 0.25, blinds: 0.3, curtains: 0.15, shut: 0.45,
                            cloth: [Srgb(0.2, 0.35, 0.3)],
                            shutters: [Srgb(0.3, 0.38, 0.42), Srgb(0.42, 0.45, 0.43)]))),
            (side: North, along: (6.0, 35.0), height: 21.0, material: "concrete_wall_006",
             metres: 2.0, tint: (0.85, 0.8, 0.74), roof: "asphalt_02",
             bays: (model: "models/iso/city/facade-apartments.glb",
                    ground: [2, 2, 3, 0, 3, 2, 1, 2, 0, 2], upper: [4, 5, 4, 7], top: 8, pier: 9,
                    lit: 0.35, shops: (0.85, 8.0), nits: 6.0,
                    colours: [Srgb(1.0, 0.72, 0.42), Srgb(0.62, 0.8, 1.0),
                              Srgb(1.0, 0.9, 0.75)],
                    paint: Srgb(0.6, 0.66, 0.72), grime: 0.35,
                    back: 2.2,
                    rooms: (tv: 0.2, blinds: 0.3, curtains: 0.2, shut: 0.25,
                            cloth: [Srgb(0.75, 0.62, 0.4), Srgb(0.3, 0.2, 0.45)],
                            shutters: [Srgb(0.42, 0.45, 0.43)]))),
            (side: South, along: (-35.0, -4.0), height: 4.0, material: "concrete_wall_006",
             metres: 2.0, roof: "asphalt_02"),
            (side: South, along: (-4.0, 35.0), height: 3.6, material: "rusty_corrugated_iron",
             metres: 2.0, tint: (0.7, 0.7, 0.72), roof: "asphalt_02"),
        ],
        // Sodium lamps (about 2000 K) over the road, sides taking turns.
        lamps: (every: 16.0, start: -24.0, height: 6.5, reach: 1.6,
                colour: Srgb(1.0, 0.62, 0.25), lumens: 600000.0, angle: 60.0, range: 14.0,
                shadows: true),
        // Textures from text by ffmpeg (assets/models/iso/city/README.md, signs).
        signs: [
            (texture: "models/iso/city/signs/ramen.png", side: North, at: -12.0, height: 6.5,
             size: (0.9, 3.15), blade: true, colour: Srgb(1.0, 0.16, 0.55), nits: 30.0,
             lumens: 100000.0),
            (texture: "models/iso/city/signs/bar.png", side: North, at: -3.0, height: 4.6,
             size: (2.9, 1.1), colour: Srgb(0.1, 0.82, 1.0), nits: 30.0, lumens: 100000.0),
            (texture: "models/iso/city/signs/drug.png", side: North, at: 3.6, height: 5.6,
             size: (1.0, 2.0), colour: Srgb(0.22, 1.0, 0.42), nits: 30.0, lumens: 70000.0),
            (texture: "models/iso/city/signs/24h.png", side: North, at: 9.0, height: 4.4,
             size: (2.2, 1.0), colour: Srgb(1.0, 0.19, 0.09), nits: 30.0, lumens: 80000.0),
        ],
        props: [
            (model: "models/iso/city/rollershutter-door.glb", side: North, line: Wall,
             at: [-17.22, -8.5, 12.25, 18.05], out: -0.2),
            (model: "models/iso/city/trash-bag.glb", side: North, line: Wall,
             at: [-7.9, -7.4, 10.6], out: 0.2),
            (model: "models/iso/city/propane-tank.glb", side: North, line: Wall, at: [-8.6]),
            (model: "models/iso/city/utility-box.glb", side: North, line: Wall, at: [1.2]),
            (model: "models/iso/city/oil-barrel.glb", side: South, line: Wall, at: [-9.0, -8.3]),
            (model: "models/iso/city/trash-bag.glb", side: South, line: Wall, at: [-2.0, 5.5],
             turn: 40.0),
            (model: "models/iso/city/old-tyre.glb", side: South, line: Kerb, at: [-5.5],
             turn: 30.0),
            // A car parked at the north kerb past the crossing, under a tarp (1.78 m wide,
            // 4.34 m long), its near side 0.25 m off the kerb's face.
            (model: "models/iso/city/covered-car.glb", side: North, line: Road, at: [8.5],
             out: 2.36, turn: 90.0),
            (model: "models/iso/city/manhole-cover.glb", side: North, line: Road, at: [4.0],
             out: 1.2),
            // People, for the street's scale (the iso hero, 1.85 m, held in his clips):
            // one walking the pavement under the pharmacy's sign, one crossing at the zebra.
            (model: "models/iso/knight.glb", side: North, line: Wall, at: [3.0], out: 1.0,
             turn: 75.0, pose: ("walk", 0.4)),
            (model: "models/iso/knight.glb", side: North, line: Road, at: [-1.5], out: 1.2,
             turn: 15.0, pose: ("walk", 1.5)),
        ],
    ),
    light: (preset: "city-night-rain"),
    // The kit's water (kit/water.rs) standing in the street's `puddled` patches, a few
    // millimetres over the road and the pavements: a clear film on the dark wet floor that
    // mirrors the lamps, signs and fronts (at the marsh's lift), each light's streak long
    // toward the eye; near still, no rain's rings yet.
    water: (
        kind: Puddles,
        level: 0.004,
        film: 0.01,
        deep: Srgb(0.02, 0.02, 0.022),
        shore: 0.02,
        mirror: (lift: 3.0, distort: 0.04, smear: 0.04),
        ripples: (fine: 1.3, broad: 5.5, steep: 0.06, calm: 0.5),
        // Rain's rings in the puddles (kit/water.wesl), a few a square metre.
        rain: 4.0,
        // Each lamp's highlight a long streak toward the eye, as on a wet road at night:
        // the lobe spread along the view 2.5 times the default's, three times its gain.
        streaks: (along: 0.25, across: 0.04, gain: 3.0),
    ),
    // Rain falling (kit/weather.rs, iso-kit j19): streaks seen only in the lamps' and signs'
    // light, splashes on the paving.
    weather: (wind: (0.6, 0.2), rain: 0.7, drops: (bright: 0.06, splashes: 0.7)),
    ground: (
        // The pavements: Poly Haven's Concrete Pavement flags laid at 2.7 m, so each is a
        // street's 900 x 450 mm flag (its 1.8 m made them 600 x 300 mm block pavers), their
        // straight joints grimed; no crack web (crazing reads as dried mud).
        laid: (
            material: "concrete_pavement",
            metres: 2.7,
            joints: 0.3,
            cracks: 1.0,
            grain: (0.3, 0.6),
            wet: Site("puddled"),
            dirt: 0.4,
            grit: 0.2,
            damp: 0.7,
            feet: Site("walls"),
        ),
    ),
    // Litter by the wall feet and the kerbs (kit/scatter.rs on the street's `walls` map):
    // bin bags heaped in piles, flattened and tipped boxes among them, as a city's back
    // street leaves them out the night before collection.
    scatter: [
        (models: ["models/iso/city/trash-bag.glb"], density: 0.9, scale: (0.55, 1.15),
            on: Site("walls"), clump: (4.0, 0.8, 0.9), tilt: 15.0, seed: 7),
        (models: ["models/iso/city/cardboard-box.glb"], density: 0.15, scale: (0.6, 1.3),
            on: Site("walls"), clump: (4.0, 0.8, 0.9), tilt: 25.0, seed: 7),
    ],
)
