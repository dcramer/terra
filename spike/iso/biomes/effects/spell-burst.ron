// An arcane bolt striking the bark (kit/effects.rs): a blue-white core in a blue halo, its
// light and a blue pool on the ground, a few short sparks thrown back off the bark over
// 0.05 s, falling and dimming. iso-kit j43 cut the starburst (36 long streaks born together)
// and the 1.4 m halo, as the hit's.
(
    cue: Bolt,
    at: Bark,
    still: 0.08,
    life: 0.45,
    flash: (core: Srgb(0.85, 0.92, 1.0), core_nits: 6000.0, rim: Srgb(0.3, 0.55, 1.0), rim_nits: 320.0,
        size: 0.8, core_size: 0.1, falloff: 6.0, swell: 0.4, fall: 0.1),
    lamps: [
        (lm: 55000.0, colour: Srgb(0.55, 0.7, 1.0), up: 0.2, range: 5.0, fall: 0.15),
        (lm: 20000.0, colour: Srgb(0.45, 0.62, 1.0), up: 0.5, ground: true, range: 2.5, fall: 0.3),
    ],
    sparks: (count: 16, speed: (1.5, 4.5), life: (0.15, 0.4), width: 0.013, spread: 0.9,
        gravity: 6.0, shutter: 0.02, hot: Srgb(0.9, 0.95, 1.0), hot_nits: 5000.0,
        cool: Srgb(0.3, 0.5, 1.0), cool_nits: 500.0, area: 0.05, delay: 0.05),
)
