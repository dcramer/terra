    cue: Bolt,
    at: Bark,
    still: 0.08,
    life: 0.45,
    flash: (core: Srgb(0.85, 0.92, 1.0), core_nits: 6000.0, rim: Srgb(0.3, 0.55, 1.0), rim_nits: 550.0,
        size: 1.4, core_size: 0.1, falloff: 6.0, swell: 0.5, fall: 0.1),
    lamps: [
        (lm: 55000.0, colour: Srgb(0.55, 0.7, 1.0), up: 0.2, range: 5.0, fall: 0.15),
        (lm: 20000.0, colour: Srgb(0.45, 0.62, 1.0), up: 0.5, ground: true, range: 2.5, fall: 0.3),
    ],
    sparks: (count: 36, speed: (2.5, 7.0), life: (0.1, 0.3), width: 0.02, spread: 0.9,
        gravity: 4.0, shutter: 0.03, hot: Srgb(0.9, 0.95, 1.0), hot_nits: 5000.0,
        cool: Srgb(0.3, 0.5, 1.0), cool_nits: 300.0),
)
