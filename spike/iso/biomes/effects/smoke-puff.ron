// Dust and smoke thrown off the blow (kit/effects.rs): soft lit puffs, warm at birth, widening.
(
    cue: Blow,
    at: Strike,
    // A still shows the dust at the hit's moment (0.1 s, the hit's still), lit by its lamps.
    still: 0.1,
    life: 1.2,
    puffs: (count: 10, size: (0.35, 1.1), life: (0.6, 1.1), rise: 0.35, spread: 0.3,
        albedo: Srgb(0.4, 0.38, 0.35), density: 0.6, delay: 0.04,
        glow: Srgb(1.0, 0.5, 0.2), glow_nits: 30.0, grain: 0.6, soft: 0.3),
)
