// The marsh at dusk (iso-art): mud banks and mossy hummocks between open channels of still
// dark water, reeds in the wind, dead trees in the water, low fog, fireflies and wisps, a
// camp fire and a lantern for the warm pools; the knight fights on a mud bank.
// `--biome marsh`, or `--scene marsh`.
// The schema: spike/iso/src/kit/biome.rs; how to add a biome: the iso-art skill's kit.md.
(
    kind: [Dusk, Water],
    refs: "marsh",
    // Its scatter, effects and life are still marsh/'s own code; they move here as the kit's
    // jobs land. Its water is the kit's; the moon's lane on it reads this light's key.
    layout: Marsh,
    light: (preset: "marsh-dusk"),
    // The kit's ground (kit/ground.rs) over marsh/land.rs's maps (terrain.rs `SITES`).
    ground: (
        layers: [
            (material: "leafy_grass", mask: Site("grass"), tint: (1.55, 2.1, 1.2)),
            (material: "forest_leaves_04", mask: Site("leaves"), tint: (1.5, 1.45, 1.35),
                breakup: (0.21, 0.9, 0.65, 0.35)),
            (material: "dry_decay_leaves", mask: Site("leaves"), tint: (1.45, 1.4, 1.3),
                breakup: (0.21, 0.9, 0.35, 0.65)),
            (material: "moss_004", mask: Site("moss"), tint: (5.0, 6.0, 3.2)),
            // The black mud at the water's line, in the hollows and down the path: wet.
            (material: "brown_mud_02", mask: Site("mud"), wets: 1.0),
            (material: "roots", mask: Site("roots"), tint: (1.3, 1.3, 1.3)),
        ],
        // The glade's camp fire's ash, kept as the marsh drew it (by the near channel's
        // bank, not at the marsh's own fire).
        scorch: [(0.0, 3.0)],
    ),
    // The kit's water (kit/water.rs): black, still water mirroring the trees, the sky and
    // the lights over it; duckweed in clumps at the margin and lily pads in the shallows.
    water: (
        kind: Pond,
        level: 0.0,
        deep: Srgb(0.03, 0.03, 0.025),
        mirror: (lift: 3.0, sky: Linear(0.5, 0.6, 0.8), nits: 30.0),
        scum: (colour: Linear(0.035, 0.07, 0.018), amount: 0.6, reach: 0.2, size: 2.4),
        pads: (count: 0.9, radius: 0.24, colour: Linear(0.035, 0.07, 0.018)),
    ),
    weather: (wind: (0.86, 0.5)),
)
