// The marsh at dusk (iso-art): mud banks and mossy hummocks between open channels of still
// dark water, reeds in the wind, dead trees in the water, low fog, fireflies and wisps, a
// camp fire and a lantern for the warm pools; the knight fights on a mud bank.
// `--biome marsh`, or `--scene marsh`.
// The schema: spike/iso/src/kit/biome.rs; how to add a biome: the iso-art skill's kit.md.
(
    kind: [Dusk, Water],
    refs: "marsh",
    // Its reeds (plants.rs), effects and life are still marsh/'s own code; they move here as
    // the kit's jobs land. Its water and scatter are the kit's; the moon's lane on the water
    // reads this light's key.
    layout: Marsh,
    light: (preset: "marsh-dusk"),
    // The kit's ground (kit/ground.rs) over marsh/land.rs's maps (terrain.rs `SITES`).
    ground: (
        layers: [
            (material: "leafy_grass", mask: Site("grass"), tint: (1.55, 2.1, 1.2)),
            (material: "forest_leaves_04", mask: Site("leaves"), tint: (1.5, 1.45, 1.35),
                breakup: (0.21, 0.9, 0.65, 0.35)),
            (material: "dry_decay_leaves", mask: Site("leaves"), tint: (1.45, 1.4, 1.3),
                breakup: (0.21, 0.9, 0.35, 0.65)),
            (material: "moss_004", mask: Site("moss"), tint: (5.0, 6.0, 3.2)),
            // The black mud at the water's line, in the hollows and down the path: wet.
            (material: "brown_mud_02", mask: Site("mud"), wets: 1.0),
            (material: "roots", mask: Site("roots"), tint: (1.3, 1.3, 1.3)),
        ],
        // The glade's camp fire's ash, kept as the marsh drew it (by the near channel's
        // bank, not at the marsh's own fire).
        scorch: [(0.0, 3.0)],
    ),
    // The kit's water (kit/water.rs): black, still water mirroring the trees, the sky and
    // the lights over it; duckweed in clumps at the margin and lily pads in the shallows.
    water: (
        kind: Pond,
        level: 0.0,
        deep: Srgb(0.03, 0.03, 0.025),
        mirror: (lift: 3.0, sky: Linear(0.5, 0.6, 0.8), nits: 30.0),
        scum: (colour: Linear(0.035, 0.07, 0.018), amount: 0.6, reach: 0.2, size: 2.4),
        pads: (count: 0.9, radius: 0.24, colour: Linear(0.035, 0.07, 0.018)),
    ),
    // The ground cover and the debris by the water, the kit's scatter (kit/scatter.rs) over
    // land.rs's maps and the rules: masses with gaps, never an even lawn, sizes several-fold
    // apart; at the water's line a mat of dead rush, sticks and stones half sunk in the mud.
    scatter: [
        // Sedge tussocks on the hummocks' grass, olive to straw.
        (plant: (kind: Tuft, tint: [(0.34, 0.5, 0.14), (0.28, 0.48, 0.18), (0.62, 0.47, 0.18)]),
            density: 3.0, scale: (0.14, 0.55), on: Site("grass"), clump: (5.0, 1.2, 0.6),
            over: (0.05, 9.0), seed: 1),
        // Ferns in the moss's cushions, and a few real ferns among them.
        (plant: (kind: Fern, tint: [(0.18, 0.46, 0.22), (0.3, 0.52, 0.16)]),
            density: 2.0, scale: (0.2, 0.6), on: Site("moss"), clump: (4.0, 1.0, 0.7),
            over: (0.08, 9.0), seed: 2),
        (models: ["models/nature/forest/fern.glb"], density: 0.12, scale: (0.2, 0.5),
            on: Site("moss"), clump: (4.0, 1.0, 0.7), tilt: 6.0, over: (0.08, 9.0), seed: 2),
        // Low shrubs over the leaf litter: bog myrtle's green to a bilberry's red-brown.
        (plant: (kind: Leaves, tint: [(0.24, 0.44, 0.16), (0.46, 0.26, 0.14)]),
            density: 1.8, scale: (0.22, 0.75), on: Site("leaves"), clump: (7.0, 1.5, 0.7),
            over: (0.08, 9.0), seed: 3),
        // The bank's mat: dead rush, straw to wet brown, thick at the water's line, a few
        // marsh marigolds in it.
        (plant: (kind: Tuft, tint: [(0.42, 0.34, 0.16), (0.3, 0.26, 0.12), (0.22, 0.24, 0.1)],
            flowers: 0.04),
            density: 6.0, scale: (0.15, 0.45), on: Mud, clump: (3.0, 0.8, 0.5),
            over: (-0.04, 0.2), seed: 4),
        // Sticks and branches half sunk at the edge, and stones in the mud.
        (models: ["models/props/Log.glb"], density: 0.25, scale: (0.15, 0.5), on: Mud,
            clump: (4.0, 1.0, 0.5), tilt: 10.0, sink: 0.03, over: (-0.08, 0.25), seed: 5),
        (models: ["models/nature/forest/mossy_rock_a_1.glb", "models/nature/forest/mossy_rock_a_3.glb",
            "models/nature/forest/mossy_rock_b_2.glb", "models/nature/forest/mossy_rock_b_5.glb"],
            density: 0.3, scale: (0.03, 0.12), on: Mud, clump: (4.0, 1.0, 0.5), sink: 0.01,
            over: (-0.1, 0.3), seed: 5),
    ],
    weather: (wind: (0.86, 0.5)),
    // The staged fight's effects (biomes/effects/, kit/effects.rs).
    effects: [(preset: "slash"), (preset: "hit-spark"), (preset: "smoke-puff"), (preset: "spell-burst"), (preset: "bolt")],
)
