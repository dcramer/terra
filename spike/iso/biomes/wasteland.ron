// The wasteland (uc-wasteland j2): an old two-lane highway through a dead roadside town in
// the desert, by day, the kit's non-fantasy second after the neon street ("make sure that
// we can do non-fantasy as well", the developer). Its refs (refs/wasteland/refs.md): an
// abandoned gas station's cracked apron in Arizona, a derelict lot's broken asphalt, a junk
// lot from above, overgrown concrete ruins; Wasteland 3's camp for junk at the camera. The
// same Street layout as the neon street (kit/street.rs): the road is sun-bleached asphalt
// broken and patched, its lines worn to traces; the verges are dirt of broken concrete
// and brick rubble in dust; the north side a concrete garage, a rusted iron shed and a block with its
// windows out; the south a corrugated fence and a low broken wall; utility poles with
// sagging lines; junk (tyres, barrels, cans, a covered car) gathered at the walls, dry
// grass in the gutters. Scans: concrete_debris, rusty_corrugated_iron
// (Poly Haven, CC0, assets/materials/README.md); props from assets/models/iso/city/.
(
    kind: [Day],
    refs: "wasteland",
    layout: Street,
    street: (
        road: 7.0,
        walk: 4.0,
        kerb: (0.3, 0.1),
        length: 70.0,
        focus: (0.0, -2.0),
        cables: [
            // Two leaning timber poles on the south verge, a third north, the lines sagging
            // between them and one dropped low.
            (from: (-9.0, 8.5, 6.2), to: (-9.0, 0.0, 6.2), radius: 0.13,
             colour: Srgb(0.33, 0.27, 0.2), rough: 0.9),
            (from: (9.5, 8.3, 6.3), to: (9.2, 0.0, 6.0), radius: 0.13,
             colour: Srgb(0.3, 0.25, 0.19), rough: 0.9),
            (from: (2.0, 8.0, -7.6), to: (2.0, 0.0, -7.6), radius: 0.12,
             colour: Srgb(0.32, 0.26, 0.2), rough: 0.9),
            // The lines black and weathered (j2's took the default pale grey and read as
            // straight light strokes across the frame).
            (from: (-9.0, 8.2, 6.2), to: (9.4, 8.0, 6.25), sag: 0.9, radius: 0.012,
             count: 3, every: (0.0, 0.0, 0.35), colour: Srgb(0.04, 0.04, 0.04), rough: 0.6),
            (from: (-9.0, 7.6, 6.2), to: (2.0, 7.4, -7.6), sag: 1.1, radius: 0.012,
             colour: Srgb(0.04, 0.04, 0.04), rough: 0.6),
            (from: (2.0, 7.7, -7.6), to: (9.4, 2.2, 6.0), sag: 1.6, radius: 0.012,
             colour: Srgb(0.04, 0.04, 0.04), rough: 0.6),
        ],
        asphalt: (
            material: "asphalt_02",
            metres: 3.0,
            joints: 0.7,
            cracks: 0.6,
            grain: (0.25, 0.8),
            dirt: 1.0,
            grit: 0.6,
            feet: Site("walls"),
            // Blotched with dust and old oil, no spots (j2's 0.3 m spots read as round black
            // tar splats all over the road) and no patched repairs (their sealed edges read
            // as rectangles drawn in dark outline): a dead road's surface is its cracks.
            // Broad dark tar a metre to a few across, sealcoat and old spills soaked in, as
            // on the derelict lot's broken asphalt (round 1510's road read as one clean
            // uniform sheet: thin crack seal and oil stains, round 1513/1514, barely showed;
            // `damp: 1.0`'s soft glossy patches read as wet, round 261107-1518).
            grime: (blotch: 1.0, earth: 0.8, tar: 0.7),
            marks: [
                (kind: Stain, at: (0.0, 1.75), size: (80.0, 0.6), every: (0.0, 3.5),
                 count: (1, 2), amount: 0.45),
                (kind: Stain, at: (1.8, 0.4), size: (1.6, 1.0), turn: 10.0, amount: 0.8),
                (kind: Stain, at: (-8.4, -1.3), size: (1.1, 0.8), amount: 0.7),
                (kind: Yellow, at: (0.0, 0.0), size: (3.0, 0.12), every: (6.0, 0.0),
                 count: (12, 1), amount: 0.35),
                (kind: White, at: (0.0, 3.2), size: (80.0, 0.12), every: (0.0, 6.4),
                 count: (1, 2), amount: 0.3),
            ],
        ),
        kerbs: (
            material: "concrete_pavement",
            metres: 2.7,
            joints: 0.4,
            cracks: 0.7,
            grain: (0.3, 0.6),
            dirt: 0.9,
            grit: 0.7,
            grime: (blotch: 0.5, earth: 0.7),
            wear: (split: 0.2, tilt: 0.05, broken: 0.35, gap: 0.03),
        ),
        fronts: [
            // North: a garage of grey block, a rusted iron shed, a blind block (no windows: unlit
            // glass mirrors nothing here and read as flat grey panels, round 261107-1500).
            (side: North, along: (-30.0, -7.0), height: 4.6, material: "concrete_wall_006",
             metres: 2.0, tint: (0.92, 0.86, 0.78), roof: "concrete_debris"),
            (side: North, along: (-7.0, 5.5), height: 3.4, depth: 8.0,
             material: "rusty_corrugated_iron", metres: 2.0, roof: "rusty_corrugated_iron"),
            (side: North, along: (5.5, 30.0), height: 7.4, material: "concrete_wall_006",
             metres: 2.0, tint: (0.86, 0.8, 0.72), roof: "concrete_debris"),
            // South: a corrugated fence and a low broken wall the camera looks over.
            (side: South, along: (-30.0, -2.0), height: 2.2, depth: 0.2,
             material: "rusty_corrugated_iron", metres: 2.0),
            (side: South, along: (-2.0, 30.0), height: 1.1, depth: 0.4,
             material: "concrete_wall_006", metres: 2.0, tint: (0.9, 0.84, 0.76)),
        ],
        props: [
            (model: "models/iso/city/rollershutter-door.glb", side: North, line: Wall,
             at: [-19.0, -12.5], out: -0.2),
            (model: "models/iso/city/old-tyre.glb", side: North, line: Wall,
             at: [-5.6, -5.0, 3.6], out: 0.3, turn: 15.0),
            (model: "models/iso/city/wheel-rim.glb", side: North, line: Wall, at: [-4.2],
             out: 0.4, turn: 60.0),
            (model: "models/iso/city/oil-barrel.glb", side: North, line: Wall,
             at: [-2.6, -1.9, 7.2], out: 0.35),
            (model: "models/iso/city/jerrycan.glb", side: North, line: Wall, at: [-1.2, 8.1],
             out: 0.25, turn: 25.0),
            (model: "models/iso/city/generator.glb", side: North, line: Wall, at: [1.0],
             out: 0.5, turn: 8.0),
            (model: "models/iso/city/barrel-stove.glb", side: North, line: Wall, at: [10.5],
             out: 0.6),
            (model: "models/iso/city/propane-tank.glb", side: North, line: Wall, at: [12.0]),
            (model: "models/iso/city/military-crate.glb", side: North, line: Wall,
             at: [-9.5, 13.4], out: 0.2, turn: 6.0),
            (model: "models/iso/city/covered-car.glb", side: North, line: Road, at: [-9.0],
             out: 2.4, turn: 85.0),
            (model: "models/iso/city/road-barrier.glb", side: South, line: Road, at: [6.0],
             out: 2.0, turn: 12.0),
            (model: "models/iso/city/old-tyre.glb", side: South, line: Kerb, at: [-4.0, 3.0],
             out: 0.6, turn: 40.0),
            (model: "models/iso/city/oil-barrel.glb", side: South, line: Wall,
             at: [-7.5, -6.8, 11.0], out: 0.4),
            (model: "models/iso/city/trash-bag.glb", side: South, line: Wall, at: [-3.0, 8.5],
             out: 0.2, turn: 30.0),
            // The fight at the focus, on the road's north lane (j2's still had no one in it):
            // the hero's chop landing (fight.rs's 1.3 s) on a raider winding up his own blow
            // (0.45 s), 2.3 m apart, each facing the other, a faint rim off the sunlit road.
            (model: "models/iso/knight.glb", side: North, line: Road, at: [-0.8], out: 1.4,
             turn: 121.0, pose: ("attack", 1.3), rim: 0.25),
            (model: "models/iso/knight.glb", side: North, line: Road, at: [1.2], out: 2.6,
             turn: -59.0, pose: ("attack", 0.45), rim: 0.25),
        ],
    ),
    light: (preset: "desert-day"),
    weather: (wind: (1.4, 0.3)),
    ground: (
        // The verges: a dead lot's dirt of broken concrete and brick rubble in dust, sand
        // drifted into it, as the junk lot's and the derelict lot's ground (refs/wasteland).
        // Not sun-baked mud cracked into plates (mud_cracked_dry_03 at 1.5 m, rounds to
        // 261107-1544): one bright, even polygon tile that every judge named first, read as a
        // paved pattern, and two shader jobs over it (hex tiling 1545-2, blown sand 1552,
        // 1555) lost.
        laid: (
            material: "concrete_debris",
            metres: 2.0,
            joints: 0.7,
            sand: 0.5,
            cracks: 0.8,
            grain: (0.3, 0.6),
            dirt: 0.9,
            grit: 0.7,
            feet: Site("walls"),
            // Blotched darker in broad stains (j2's verges read bright and even).
            grime: (blotch: 0.85, earth: 0.8, litter: 0.6),
        ),
    ),
    scatter: [
        // Dry grass and dead scrub, straw to grey-brown (j2's pale straw alone vanished on
        // the pale mud): thick in the gutters and at the walls' feet.
        // Matted (`Mat`, no broad leaves: as tufts, round 261107-1503, each stood over 1-2 m
        // green leaves that sprawled onto the road). A Mat's card is the atlas's green rush
        // (mean linear 0.068, 0.106, 0.023, marsh.ron), so each tint is the albedo wanted
        // over it, at the marsh's red-to-green: a grey straw (1 : 0.55 : 1.3, round
        // 261107-1507) left the card's bright blades green and turned the lodged ones pink,
        // so it reads as small agaves. Golden straw, tan and dead brown, small and dense so
        // the clumps run together into a strip of grass, not separate rosettes.
        (plant: (kind: Mat, tint: [(3.8, 1.65, 1.5), (2.6, 1.05, 1.1), (1.4, 0.6, 0.75)]),
            density: 14.0, scale: (0.08, 0.22), on: Site("gutter"), clump: (2.5, 0.6, 0.6),
            seed: 3),
        (plant: (kind: Mat, tint: [(3.6, 1.6, 1.45), (2.4, 1.0, 1.05), (1.3, 0.58, 0.7)]),
            density: 12.0, scale: (0.1, 0.28), on: Site("walls"), clump: (3.5, 0.8, 0.55),
            seed: 11),
        (models: ["models/iso/city/cardboard-box.glb"], density: 0.08, scale: (0.6, 1.2),
            on: Site("walls"), clump: (5.0, 1.0, 0.92), tilt: 12.0, sink: 0.01, seed: 7),
    ],
)
