diff --git a/main.gd b/main.gd
index 465b075..8986358 100644
--- a/main.gd
+++ b/main.gd
@@ -11,6 +11,26 @@ var _game : SolarSystem
 
 func _ready():
 	_settings_ui.set_settings(_settings)
+	_spike_autostart()
+
+
+# Spike instrumentation: `-- --autostart=<seconds>` starts a game, then prints FPS,
+# saves a screenshot next to project.godot and quits.
+func _spike_autostart():
+	for arg in OS.get_cmdline_user_args():
+		if arg.begins_with("--autostart"):
+			var seconds := float(arg.get_slice("=", 1)) if arg.contains("=") else 30.0
+			if OS.get_cmdline_user_args().has("--cpu-detail"):
+				_settings.detail_rendering_mode = Settings.DETAIL_RENDERING_CPU
+			if OS.get_cmdline_user_args().has("--no-detail"):
+				_settings.detail_rendering_mode = Settings.DETAIL_RENDERING_DISABLED
+			_on_MainMenu_start_requested()
+			await get_tree().create_timer(seconds).timeout
+			print("SPIKE fps=", Engine.get_frames_per_second(),
+				" adapter=", RenderingServer.get_video_adapter_name())
+			get_viewport().get_texture().get_image().save_png(
+				ProjectSettings.globalize_path("res://_spike_shot.png"))
+			get_tree().quit()
 
 
 func _on_MainMenu_start_requested():
