# Build output and engine caches. Folder-specific ignores live next to the folders.
target/
__pycache__/
*.log
shots/
# Local checkouts made by coding agents.
.claude/worktrees/
# Reference photographs not CC0, kept on the machine that fetched them (D386).
*.local.jpg
# Local secrets, such as the token stats key. Copy .env.example.
.env
# The save game `cargo xtask loop` plays through.
loop.ron
cabin.ron
spike/*/out/
# A spike's models while it runs (spike/README.md); never kept.
assets/models/spike/
# A run's log (D448), and a played session's copied home.
logs/
