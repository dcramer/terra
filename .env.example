# Copy to .env (ignored by git) and fill in. Never commit the key.
# Read by tools/token-stats/report.mjs; worktrees fall back to the main checkout's .env.
TERRA_STATS_URL=https://terra-token-stats.<account>.workers.dev
TERRA_STATS_KEY=
TERRA_STATS_USER=

# Tripo's API, for generating models (research/ai-models-for-art.md). A paid plan's key:
# free-tier output may not be used commercially.
TRIPO_API_KEY=
# Or the Studio subscription's credits (tripo.py --studio): the whole cookie header of a
# request the signed-in studio.tripo3d.ai makes to api.tripo3d.ai. Lasts about 30 days.
TRIPO_STUDIO_COOKIE=
