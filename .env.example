# Copy to .env (ignored by git) and fill in. Never commit the key.
# Read by tools/token-stats/report.mjs; worktrees fall back to the main checkout's .env.
TERRA_STATS_URL=https://terra-token-stats.<account>.workers.dev
TERRA_STATS_KEY=
TERRA_STATS_USER=

# Tripo, through tools/tripo on the Studio subscription: the ory_kratos_session cookie of a
# browser signed in to studio.tripo3d.ai (tools/tripo/README.md). Lasts about 30 days.
TRIPO_STUDIO_COOKIE=

# The render worker (tools/render-worker, docs/render-worker.md, D445). Here, in this checkout's
# .env (a worktree falls back to the main checkout's), for the client; on a box, in the .env of
# the worker's clone (<TERRA_WORKER_DIR>/repo/.env), for its daemon. The environment overrides both.
# The ssh hosts that take render jobs, comma separated: aliases from ~/.ssh/config or user@host.
TERRA_WORKERS=
# The worker's folder on each box, relative to the home there: its clone, job checkout, Node, jobs.
TERRA_WORKER_DIR=terra-render
# A job's time limit in minutes when --minutes is not given (at most 480).
TERRA_RENDER_MINUTES=120
# Seconds ssh waits to reach a box.
TERRA_RENDER_CONNECT_TIMEOUT=10
# Box: jobs start only between these hours on the box's clock, e.g. 22:00-08:00; empty is any hour.
TERRA_RENDER_WINDOW=
# Box: a CI agent's lock file; while it is held no job starts, unless TERRA_RENDER_AFTER_CI=0.
TERRA_RENDER_CI_LOCK=
TERRA_RENDER_AFTER_CI=1
# Box: days a job's files and its ref are kept.
TERRA_RENDER_KEEP_DAYS=7
# Box: jobs run at once, each in a slot with its own checkout, build and HOME (tens of GB each).
TERRA_RENDER_SLOTS=4
# Box: of the slots, how many GPU jobs (renders) run at once: a 24 GB card holds about three
# films. A bench always runs alone on the box; builds, tests and lints (--cpu) take any free slot.
TERRA_RENDER_GPU_SLOTS=3
# Box: the X display jobs that draw get (winit needs one even offscreen), e.g. :1. Empty: the
# daemon's own WAYLAND_DISPLAY or DISPLAY, else an Xvfb it starts on a free number and keeps.
TERRA_RENDER_DISPLAY=

# The push hook (.githooks/pre-push): 1 runs its checks (formatting, the size and one-definition
# lints, clippy of the crates changed) on the render worker at each commit pushed, instead of
# here, for a machine that must not build; a worker that cannot be reached fails the push.
TERRA_REMOTE_CHECKS=0
