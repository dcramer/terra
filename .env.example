# Copy to .env (ignored by git) and fill in. Never commit the key.
# Read by tools/token-stats/report.mjs; worktrees fall back to the main checkout's .env.
TERRA_STATS_URL=https://terra-token-stats.<account>.workers.dev
TERRA_STATS_KEY=
TERRA_STATS_USER=

# Tripo, through tools/tripo on the Studio subscription: the ory_kratos_session cookie of a
# browser signed in to studio.tripo3d.ai (tools/tripo/README.md). Lasts about 30 days.
TRIPO_STUDIO_COOKIE=
