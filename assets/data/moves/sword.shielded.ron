#![enable(implicit_some)]
// The sword's shielded set (`sword.shielded`): what a one-hander of class `sword` with a shield
// in the off hand plays (docs/holding.md, "The stance, by rule from the pair", D459; the combat
// prototype, D405), for the player and the sparring partner alike. A new move is an entry here;
// no code names one but the partner's rhythm: the buttons below say which move each asks for.
//
// Every time is in the clip's own seconds, as tools/characters/phases.ts measures them from
// models/character/fight.glb (the sword's tip followed through the skeleton, 0.83 m out of
// the right hand's socket), so they can be checked against the clip; a move plays its clip
// from `from` at `speed`, so it lasts (done - from) / speed seconds.
//
// Each:
//   clip      the clip that shows it
//   from      where in the clip it starts, past a slow start
//   speed     how fast the clip plays
//   active    when its blade can strike: the tip more than half a metre ahead of the hips
//             and faster than 4 m/s (measured)
//   done      when it is over and the body is back on guard
//   cancel    from when the next blow of a chain, a roll or a block may cut it short
//   next      the blow a light attack pressed again chains into
//   carry     how its clip carries the shield out: eased out over `in` and back over `out`,
//             clip seconds, as its hold in art/animation/sets/fight.json does
//   chained   the same blow with the shield out from its first frame, mixed into `clip` when
//             it cuts short a blow still carrying its shield (that one's `carry`), by how far
//             out that one has it: all of it pressed while the shield is out, none once it is
//             back at the guard, so the shield goes on from where it is (D454)
//   damage    out of a sparring health of 100
//   hit_stop  how long both fighters are held on a blow that lands, seconds: at most 0.05,
//             as Enshrouded holds none (D456); the set's `landed` shows the hit instead. A
//             light blow 2 frames at 60, the finisher a little more, a heavy 3
//   heavy     breaks a guard rather than being stopped by it
//   drive     the body's speed ahead over the move, (clip seconds, metres a second), joined
//             by straight lines: a stand-in for root motion until clips carry their own
//   warp      how a blow closes on a target in front during its wind-up (Motion Warping):
//             one within `within` metres and `cone` degrees of its facing is turned to and
//             stepped toward until `stop_at` metres away, no faster than `most_mps`
//   aim       degrees the body faces off the way it strikes, + to its left: a take whose cut
//             comes down off its ahead turns into it, so its blade meets the target (D573)
//   invulnerable   when blows pass through the body (a roll's i-frames)
//   hold      where the clip is held while the button stays down (a block)
//   brace     for a block: from where in the clip a blow taken on it plays, pushed back
//   stamina   what it costs, paid as it starts (D61). Placeholders: a light blow about 10, a
//             heavy 22, the roll 18 as the walker's own roll costs; tuned in play
(
    // A block pressed this long or less before a blow lands parries it (150 to 200 ms in
    // shipped games). An attack asked within `buffer_s` of the window opening waits for it.
    parry_s: 0.18,
    buffer_s: 0.35,
    // A blow taken on a raised guard costs this much stamina a point of its damage (the
    // creatures' fight takes 12 a guarded bite). A parry costs nothing.
    guard_stamina: 1.0,
    // Out of stamina (D449, Open; this is the agent's placeholder): a roll or heavy blow
    // without its full cost does not start; a light blow comes out tired, its clip at `pace`
    // and doing `might` of its damage; a guard with less left than a blow costs is broken.
    tired: (pace: 0.7, might: 0.5),
    // What the set fights with, as a blow meets it (terra_motion::struck): a steel blade, and
    // a round shield whose wooden face takes a blow on the guard and whose iron boss turns a
    // parried one. With each move's `heavy`, these choose what a contact sounds like, by the
    // table in data/contacts.ron.
    kit: (blade: Steel, face: Wood, boss: Iron),
    // The clip a body stands on guard in, between moves: every blow is keyed to its pose at
    // both ends (D450), so a blow starts and ends where the guard stands. Low_Guard is the keyed
    // guard (Keyed_Guard) with the shield arm held low at the left side, the board at the hip
    // (D531: it rests low and rises only while the block is held).
    guard: "Low_Guard",
    // What a blow that lands shows in place of a freeze (D456, as Enshrouded does,
    // tools/combat/refs/enshrouded.json `hit_stop`): a burst where the blade met the body, the
    // struck body keeping its own colours (D487, Enshrouded's flash is at the contact: a
    // white-hot glow `glow_m` across for `glow_s` (3 to 4 frames at 60), `sparks` flung on
    // along the blade at `spark_mps` for `spark_s`; glow_m 0 and sparks 0 turn it off), and
    // the player's view is kicked, tipped down `kick_deg` at once and eased back to rest over
    // `kick_s` (Enshrouded's sky moves for about 0.1 s).
    landed: (
        burst: (glow_s: 0.06, glow_m: 0.4, sparks: 20, spark_mps: 7.0, spark_s: 0.18),
        kick_deg: 0.8,
        kick_s: 0.1,
    ),
    // What each button asks for in this stance (holding.md, "Which button does what"): main
    // (left click) the light chain from its first blow, main with the modifier the heavy, off
    // (right click) held the block, a parry at its start; dodge its own key. The off button's
    // heavy (the shield bash) is not made yet.
    buttons: (main: "slash", main_heavy: "heavy", off: "block", dodge: "roll"),
    moves: {
        // From the guard and back to it (Keyed_Slash, D450): over the right shoulder by 0.25 s
        // and down across to the left, 1.3 m ahead at its contact, right to left. The shield
        // stays low at the left side, where the guard rests it, out of the sword's way
        // (Open_Slash, D454, D531).
        // THE FIGHT-SWAP TRIAL (branch wip/fight-swap, not main): the light chain, the heavy and
        // the block are Quaternius's UAL2 clips as made (Swap_*: each blow joined to its _Rec,
        // the shield arm held at the guard's as the Open_* are; Q_Block his Shield_OneShot),
        // played at their own speed. Each drive is the clip's root motion (root_drive.ts on
        // UAL2_RM.glb), so the body steps as the clip does; active from the tip's sweep past the
        // front (phases.ts --trace), stop_at so the tip meets the target at its reach plus the
        // root's travel to the hit. The chain cancels where Quaternius's next blow begins.
        "slash": (
            clip: "Swap_Light_A", from: 0.00, speed: 1.0, active: (0.18, 0.30), done: 0.87,
            cancel: 0.37, next: "backhand",
            stamina: 10, damage: 12, hit_stop: 0.03,
            drive: [(0.04, 0.58), (0.11, 2.99), (0.18, 1.31), (0.26, 0.06), (0.33, -0.65), (0.40, 0.0)],
            warp: (within: 3.2, cone: 70, stop_at: 1.65, most_mps: 4.0),
        ),
        // From the guard and back to it (Keyed_Backhand): the sword to the left shoulder and
        // down across to the low right, a falling diagonal cut with its edge leading down and
        // to the right (D568), left to right. The shield low at the left side throughout
        // (Open_Backhand, D454, D531).
        "backhand": (
            clip: "Swap_Light_B", from: 0.00, speed: 1.0,
            active: (0.20, 0.29), done: 1.00, cancel: 0.43, next: "finisher",
            stamina: 10, damage: 12, hit_stop: 0.03,
            drive: [(0.04, 1.62), (0.11, 2.23), (0.18, 0.87), (0.25, 0.50), (0.33, -0.05), (0.40, -0.17), (0.47, 0.0)],
            warp: (within: 3.2, cone: 70, stop_at: 1.3, most_mps: 4.0),
        ),
        // The third of the chain: the slash again, a little slower and harder.
        "finisher": (
            clip: "Swap_Light_C", from: 0.0, speed: 1.0,
            active: (0.43, 0.50), done: 1.57, cancel: 1.4, stamina: 12, damage: 18,
            hit_stop: 0.04,
            drive: [(0.03, 0.32), (0.10, 2.74), (0.17, 3.71), (0.23, 3.15), (0.30, 2.38), (0.37, 1.71), (0.43, 1.57), (0.50, 1.59), (0.57, 0.94), (0.63, 0.72), (0.70, 0.70), (0.77, 0.77), (0.83, 0.95), (0.90, 0.0)],
            warp: (within: 3.6, cone: 70, stop_at: 2.2, most_mps: 4.5),
        ),
        // From the guard and back to it (Keyed_Heavy, D450): the sword lifted high behind the right
        // shoulder by 0.75 s and brought down hard across to the lower left, then back on guard.
        // The shield low at the left side throughout (Open_Heavy, D454, D531). Its take's cut
        // comes down about 15 deg left of ahead and reaches 1.45 m, so the body turns 15 deg
        // right into it and steps in to 1.4 m (D573).
        "heavy": (
            clip: "Swap_Heavy_D", from: 0.00, speed: 1.0, active: (0.55, 0.68), done: 2.33,
            cancel: 1.95, stamina: 22, damage: 30, hit_stop: 0.05, heavy: true,
            drive: [(0.03, -0.43), (0.10, -0.02), (0.17, -0.19), (0.23, -0.18), (0.30, 0.26), (0.37, 1.05), (0.43, 2.05), (0.50, 3.01), (0.57, 5.65), (0.63, 2.37), (0.70, 0.02), (0.77, 0.0), (1.23, 0.0), (1.30, 0.32), (1.37, 0.85), (1.43, 1.17), (1.50, 1.31), (1.57, 1.25), (1.63, 1.01), (1.70, 0.68), (1.77, 0.42), (1.83, 0.25), (1.90, 0.13), (1.97, 0.05), (2.03, 0.0)],
            warp: (within: 4.0, cone: 70, stop_at: 2.2, most_mps: 4.0),
        ),
        // The base's forward roll with the arms held out of the tuck (Fight_Roll, hold.py), in
        // place in its clip: the body driven 3.3 m along the way asked, blows passing through
        // it from tuck to the get-up. 0.6 s from the stand to the next roll, Enshrouded's
        // (0.5-0.53 s to standing, 0.6-0.64 s roll to roll, tools/combat/refs/enshrouded.json).
        "roll": (
            clip: "Fight_Roll", from: 0.05, speed: 2.0, done: 1.25, cancel: 1.25,
            invulnerable: (0.12, 0.78), stamina: 18,
            drive: [(0.05, 7.6), (0.75, 7.6), (0.95, 2.1), (1.2, 0.0)],
        ),
        // The shield raised across the face from the guard (Keyed_Block, keyed to it at both
        // ends, D450), up 0.22 s after the press and held at its hold while the block is held;
        // Clear_Block is that take with the sword arm held out of the board's way (D454) and the
        // shield arm eased from the low rest into the raise by 0.2 s and back to it as it
        // lowers (D531).
        "block": (clip: "Q_Block", from: 0.00, speed: 1.0, done: 0.83, hold: 0.30),
        // The partner's slash: the slash slowed for a long, readable wind-up.
        "partner_slash": (
            clip: "Open_Slash", from: 0.0, speed: 0.37, active: (0.32, 0.48), done: 1.96,
            stamina: 10, damage: 15, hit_stop: 0.03,
            drive: [(0.1, 0.0), (0.23, 1.5), (0.39, 0.4), (0.5, 0.0)],
            warp: (within: 3.0, cone: 80, stop_at: 1.5, most_mps: 3.0),
        ),
        // The partner's heavy: the big cut, its wind-up held longer.
        "partner_heavy": (
            clip: "Open_Heavy", from: 0.0, speed: 0.95, active: (0.90, 1.00), done: 2.38,
            stamina: 22, damage: 25, hit_stop: 0.05, heavy: true,
            drive: [(0.0, 0.0), (0.72, 0.4), (0.95, 2.6), (1.3, 0.4), (1.87, 0.0)],
            warp: (within: 3.4, cone: 80, stop_at: 1.4, most_mps: 3.0), aim: -15,
        ),
    },
)
