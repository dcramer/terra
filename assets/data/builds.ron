#![enable(implicit_some)]
// What the hammer builds (D56, D127, D136): a short list of parts, each with one or more
// variants. A part is what you pick from the build menu: a room, a window, a seat. A
// variant is a kind of that part, cycled through once the part is picked: a chair, a
// stool. The list is a stand-in. What can be built, what it costs and how it is unlocked
// are design questions nobody has answered (docs/player.md).
//
// structure  what the pieces of a base cost, by items.ron's names. Sizes are measured,
//            not counted in cells, so prices do not change if the grid does: floor by
//            every three square metres, however a room comes to have it; interior wall by
//            every metre and a half; a window by the metre; a door each.
// claim      how far across a claim is at each step, and what growing it to the next
//            step costs (D94, D104)
// parts      in the order the build menu lists them within each tab. Each is in a tab
//            (Hidden ones are not in the menu) and is one of:
//              Items    things stood on a floor or the ground, each with its model in
//                       assets/models/props, its longest size in metres, and its cost.
//                       Some lie flat (lift, metres above the floor), give light
//                       (light: Fire), are a station (station, by stations.ron's name),
//                       claim the land around them (claims, D94), or are to rest on
//                       (rest: Sit, or Sleep to wake in after going down).
//              Room     rooms, by footprint in metres east by south
//              Wall     lengths of interior wall, in metres
//              Window   windows, by width in metres, and the glass's sill above the floor
//                       and top below the ceiling, in metres
//              Reshape, Door, Remove, Move   the hammer's other work
(
    structure: (
        floor: [("Wood", 1)],
        wall: [("Wood", 1)],
        window: [("Wood", 1), ("Fibre", 1)],
        door: [("Wood", 2)],
    ),
    claim: (
        across_m: [40.0, 80.0, 160.0],
        grow: [
            [("Wood", 10), ("Stone", 10)],
            [("Wood", 20), ("Stone", 20), ("Iron", 4)],
        ],
    ),
    parts: [
        (name: "Claim stone", tab: Claim, kind: Items([
            (name: "Claim stone", file: "../nature/Rock_Moss_2", size: 1.3, cost: [("Stone", 2)], claims: true),
        ])),
        (name: "Workbench", tab: Crafting, kind: Items([
            (name: "Workbench", file: "Table_Small", size: 1.7, cost: [("Wood", 4), ("Stone", 2)], station: "Workbench"),
        ])),
        (name: "Smelter", tab: Crafting, kind: Items([
            (name: "Smelter", file: "shaped:smelter", size: 2.0, cost: [("Stone", 10), ("Wood", 2)], station: "Smelter"),
        ])),
        (name: "Forge", tab: Crafting, kind: Items([
            (name: "Forge", file: "shaped:forge", size: 2.6, cost: [("Wood", 4), ("Stone", 8)], station: "Forge"),
        ])),
        (name: "Room", tab: Structure, kind: Room([
            (name: "4.5 by 4.5 m", metres: (4.5, 4.5)),
            (name: "3 by 3 m", metres: (3.0, 3.0)),
            (name: "6 by 6 m", metres: (6.0, 6.0)),
            (name: "Corridor, 1.5 by 4.5 m", metres: (1.5, 4.5)),
        ])),
        (name: "Reshape", tab: Structure, kind: Reshape),
        (name: "Wall", tab: Structure, kind: Wall([("3 m", 3.0), ("1.5 m", 1.5), ("0.5 m", 0.5)])),
        (name: "Window", tab: Openings, kind: Window([
            ("1.5 m", 1.5, (0.9, 0.5)),
            ("3 m", 3.0, (0.9, 0.5)),
            ("0.5 m", 0.5, (0.9, 0.5)),
            ("Tall, 1.5 m", 1.5, (0.2, 0.2)),
        ])),
        (name: "Door", tab: Openings, kind: Door),
        // Seen in the world but not yet buildable: a village's well and stall. How they
        // are learned is open (D68, D108).
        (name: "Well", tab: Hidden, kind: Items([
            (name: "Well", file: "../village/Well", size: 2.4, cost: [("Stone", 12)]),
        ])),
        (name: "Market stall", tab: Hidden, kind: Items([
            (name: "Market stall", file: "../village/MarketStand_1", size: 3.0, cost: [("Wood", 8), ("Fibre", 4)]),
        ])),
        (name: "Remove", tab: Hidden, kind: Remove),
        (name: "Move", tab: Hidden, kind: Move),
        // Modern pieces from the free packs, such as a couch, kitchen drawers, sci-fi
        // crates and potted houseplants, are left out until the art direction settles;
        // they do not belong in game design 001's world.
        (name: "Seat", tab: Furniture, kind: Items([
            (name: "Chair", file: "Chair_1", size: 0.95, cost: [("Wood", 2)], rest: Sit),
            (name: "Stool", file: "Stool", size: 0.5, cost: [("Wood", 1)], rest: Sit),
        ])),
        (name: "Table", tab: Furniture, kind: Items([
            (name: "Round table", file: "Table_RoundSmall", size: 1.1, cost: [("Wood", 3)]),
            (name: "Night stand", file: "NightStand_1", size: 0.55, cost: [("Wood", 2)]),
        ])),
        (name: "Bed", tab: Furniture, kind: Items([
            (name: "Single bed", file: "Bed_Single", size: 2.15, cost: [("Wood", 3), ("Fibre", 3)], rest: Sleep),
        ])),
        (name: "Storage", tab: Storage, kind: Items([
            (name: "Bookshelf", file: "Bookshelf", size: 2.0, cost: [("Wood", 4)]),
        ])),
        (name: "Decor", tab: Furniture, kind: Items([
            (name: "Round rug", file: "Carpet_Round", size: 3.2, cost: [("Hide", 2)], lift: 0.015),
            (name: "Long rug", file: "Carpet_1", size: 3.0, cost: [("Hide", 2)], lift: 0.015),
            (name: "Shovel", file: "Shovel", size: 1.3, cost: [("Wood", 1), ("Iron", 1)]),
        ])),
        (name: "Fire", tab: Fire, kind: Items([
            (name: "Campfire", file: "Bonfire_Fire", size: 1.3, cost: [("Wood", 3), ("Stone", 2)], light: Fire, station: "Campfire"),
            (name: "Log", file: "WoodLog", size: 1.7, cost: [("Wood", 2)]),
        ])),
    ],
)
