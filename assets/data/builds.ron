#![enable(implicit_some)]
// What the hammer builds (D56, D127, D136): a short list of parts, each with one or more
// variants. A part is what you pick from the build menu: a room, a window, a seat. A
// variant is a kind of that part, cycled through once the part is picked: a chair, a
// stool. The list is a stand-in. What can be built, what it costs and how it is unlocked
// are design questions nobody has answered (docs/building.md).
//
// fittings  the doors and shutters fitted into openings (D192, D207, D225), each a kind
//            of prop by its place in the list: its name, its model in
//            assets/models/openings, how it hangs (Door, a leaf or a pair swinging into
//            the room; Shutters, folding back against the wall outside), how wide, high
//            and thick one leaf is made in metres (dims), for the clear opening of the
//            first hole it fits, which it is stretched to fill and reach a little behind
//            (terra_build::fitting), the holes
//            it fits, wide by high in cubes, and what a leaf costs, by items.ron's names,
//            a pair costing two. Its model is that leaf, hinged at its origin, with its
//            hinge and handle sockets (the model contract, docs/art-style.md). What walls, floors and roofs take is their kits' to say
//            (assets/data/kits).
// claim      how far across a claim is at each step, what growing it to the next step
//            costs (D94, D104), and how many cubes it may have planned and not yet built
//            at each step (D193), a cabin's plan being about three hundred
// parts      in the order the build menu lists them within each tab, the first in hand
//            when the hammer is first taken up (D253). Each is in a tab
//            (Hidden ones are not in the menu) and is one of:
//              Items    things stood on a floor or the ground, each with its model in
//                       assets/models/props, how wide, high and deep a real one is in
//                       metres (dims), which its model is made to and drawn at, its
//                       origin the middle of its base (the model contract,
//                       docs/art-style.md; cargo xtask contract checks it), and its cost.
//                       Some give light (light: Fire), are a station (station, by
//                       stations.ron's name), claim the land around them (claims, D94),
//                       or are to rest on (rest: Sit, at its model's seat socket, or
//                       Sleep to wake in after going down). Storage says how many cells
//                       it holds (holds, wide by high, D84), which building in its claim
//                       draws on (D141).
//              Room     rooms, by footprint in metres east by south, outside their
//                       walls, which are half a metre thick (D181)
//              Roof     "add a roof with this material" (D226, D241): roof cubes laid
//                       over the room aimed into, or a rectangle drawn, in a style (Hip,
//                       Gable, LeanTo, or None for flat), in the roof material in hand or
//                       the walls' own roof; built and changed as any cubes are
//              Wall     lengths of wall, in metres, drawn by dragging or laid at a length
//              Window   windows, holes by width in metres, and the window's sill height
//                       above the floor and top below the ceiling, in metres: whole
//                       cubes, half a metre each (D181)
//              Floor    a floor drawn alone, on a storey
//              Flight   stairs or a ramp up a storey (D193): its name, whether it is a
//                       ramp of slopes rather than stairs, and how wide in metres
//              Post     a post a storey high, carrying the floor above (D193)
//              Block    one cube of a shape set against what is aimed at (D193), or a
//                       box of them the brush's size (D226): each variant's name and
//                       shape, Whole, Half, Stair, Slope, UpperHalf, InvertedStair,
//                       InvertedSlope, OuterCorner or InnerCorner (D231); at most eight
//                       to a part, as the dial shows
//              Replace  the built cubes aimed at changed to the material in hand (D232)
//              Carve    the built cubes aimed at carved out (D226)
//              Fit      doors or shutters (Door, Shutters) fitted into a hole that fits
//                       them, its walls built round it: the fittings that hang so
//              Door, Remove, Move   the hammer's other work: Door cuts a doorway
(
    fittings: [
        (name: "Plank door", model: "PlankDoor", hang: Door, dims: (0.894, 1.939, 0.08),
            fits: [(2, 4), (3, 4), (4, 4)], cost: [("Wood", 2)]),
        (name: "Ledged and braced door", model: "LedgedDoor", hang: Door, dims: (0.894, 1.939, 0.08),
            fits: [(2, 4), (3, 4), (4, 4)], cost: [("Wood", 3)]),
        (name: "Studded door", model: "StuddedDoor", hang: Door, dims: (0.894, 1.939, 0.08),
            fits: [(2, 4), (3, 4), (4, 4)], cost: [("Wood", 3), ("Iron", 1)]),
        (name: "Board shutters", model: "BoardShutter", hang: Shutters, dims: (0.5, 1.0, 0.05),
            fits: [(1, 2), (2, 2), (3, 2), (1, 3), (2, 3), (3, 3)], cost: [("Wood", 1)]),
        (name: "Louvred shutters", model: "LouvredShutter", hang: Shutters, dims: (0.5, 1.0, 0.05),
            fits: [(1, 2), (2, 2), (3, 2), (1, 3), (2, 3), (3, 3)], cost: [("Wood", 1), ("Fibre", 1)]),
    ],
    claim: (
        across_m: [40.0, 80.0, 160.0],
        grow: [
            [("Wood", 10), ("Stone", 10)],
            [("Wood", 20), ("Stone", 20), ("Iron", 4)],
        ],
        planned: [1500, 3000, 6000],
    ),
    parts: [
        // Building by hand first (D253): Block, in hand by default, with its shape, material
        // and brush; then carving and changing material; then the conveniences.
        (name: "Block", tab: Structure, kind: Block([
            ("Cube", Whole),
            ("Half", Half),
            ("Stair", Stair),
            ("Slope", Slope),
            ("Upper half", UpperHalf),
            ("Stair, upside down", InvertedStair),
            ("Slope, upside down", InvertedSlope),
        ])),
        (name: "Corner slope", tab: Structure, kind: Block([
            ("Outer corner", OuterCorner),
            ("Inner corner", InnerCorner),
        ])),
        (name: "Carve", tab: Structure, kind: Carve),
        (name: "Change material", tab: Structure, kind: Replace),
        (name: "Room", tab: Structure, kind: Room([
            (name: "5 by 5 m", metres: (5.0, 5.0)),
            (name: "3.5 by 3.5 m", metres: (3.5, 3.5)),
            (name: "7 by 7 m", metres: (7.0, 7.0)),
            (name: "Corridor, 2 by 5 m", metres: (2.0, 5.0)),
        ])),
        (name: "Wall", tab: Structure, kind: Wall([("3 m", 3.0), ("1.5 m", 1.5), ("0.5 m", 0.5)])),
        (name: "Add a roof", tab: Structure, kind: Roof([
            (name: "Gable", style: Some(Gable)),
            (name: "Hip", style: Some(Hip)),
            (name: "Lean-to", style: Some(LeanTo)),
            (name: "Flat", style: None),
        ])),
        (name: "Floor", tab: Structure, kind: Floor),
        (name: "Stairs", tab: Structure, kind: Flight([
            (name: "Stairs, 1 m wide", ramp: false, wide: 1.0),
            (name: "Stairs, 1.5 m wide", ramp: false, wide: 1.5),
            (name: "Ramp, 1 m wide", ramp: true, wide: 1.0),
        ])),
        (name: "Post", tab: Structure, kind: Post),
        (name: "Claim stone", tab: Claim, kind: Items([
            (name: "Claim stone", file: "ClaimStone", dims: (1.3, 1.25, 1.24), cost: [("Stone", 2)], claims: true),
        ])),
        (name: "Workbench", tab: Crafting, kind: Items([
            (name: "Workbench", file: "Workbench", dims: (1.7, 1.06, 1.2), cost: [("Wood", 4), ("Stone", 2)], station: "Workbench"),
        ])),
        (name: "Smelter", tab: Crafting, kind: Items([
            (name: "Smelter", file: "Smelter", dims: (1.41, 2.0, 1.46), cost: [("Stone", 10), ("Wood", 2)], station: "Smelter"),
        ])),
        (name: "Forge", tab: Crafting, kind: Items([
            (name: "Forge", file: "Forge", dims: (2.6, 2.59, 1.55), cost: [("Wood", 4), ("Stone", 8)], station: "Forge"),
        ])),
        (name: "Window", tab: Openings, kind: Window([
            ("1.5 m", 1.5, (1.0, 1.0)),
            ("3 m", 3.0, (1.0, 1.0)),
            ("0.5 m", 0.5, (1.0, 1.0)),
            ("Tall, 1.5 m", 1.5, (0.5, 0.5)),
        ])),
        (name: "Doorway", tab: Openings, kind: Door),
        (name: "Door", tab: Openings, kind: Fit(Door)),
        (name: "Shutters", tab: Openings, kind: Fit(Shutters)),
        // Seen in the world but not yet buildable: a village's well and stall. How they
        // are learned is open (D68, D108).
        (name: "Well", tab: Hidden, kind: Items([
            (name: "Well", file: "Well", dims: (1.7, 2.4, 1.75), cost: [("Stone", 12)]),
        ])),
        (name: "Market stall", tab: Hidden, kind: Items([
            (name: "Market stall", file: "MarketStall", dims: (2.6, 2.9, 2.0), cost: [("Wood", 8), ("Fibre", 4)]),
        ])),
        (name: "Remove", tab: Hidden, kind: Remove),
        (name: "Move", tab: Hidden, kind: Move),
        // Modern pieces from the free packs, such as a couch, kitchen drawers, sci-fi
        // crates and potted houseplants, are left out until the art direction settles;
        // they do not belong in game design 001's world.
        (name: "Seat", tab: Furniture, kind: Items([
            (name: "Chair", file: "Chair", dims: (0.55, 0.95, 0.67), cost: [("Wood", 2)], rest: Sit),
            (name: "Stool", file: "Stool", dims: (0.49, 0.5, 0.49), cost: [("Wood", 1)], rest: Sit),
        ])),
        (name: "Table", tab: Furniture, kind: Items([
            (name: "Round table", file: "RoundTable", dims: (1.18, 0.75, 1.19), cost: [("Wood", 3)]),
            (name: "Night stand", file: "NightStand", dims: (0.38, 0.6, 0.38), cost: [("Wood", 2)]),
        ])),
        (name: "Bed", tab: Furniture, kind: Items([
            (name: "Single bed", file: "Bed", dims: (1.32, 1.46, 2.1), cost: [("Wood", 3), ("Fibre", 3)], rest: Sleep),
        ])),
        (name: "Storage", tab: Storage, kind: Items([
            (name: "Chest", file: "Chest", dims: (1.0, 0.58, 0.65), cost: [("Wood", 6)], holds: (8, 6)),
            (name: "Bookshelf", file: "Bookshelf", dims: (1.61, 2.0, 0.65), cost: [("Wood", 4)]),
        ])),
        (name: "Decor", tab: Furniture, kind: Items([
            (name: "Round rug", file: "RugRound", dims: (2.4, 0.02, 1.81), cost: [("Hide", 2)]),
            (name: "Long rug", file: "RugLong", dims: (1.48, 0.02, 3.0), cost: [("Hide", 2)]),
            (name: "Shovel", file: "Spade", dims: (0.37, 1.3, 0.11), cost: [("Wood", 1), ("Iron", 1)]),
        ])),
        (name: "Fire", tab: Fire, kind: Items([
            (name: "Campfire", file: "Campfire", dims: (1.3, 0.9, 1.3), cost: [("Wood", 3), ("Stone", 2)], light: Fire, station: "Campfire"),
            (name: "Log", file: "Log", dims: (1.7, 0.45, 0.45), cost: [("Wood", 2)]),
        ])),
    ],
)
