// Performance budgets (D607): what each benchmark scene of `cargo xtask bench` may spend,
// by phase, the one place they are set. The bench fails a scene whose phase or group is
// over, naming the group, its budget, what it measured and where to look (D556).
//
// As shipped engines keep them: Unreal carries its frame targets as data
// (`FEnginePerformanceTargets`: the target frame and a hitch's threshold) and checks CSV
// profiler captures (`csvprofile`, PerfReportTool's budgets a stat) against a budget for each
// named stat group (`DECLARE_STATS_GROUP`, timed by `SCOPE_CYCLE_COUNTER`); ours are the
// groups `terra_gen::stat` times, the render world's CPU and the GPU's passes.
//
// The phases, each timed apart:
// - load: the program's start to the first playable frame (the `Loaded in` line).
// - settle: the first `seconds` after the loading screen lifts, the world streaming in round
//   a player standing at the start; looser on the frame, held to no drift.
// - play: the scene's timed frames after it.
//
// A group's budget is its median ms a frame, every thread's time in it summed; a schedule's
// (the recorder's marks, D576: `PostUpdate`, the render world's `render.Render`, which holds
// its wait for the GPU) and a GPU pass's the same; a name timed but not budgeted is said and
// fails nothing. A budget is raised by a change that says why, and lowered only by the full
// run (D414). The first budgets are the 2026-11-03 bench on the worker (commit 8dd30ef39,
// RTX 4090, three runs a scene, job 20261103-075814-2a8b): 25% over the worst run's 99th
// percentile for a group or schedule, over its median for a pass or the render CPU, rounded
// up to 0.1 ms and at least 0.1, so a group's median fails only past its own spikes; never
// tuned to pass. They are that machine's: a slower GPU or CPU (the developers' RTX 3080)
// misses the pass and schedule budgets until a scene budgets by machine. `bin_unpacking`
// has none since D613 merged its dispatches: 0.01 ms, it falls out of the costliest 20 passes.
(
    // The time to playable every load is held to. D580 is Open (the developers set it):
    // until then this is its recommendation, provisional, said beside each load and failing
    // none; a scene's own `load_s` below is what fails.
    load: (
        target_s: 10.0,
        provisional: true,
    ),
    // What streams after the load may put in the world a frame (D608, read by the game's
    // `streaming`): the main thread's ms and the MiB of mesh for the GPU, the first of each
    // class a frame and the near ground always let in. Unity's `backgroundLoadingPriority`
    // caps its main thread's integration at 2 ms a frame at Low and 50 at High, Unreal's
    // `s.AsyncLoadingTimeLimit` at 5 by default, larger behind a loading screen; 8 MiB a frame
    // is load-time j5's, some 0.5 GB/s at 60 fps, a few percent of a PCIe 3 link.
    streaming: (
        frame_ms: 2.0,
        upload_mib: 8.0,
        loading_frame_ms: 50.0,
        loading_upload_mib: 64.0,
    ),
    // Every scene's phases, unless its own entry says otherwise.
    every: (
        settle: (
            seconds: 30.0,
            // Twice the frame's budget: a hitch, as D25 counts one.
            frame_p99_ms: 26.7,
            freezes: 0,
            tick_p99_ms: 15.6,
        ),
        play: (
            // D25: 75 fps on the developers' RTX 3080 at the high preset.
            frame_p99_ms: 13.3,
            over_pct: 1.0,
            hitches: 0,
            freezes: 0,
            drift_pct: 15.0,
            // D138: a tick's 99th percentile under its timestep, 1/64 s.
            tick_p99_ms: 15.6,
            // D239: on an integrated GPU at the low preset, 30 fps at the median.
            integrated_median_ms: 33.3,
        ),
    ),
    scenes: {
        // D578: a play scene is timed from the program's start, the walk out through ground
        // not yet streamed held only to no freeze (`bench/play.rs`); it has no settle.
        "play-walk": (
            settle: (seconds: 0.0),
        ),
        // No frame, its load's included, may hold the window past `load_frame_ms`: the loading
        // screen's bar stood still 13.7 s as the world was entered on every walk at the lake
        // (crossing-freeze j1). 5 s is where Windows calls a window that has not read its
        // messages "not responding" and greys it (`IsHungAppWindow`); every load is to come under it,
        // then under a freeze's 100 ms, a scene at a time.
        "lake-woods-walk": (
            load_frame_ms: 5000.0,
        ),
        // The mountain lake as the developer plays it, under a minute (the developers,
        // 2026-11-02, from 350 s on the worker and 6 min on their 3080).
        "lake-play": (
            load_s: 60.0,
            settle: (
                groups: {"building": 0.1, "creatures": 0.5, "flora": 0.3, "folk": 0.1, "terrain": 1.3},
                schedules: {"Crossing": 0.1, "First": 0.2, "Last": 0.3, "PostUpdate": 9.0, "PreUpdate": 0.5, "RunFixedMainLoop": 1.1, "SpawnScene": 0.1, "StateTransition": 0.2, "Update": 2.1, "render.First": 0.1, "render.Render": 9.9},
            ),
            play: (
                render_cpu_ms: 0.7,
                groups: {"building": 0.1, "creatures": 0.6, "flora": 0.4, "folk": 0.1, "terrain": 1.1},
                schedules: {"Crossing": 0.1, "First": 0.2, "Last": 0.3, "PostUpdate": 10.2, "PreUpdate": 0.5, "RunFixedMainLoop": 1.4, "SpawnScene": 0.1, "StateTransition": 0.1, "Update": 1.7, "render.First": 0.1, "render.Render": 12.5},
                gpu: {"main_opaque_pass_3d": 6.1, "early prepass": 1.0, "uniform_allocation": 0.6, "volumetric_lighting": 0.5, "main_transmissive_pass_3d": 0.4, "per_view_shadow_pass": 0.7, "atmosphere_luts": 0.3, "ssao": 0.2, "clouds": 0.2},
            ),
        ),
        // The forest's creatures spike: their 99th is nine times their median (0.30 of
        // 2.6-3.4 ms), so their budget is loose on the median.
        "forest-run": (
            settle: (
                groups: {"building": 0.1, "creatures": 3.5, "flora": 0.3, "folk": 0.1, "terrain": 0.1},
                schedules: {"Crossing": 0.1, "First": 0.2, "Last": 0.2, "PostUpdate": 7.5, "PreUpdate": 0.7, "RunFixedMainLoop": 2.7, "SpawnScene": 0.1, "StateTransition": 0.1, "Update": 3.5, "render.First": 0.1, "render.Render": 9.8},
            ),
            play: (
                render_cpu_ms: 0.7,
                groups: {"building": 0.1, "creatures": 4.2, "flora": 0.3, "folk": 0.1, "terrain": 0.1},
                schedules: {"Crossing": 0.1, "First": 0.2, "Last": 0.3, "PostUpdate": 8.6, "PreUpdate": 0.7, "RunFixedMainLoop": 3.5, "SpawnScene": 0.1, "StateTransition": 0.2, "Update": 4.0, "render.First": 0.1, "render.Render": 11.2},
                gpu: {"main_opaque_pass_3d": 3.6, "early prepass": 2.0, "per_view_shadow_pass": 1.7, "uniform_allocation": 0.8, "volumetric_lighting": 0.5, "atmosphere_luts": 0.3, "ssao": 0.2, "clouds": 0.2},
            ),
        ),
        "town-dusk": (
            settle: (
                groups: {"building": 0.3, "creatures": 0.4, "flora": 0.3, "folk": 0.5, "terrain": 1.2},
                schedules: {"Crossing": 0.1, "First": 0.2, "Last": 0.3, "PostUpdate": 9.6, "PreUpdate": 0.5, "RunFixedMainLoop": 2.1, "SpawnScene": 0.1, "StateTransition": 0.1, "Update": 2.0, "render.First": 0.1, "render.Render": 11.7},
            ),
            play: (
                render_cpu_ms: 1.1,
                groups: {"building": 0.4, "creatures": 0.3, "flora": 0.5, "folk": 0.4, "terrain": 1.2},
                schedules: {"Crossing": 0.1, "First": 0.2, "Last": 0.3, "PostUpdate": 10.9, "PreUpdate": 0.8, "RunFixedMainLoop": 2.4, "SpawnScene": 0.2, "StateTransition": 0.2, "Update": 1.9, "render.First": 0.1, "render.Render": 13.2},
                gpu: {"main_opaque_pass_3d": 2.3, "per_view_shadow_pass": 1.4, "uniform_allocation": 0.8, "volumetric_lighting": 0.8, "early prepass": 0.7, "clouds": 0.5, "main_transparent_pass_3d": 0.4, "atmosphere_luts": 0.3, "ssao": 0.2},
            ),
        ),
        "castle": (
            settle: (
                groups: {"building": 0.1, "creatures": 0.1, "flora": 0.1, "folk": 0.1, "terrain": 0.1},
                schedules: {"Crossing": 0.1, "First": 0.1, "Last": 0.2, "PostUpdate": 3.0, "PreUpdate": 0.3, "RunFixedMainLoop": 0.5, "SpawnScene": 0.1, "StateTransition": 0.1, "Update": 0.7, "render.First": 0.1, "render.Render": 4.7},
            ),
            play: (
                render_cpu_ms: 0.3,
                groups: {"building": 0.1, "creatures": 0.1, "flora": 0.1, "folk": 0.1, "terrain": 0.1},
                schedules: {"Crossing": 0.1, "First": 0.2, "Last": 0.3, "PostUpdate": 3.1, "PreUpdate": 0.3, "RunFixedMainLoop": 0.5, "SpawnScene": 0.1, "StateTransition": 0.1, "Update": 0.7, "render.First": 0.1, "render.Render": 6.6},
                gpu: {"main_opaque_pass_3d": 0.9, "per_view_shadow_pass": 0.7, "volumetric_lighting": 0.4, "atmosphere_luts": 0.3, "clouds": 0.2, "ssao": 0.2, "early prepass": 0.2, "uniform_allocation": 0.2},
            ),
        ),
        // Standing ten minutes with its clock held, its GPU held flat: the developer's lake run
        // of 2026-11-02 doubled its GPU time in four minutes (a card clocked down while the
        // tick death spiral left it idle); a quiet worker held within 0.7% over 14 minutes
        // (perf-growth j1/j2), so 5% is noise's room.
        "lake-stand": (
            play: (gpu_growth_pct: 5.0),
        ),
    },
)
