#![enable(implicit_some)]
// Every kind of creature (game design 001, creatures.md; D127, D136). A new kind is an entry
// here with its model; no code names one. The numbers are stand-ins.
//
// Each:
//   name     what it is called
//   model    its model, and the scale from the model's size to ours
//   clips    its animations by what they show; one to eat with if it grazes, one to fly with
//            if it flies; and its walk's and run's own paces in metres a second, if they
//            have them, so each plays as fast as it goes; and a trot, its clip and own pace,
//            for one that trots (D424; the clips made by tools/creatures/animal.py)
//   health   out of how much
//   walk_mps, run_mps   its speeds
//   body     the room it takes up on the ground, and how hard it is to shove
//   temper   how it treats players:
//              Shy      runs from anyone within flees_within_m, or that hurts it, for flees_s
//              Hostile  chases anyone within notices_m, or that hurts it, while within
//                       leash_m of home; attacks within attacks_within_m; a bite of bite
//                       lands bite_at_s into an attack lasting attack_s, on anyone still
//                       within bite_reach_m
//   refuge   where a shy one goes when it flees: Runs away (the default), Climbs the nearest
//            trunk until nobody is near, or Flies(near, far) off to somewhere it keeps to
//   lives    where it is put in a world: in a herd of so many, or so many at a lair, or
//            About(per_ha, group): about the land wherever its niche is, so many to a hectare
//            of it, in groups of so many (terra_creatures::wildlife)
//   niche    for one About: the growing season's mean warmth it takes, in °C, and the places
//            it keeps to: Woods, Open, Shore, Water, Trodden
//   moves    Walks (the default), Flies(metres a second) from place to place, or Swims(feet_m)
//            afloat, its feet so far under the surface
//   wades_m  how deep a water it walks into
//   seen_m   how far off it is drawn
//   calls_s  how often it calls of its own accord at rest, (least, most) seconds; none for
//            a kind that only calls in alarm
//   pools    whether it forms where magic pools (D103)
//   stride   how far a step carries, as so far and so much more for each metre a second
//   feet     what its steps sound like
//   voice    what it sounds like when it is alarmed
//   blood    what sprays from it when it is struck
//   carcass  what butchering it takes and gives, if it can be butchered
//   lies_s   how long its body lies after it falls
//   coat     a coat moulted with the seasons (terra_creatures::coats): the tint its summer coat lays
//            over the model's own pale colours, how far one animal's tone strays, and whether it
//            moults white in winter (moults, the default) or keeps its tint the year round
//   zones    where a blow can land (D119): around the model's joints whose names contain
//            `joint`, out to radius_m; the head takes the most from a blow, the legs least
//
// The small animals' models are made by tools/creatures/animal.py from art/creatures/, which
// prints each clip's pace.
[
    (
        name: "Deer",
        model: ("models/creatures/Deer.glb", 0.36),
        clips: (
            idle: "AnimalArmature|Idle",
            walk: "AnimalArmature|Walk",
            run: "AnimalArmature|Gallop",
            eat: "AnimalArmature|Eating",
            attack: "AnimalArmature|Attack_Kick",
            death: "AnimalArmature|Death",
        ),
        health: 16.0,
        walk_mps: 1.4,
        run_mps: 7.5,
        body: (radius: 0.45, weight: 2.0),
        temper: Shy(flees_within_m: 9.0, flees_s: 4.0),
        lives: Herd(5),
        stride: (0.5, 0.2),
