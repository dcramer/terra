// The flooded mine, "Deep Seam" (docs/dungeons.md). Working assumptions, not designed: the
// numbers, the bestiary and the loot are stand-ins until the developers settle them.
// Module sides are north, east, south, west, each the sockets it takes joined by `|`:
// open (floor into the same space), wall, door, stair, rubble, water, and the theme's own
// (a pillar row's aisle, a wall's rhythm ra/rb, a rail): a socket few modules take is a rule
// (D483). Water meets dry ground only at a shore. `any` is every socket but water and rubble.
(
    name: "flooded_mine",
    title: "Deep Seam",
    goal: "Reach the miner trapped in the deepest gallery; the lever in the pump room drains the flooded gate.",
    rooms: (12, 16),
    levels: 3,
    keys: 1,
    // The hard rock it is cut in (data/kits/minerock.ron), not laid stone: its walls, and
    // its roof over every room no room stands on.
    walls: "Minerock",
    // Its floors the same rock trodden dark (data/kits/minefloor.ron), not cob.
    floors: "Minefloor",
    ceilings: Some("Minerock"),
    // Its doorways' cribbing (data/kits/minetimber.ron): hewn beams laid dry, no daub.
    trim: "Minetimber",
    // Drifts under their timber sets at 3.5 m, stopes 5 m (D527).
    headroom: (3.5, 5.0),
    // A set every 2 m down each straight drift, its lagging roofing it at 2.9 m, under the
    // ceiling's cubes (tools/props/mine.py; docs/dungeons.md, the hewn mine's plan).
    timber: Some((set: "models/props/mine/TimberSet.glb", every: 2.0)),
    // A set's posts stop a walker (stamp::blocks): each battered from 1.30 m out at its foot
    // to 1.24 m at its head, 11 cm round, up to the cap at 2.6 m.
    solids: {
        "models/props/mine/TimberSet.glb": [
            (foot: (-1.27, 0.0, 0.0), half: (0.14, 1.3, 0.11)),
            (foot: (1.27, 0.0, 0.0), half: (0.14, 1.3, 0.11)),
        ],
    },
    // A mine's doors are ledged and braced planks, hung to keep the air going where it is
    // sent, not a castle's studded oak (round 2's judges, 14 mentions); made for the mine at
    // a leaf's real size (tools/props/mine.py), so it hangs unstretched and matte, where
    // building's ledged door, at a house's 0.9 x 1.9 m, stretched 1.7 x 1.5 read glossy.
    door: "models/props/mine/MineDoor.glb",
    door_leaf: (1.5, 3.0),
    // The trapped miner sits waiting on the goal's block in his work clothes.
    features: (
        goal: "trapped_miner",
        key: "pump_lever",
        rest: "campfire",
        stair: "stair",
        figure: Some((clip: "Sitting_Idle_Loop", wears: ["shirt", "trousers", "boots", "cap"])),
    ),
    bestiary: [
        (species: "Spider", roles: [Passage, Branch, Shortcut, Treasure, Puzzle], group: (1, 2)),
        (species: "Spider", roles: [Branch, Guard, Goal, Treasure], danger: 0.4, group: (3, 5), weight: 2.0),
    ],
    loot: [
        (item: "Ore", roles: [Passage, Branch, Treasure, Shortcut], count: (2, 6), weight: 3.0),
        (item: "Iron", roles: [Treasure, Secret, Guard, Goal], danger: 0.3, count: (1, 3), weight: 2.0),
        (item: "Iron pickaxe", roles: [Treasure, Secret, Goal], danger: 0.5, count: (1, 1)),
        (item: "Torch", roles: [Passage, Branch, Rest], count: (1, 2)),
        (item: "Cooked meat", roles: [Rest, Treasure], count: (1, 3)),
    ],
    modules: [
        // Floors.
        (name: "earth_floor", sides: ["open|wall|door|stair", "open|wall|door|stair", "open|wall|door|stair", "open|wall|door|stair"], weight: 8.0, rotates: false, safe: true),
        // Timbering in rhythm along a gallery: a set of posts and beam, then a plain bay.
        (name: "timber_set", sides: ["wall", "ra|wall|door|stair", "open|wall|door|stair", "rb|wall|door|stair"], weight: 3.0),
        (name: "earth_bay", sides: ["wall", "rb|wall|door|stair", "open|wall|door|stair", "ra|wall|door|stair"], weight: 3.0),
        // Flooded galleries: water meets dry ground only at a shore with steps down.
        (name: "flooded", sides: ["water|wall|door", "water|wall|door", "water|wall|door", "water|wall|door"], weight: 4.0, rotates: false),
        (name: "shore", sides: ["water", "open|wall|door|stair", "open|wall|door|stair", "open|wall|door|stair"], weight: 2.0),
        (name: "shore_corner", sides: ["water", "water", "open|wall|door|stair", "open|wall|door|stair"], weight: 1.0),
        (name: "ore_vein", sides: ["wall", "open|wall|door|stair", "open|wall|door|stair", "open|wall|door|stair"], weight: 1.5),
        // Rails run unbroken along a gallery, from a door or stair to a door, a stair or a buffer.
        (name: "rail_run", sides: ["rail|door|stair", "wall", "rail|door|stair", "wall"], weight: 4.0, spaces: [Corridor]),
        (name: "rail_turn", sides: ["rail|door|stair", "rail|door|stair", "wall", "wall"], weight: 2.0, spaces: [Corridor]),
        (name: "rail_buffer", sides: ["rail", "wall", "open|wall|door|stair", "wall"], weight: 1.0, spaces: [Corridor]),
        (name: "tool_corner", sides: ["wall", "wall", "open|door", "open|door"], weight: 1.5, spaces: [Room]),
        // Pit props stand in rows under the roof beam.
        (name: "prop_post", sides: ["aisle|wall", "open", "aisle|wall", "open"], weight: 3.0, spaces: [Room]),
        (name: "cave_in", sides: ["wall", "wall", "rubble", "rubble"], weight: 1.5, spaces: [Room], blocks: true),
        (name: "spoil_heap", sides: ["rubble", "open|wall|door|stair", "open|wall|door|stair", "open|wall|door|stair"], weight: 0.5),
        (name: "trapped_miner", sides: ["any", "any", "any", "any"], fixed: true, spaces: [Room]),
        (name: "pump_lever", sides: ["any", "any", "any", "any"], fixed: true, spaces: [Room]),
        (name: "campfire", sides: ["any", "any", "any", "any"], fixed: true, spaces: [Room]),
        (name: "stair", sides: ["open|wall|stair", "open|wall|stair", "open|wall|stair", "open|wall|stair"], fixed: true, spaces: [Stair], rotates: false),
    ],
    // Rooms by the job they were cut for (docs/dungeons.md, the hewn mine's plan, D559; its
    // room types D539, Open with the crypt's): a first set from the props there are, each lit
    // by a miner's lantern. The winch, the ore tub on its rails, the ladder, webs, powder kegs
    // and ingots wait for their models; a hand cart stands for the tub, at 0.8 (2.2 m with its
    // shafts) and laid along its wall, half its 1.1 m width out from it.
    dressing: [
        // The shaft station, where ore was brought to be hauled up: a cart, the stores.
        (name: "shaft station", roles: [Entrance],
         hero: [("models/props/HandCart.glb", 0.8)], hero_foot: Some((half: (1.08, 0.56), turned: true)),
         lamp: Some(("models/props/Lantern.glb", 1.0)),
         props: [
            ("models/props/Barrel.glb", 1.0), ("models/props/Buckets.glb", 1.0),
            ("models/props/Sack.glb", 1.0), ("models/props/ToolBucket.glb", 1.0),
         ], count: (2, 3),
         clutter: [("models/props/Buckets.glb", 0.8), ("models/props/HandTools.glb", 1.0)], litter: (1, 1),
         scatter: [("models/props/barrow/Planks.glb", 1.0)], strewn: (1, 1)),
        // A working stope along the vein: the cart, timber stacked to be set, the tools.
        (name: "working stope", roles: [Passage],
         hero: [("models/props/HandCart.glb", 0.8)], hero_foot: Some((half: (1.08, 0.56), turned: true)),
         lamp: Some(("models/props/Lantern.glb", 1.0)),
         props: [
            ("models/props/Log.glb", 1.0), ("models/props/barrow/Planks.glb", 1.0),
            ("models/props/ToolBucket.glb", 1.0), ("models/props/Barrel.glb", 1.0),
         ], count: (2, 3),
         clutter: [("models/props/HandTools.glb", 1.0), ("models/props/Buckets.glb", 0.8)], litter: (1, 1),
         scatter: [("models/props/barrow/Planks.glb", 1.0)], strewn: (1, 1)),
        // A worked-out stope, left when the roof came in: split timber, the last shift's things.
        (name: "worked-out stope", roles: [Branch],
         hero: [("models/props/HandCart.glb", 0.8)], hero_foot: Some((half: (1.08, 0.56), turned: true)),
         lamp: Some(("models/props/Lantern.glb", 0.9)),
         props: [("models/props/barrow/Planks.glb", 1.0), ("models/props/Log.glb", 1.0), ("models/props/Barrel.glb", 1.0)], count: (2, 3),
         clutter: [("models/props/HandTools.glb", 1.0)], litter: (1, 1),
         scatter: [("models/props/barrow/Planks.glb", 1.0)], strewn: (1, 1),
         // The last shift: the tools laid down, a pot for their meal, a sack.
         vignette: [
            ("models/props/HandTools.glb", 1.05, (0.0, 0.3)), ("models/props/StewPot.glb", 0.8, (0.75, 0.25)),
            ("models/props/Sack.glb", 1.0, (-0.75, 0.0)),
         ]),
        // The spiders' stope: a miner's body wrapped where it was caught, the bones of others.
        (name: "spiders' stope", roles: [Guard],
         hero: [("models/props/barrow/Shroud.glb", 1.0)], lamp: Some(("models/props/Lantern.glb", 0.9)),
         props: [("models/props/barrow/BoneHeap.glb", 1.0), ("models/props/barrow/Planks.glb", 1.0), ("models/props/Barrel.glb", 1.0)], count: (2, 3),
         clutter: [("models/props/barrow/Skull.glb", 1.15), ("models/props/barrow/BoneHeap.glb", 1.0)], litter: (1, 1),
         scatter: [("models/props/barrow/Planks.glb", 1.0)], strewn: (1, 1),
         // A dropped load: the bucket, the tools, a skull by them.
         vignette: [
            ("models/props/Buckets.glb", 0.9, (0.0, 0.2)), ("models/props/HandTools.glb", 1.05, (0.8, 0.35)),
            ("models/props/barrow/Skull.glb", 1.1, (-0.6, 0.4)),
         ]),
        // The pump room, its lever the hero: barrels, buckets, the fitter's tools.
        (name: "pump room", roles: [Puzzle],
         props: [
            ("models/props/Barrel.glb", 1.0), ("models/props/Buckets.glb", 1.0),
            ("models/props/ToolBucket.glb", 1.0), ("models/props/Workbench.glb", 1.0),
         ], count: (2, 3),
         clutter: [("models/props/HandTools.glb", 1.0), ("models/props/Buckets.glb", 0.8)], litter: (1, 1),
         scatter: [("models/props/barrow/Planks.glb", 1.0)], strewn: (1, 1)),
        // The powder and pay store: a strongbox among the stores.
        (name: "powder and pay store", roles: [Treasure, Secret],
         hero: [("models/props/Chest.glb", 1.0)], lamp: Some(("models/props/Lantern.glb", 1.0)),
         props: [("models/props/Barrel.glb", 1.0), ("models/props/Chest.glb", 0.9), ("models/props/Sack.glb", 1.0)], count: (2, 3),
         clutter: [("models/props/Sack.glb", 0.8)], litter: (1, 1),
         // The stash: a chest kept behind the barrels.
         vignette: [
            ("models/props/Chest.glb", 0.9, (0.0, 0.0)), ("models/props/Barrel.glb", 1.0, (0.85, 0.45)),
            ("models/props/Barrel.glb", 1.0, (-0.8, 0.45)),
         ]),
        // The way up a raise, timber kept for its cribbing.
        (name: "ladderway", roles: [Shortcut],
         hero: [("models/props/Log.glb", 1.1)], lamp: Some(("models/props/Lantern.glb", 0.9)),
         props: [("models/props/Log.glb", 1.0), ("models/props/barrow/Planks.glb", 1.0)], count: (1, 2),
         scatter: [("models/props/barrow/Planks.glb", 1.0)], strewn: (1, 1)),
        // The flooded working, the trapped miner its hero: what he had with him.
        (name: "flooded working", roles: [Goal],
         props: [("models/props/Barrel.glb", 1.0), ("models/props/barrow/Planks.glb", 1.0)], count: (1, 2),
         clutter: [("models/props/Buckets.glb", 0.8)], litter: (1, 1)),
        // The miners' crib room round its fire: where they ate, and where one slept.
        (name: "crib room", roles: [Rest],
         props: [("models/props/Bench.glb", 1.0), ("models/props/Barrel.glb", 1.0), ("models/props/Stool.glb", 1.0)], count: (2, 3),
         clutter: [("models/props/BowlStack.glb", 1.0), ("models/props/StewPot.glb", 1.0), ("models/props/HandTools.glb", 1.0)], litter: (1, 1),
         // A bedroll laid out from the wall, its blanket folded at its head, the miner's
         // pack by it, a lantern.
         vignette: [
            ("models/props/RugLong.glb", 0.55, (0.0, 0.5)), ("models/props/FoldedCloth.glb", 0.8, (0.0, -0.12)),
            ("models/props/Sack.glb", 1.0, (0.8, 0.0)), ("models/props/Lantern.glb", 1.0, (-0.75, 0.1)),
         ]),
        // Where the tour crosses a small room every way and the cart fits nowhere off it, a
        // smaller hero (the room's other dressing as above): a big barrel of the stores at the
        // shaft, timber to be set in a stope.
        (name: "cramped shaft station", roles: [Entrance],
         hero: [("models/props/Barrel.glb", 1.2)], hero_foot: Some((half: (0.35, 0.35))),
         lamp: Some(("models/props/Lantern.glb", 1.0)), props: [], count: (0, 0)),
        (name: "cramped stope", roles: [Passage, Branch],
         hero: [("models/props/Log.glb", 1.1)], hero_foot: Some((half: (0.94, 0.25))),
         lamp: Some(("models/props/Lantern.glb", 1.0)), props: [], count: (0, 0)),
    ],
)
