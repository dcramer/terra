// The crypt, "The Ossuary Gate" (docs/dungeons.md). Working assumptions, not designed: the
// numbers, the bestiary and the loot are stand-ins until the developers settle them.
// Module sides are north, east, south, west, each the sockets it takes joined by `|`:
// open (floor into the same space), wall, door, stair, rubble, water, and the theme's own
// (a pillar row's aisle, an alcove run, a wall's rhythm ra/rb, a rail or runner): a socket few
// modules take is a rule (D483). `any` is every socket but water and rubble.
(
    name: "crypt",
    title: "The Ossuary Gate",
    goal: "Take the relic from the crypt-lord's chamber behind the locked gate; its key lies in the ossuary.",
    rooms: (11, 15),
    levels: 2,
    keys: 1,
    walls: "Barrowstone",
    // Dressed flags (data/packs/flagstone.ron): Fieldstone's crazy paving, dirtied all over,
    // read as mud (barrow dress round 20); its ceilings kept Fieldstone's.
    floors: "Flagstone",
    ceilings: Some("Stone"),
    trim: "Barrowtrim",
    // Vaulted: a corridor crowned at 4.5 m, a room at 5 m (D527), flat cubes over the kit's
    // vaults, which spring at 2.95 m and hide them.
    headroom: (4.5, 5.0),
    // The barrow halls kit (tools/props/barrow.py).
    kit: Some((
        barrel: "models/props/barrow/BarrelVault.glb",
        groin: "models/props/barrow/GroinVault.glb",
        arch: "models/props/barrow/DoorArch.glb",
        pier: "models/props/barrow/Pier.glb",
        niche: "models/props/barrow/Loculus.glb",
        remains: ["models/props/barrow/Shroud.glb", "models/props/barrow/BoneHeap.glb", "models/props/barrow/Skull.glb"],
        sarcophagus: Some("models/props/barrow/Sarcophagus.glb"),
        spring: 2.95,
    )),
    features: (goal: "relic_dais", key: "ossuary_altar", rest: "campfire", stair: "stair"),
    bestiary: [
        (species: "Spider", roles: [Passage, Branch, Shortcut, Treasure, Puzzle], group: (1, 2)),
        (species: "Spider", roles: [Passage, Branch, Guard, Goal, Treasure], danger: 0.5, group: (2, 4), weight: 2.0),
    ],
    loot: [
        (item: "Arrow", roles: [Passage, Branch, Treasure, Shortcut], count: (4, 10), weight: 2.0),
        (item: "Iron", roles: [Treasure, Secret, Guard, Goal], count: (1, 3), weight: 2.0),
        (item: "Bow", roles: [Treasure, Secret, Goal], danger: 0.4, count: (1, 1)),
        (item: "Leather coat", roles: [Treasure, Secret, Goal], danger: 0.3, count: (1, 1)),
        (item: "Boots", roles: [Treasure, Branch], count: (1, 1)),
        (item: "Torch", roles: [Passage, Rest], count: (1, 2)),
        (item: "Cooked meat", roles: [Rest], count: (1, 3)),
    ],
    modules: [
        // Floors.
        (name: "flagstones", sides: ["open|wall|door|stair", "open|wall|door|stair", "open|wall|door|stair", "open|wall|door|stair"], weight: 10.0, rotates: false, safe: true),
        (name: "cracked_flags", sides: ["open|wall|door|stair", "open|wall|door|stair", "open|wall|door|stair", "open|wall|door|stair"], weight: 3.0, rotates: false),
        // Loculi in runs along a wall, from a corner, door or end to the next.
        (name: "loculi", sides: ["wall", "alcove|wall|door|stair", "open|wall|door|stair", "alcove|wall|door|stair"], weight: 4.0),
        (name: "loculi_end_e", sides: ["wall", "alcove", "open|wall|door|stair", "open|wall|door|stair"], weight: 1.0),
        (name: "loculi_end_w", sides: ["wall", "open|wall|door|stair", "open|wall|door|stair", "alcove"], weight: 1.0),
        // A wall in rhythm: a sconce or a carved relief, then a plain bay, then again.
        (name: "sconce", sides: ["wall", "ra|wall|door|stair", "open|wall|door|stair", "rb|wall|door|stair"], weight: 2.0),
        (name: "relief_decor", sides: ["wall", "ra|wall|door|stair", "open|wall|door|stair", "rb|wall|door|stair"], weight: 1.0),
        (name: "ashlar_bay", sides: ["wall", "rb|wall|door|stair", "open|wall|door|stair", "ra|wall|door|stair"], weight: 3.0),
        // Pillars only in rows, from wall to wall (or to the dais).
        (name: "pillar", sides: ["aisle|wall", "open", "aisle|wall", "open"], weight: 3.0, spaces: [Room]),
        (name: "sarcophagus", sides: ["wall", "open|wall", "open", "open|wall"], weight: 2.0, spaces: [Room]),
        (name: "urns", sides: ["wall", "wall", "open|door", "open|door"], weight: 1.5, spaces: [Room]),
        (name: "bone_drift", sides: ["open|wall|door|stair", "wall", "open|wall|door|stair", "wall"], weight: 2.0, spaces: [Corridor]),
        // A collapse in a corner spills rubble into both cells beside it.
        (name: "collapse", sides: ["wall", "wall", "rubble", "rubble"], weight: 1.0, spaces: [Room], blocks: true),
        (name: "rubble_spill", sides: ["rubble", "open|wall|door|stair", "open|wall|door|stair", "open|wall|door|stair"], weight: 0.5),
        (name: "relic_dais", sides: ["any", "any", "any", "any"], fixed: true, spaces: [Room]),
        (name: "ossuary_altar", sides: ["any", "any", "any", "any"], fixed: true, spaces: [Room]),
        (name: "campfire", sides: ["any", "any", "any", "any"], fixed: true, spaces: [Room]),
        (name: "stair", sides: ["open|wall|stair", "open|wall|stair", "open|wall|stair", "open|wall|stair"], fixed: true, spaces: [Stair], rotates: false),
    ],
    // Rooms by what they are for, each a room type with a story (docs/dungeons.md's room
    // types, D539, Open: the developers choose): a hero prop on the wall that faces the way in
    // (none where the room's feature is its hero), a vignette, wall props so many per four
    // cells, clutter so many a cell (stamp/furnish.rs).
    dressing: [
        // The antechamber, where mourners left their offerings at the threshold.
        (name: "antechamber", roles: [Entrance],
         hero: [("models/props/barrow/Altar.glb", 1.0)], lamp: Some(("models/props/barrow/Candles.glb", 1.0)),
         props: [
            ("models/props/barrow/Urns.glb", 1.0), ("models/props/barrow/Candles.glb", 1.0),
            ("models/props/VasePair.glb", 1.0),
         ], count: (2, 3),
         clutter: [("models/props/barrow/Candles.glb", 0.8), ("models/props/BrassPans.glb", 1.0)], litter: (1, 1),
         scatter: [("models/props/barrow/StandFallen.glb", 1.0), ("models/props/barrow/UrnFallen.glb", 1.0)], strewn: (1, 1)),
        // The ossuary passage: the dead laid along it, a coffin waiting for its niche.
        (name: "ossuary passage", roles: [Passage],
         hero: [("models/props/barrow/Coffin.glb", 1.0)], lamp: Some(("models/props/barrow/Candles.glb", 1.0)),
         props: [
            ("models/props/barrow/BoneHeap.glb", 1.0), ("models/props/barrow/Urns.glb", 1.0),
            ("models/props/barrow/Shroud.glb", 1.0), ("models/props/barrow/Candles.glb", 1.0),
         ], count: (2, 3),
         clutter: [("models/props/barrow/Skull.glb", 1.15), ("models/props/barrow/Candles.glb", 0.7)], litter: (1, 1),
         scatter: [("models/props/barrow/BoneHeap.glb", 1.0), ("models/props/barrow/UrnFallen.glb", 1.0), ("models/props/barrow/Planks.glb", 1.0)], strewn: (1, 1)),
        // A robbed tomb: the coffin's lid pushed aside, the looter's leavings by a chest.
        (name: "robbed tomb", roles: [Branch],
         hero: [("models/props/barrow/Coffin.glb", 1.0)], lamp: Some(("models/props/barrow/Candles.glb", 0.9)),
         props: [
            ("models/props/VasePair.glb", 1.0), ("models/props/Chest.glb", 1.0),
            ("models/props/barrow/BoneHeap.glb", 1.0), ("models/props/barrow/Urns.glb", 1.0),
         ], count: (2, 3),
         clutter: [("models/props/PlateStack.glb", 1.0), ("models/props/BowlStack.glb", 1.0), ("models/props/BrassPans.glb", 1.0)], litter: (1, 1),
         scatter: [("models/props/barrow/Planks.glb", 1.0), ("models/props/barrow/UrnFallen.glb", 1.0), ("models/props/barrow/BoneHeap.glb", 1.0)], strewn: (1, 1),
         vignette: [
            ("models/props/Chest.glb", 1.0, (0.0, 0.05)), ("models/props/BowlStack.glb", 1.0, (0.85, 0.3)),
            ("models/props/Lantern.glb", 1.0, (-0.8, 0.1)),
         ]),
        // A guard post: the guards' bench, their fallen, their last stand.
        (name: "guard post", roles: [Guard],
         hero: [("models/props/Bench.glb", 1.0)], lamp: Some(("models/props/barrow/Candles.glb", 0.8)),
         props: [
            ("models/props/barrow/BoneHeap.glb", 1.0), ("models/props/barrow/Shroud.glb", 1.0),
            ("models/props/Barrel.glb", 1.0), ("models/props/Lantern.glb", 1.0),
         ], count: (2, 3),
         clutter: [("models/props/barrow/BoneHeap.glb", 1.1), ("models/props/barrow/Skull.glb", 1.15)], litter: (1, 1),
         scatter: [("models/props/barrow/BoneHeap.glb", 1.0), ("models/props/barrow/Planks.glb", 1.0), ("models/props/barrow/StandFallen.glb", 1.0)], strewn: (1, 1),
         // The fallen guard, a shield leant against the wall by him, the axes laid down, a
         // second shield: 0.3 m out from the wall's face, a shield's foot touches it.
         vignette: [
            ("models/props/barrow/Shroud.glb", 1.0, (0.0, 0.0)), ("models/tools/RoundShield.glb", 1.0, (-0.8, -0.22)),
            ("models/props/AxesLaid.glb", 1.0, (0.85, 0.25)), ("models/tools/HeaterShield.glb", 1.0, (-1.35, -0.24)),
         ]),
        // The ossuary, the key on its altar (the room's hero): the heaped dead.
        (name: "ossuary", roles: [Puzzle],
         props: [
            ("models/props/barrow/BoneHeap.glb", 1.0), ("models/props/barrow/Shroud.glb", 1.0),
            ("models/props/barrow/Urns.glb", 1.0),
         ], count: (3, 4),
         clutter: [("models/props/barrow/Candles.glb", 0.8), ("models/props/barrow/Skull.glb", 1.2), ("models/props/barrow/BoneHeap.glb", 1.1)], litter: (1, 1),
         scatter: [("models/props/barrow/BoneHeap.glb", 1.0), ("models/props/barrow/Skull.glb", 1.2), ("models/props/barrow/UrnFallen.glb", 1.0)], strewn: (1, 2)),
        // A treasury of grave goods round its chest.
        (name: "treasury", roles: [Treasure, Secret],
         hero: [("models/props/Chest.glb", 1.1)], lamp: Some(("models/props/barrow/Candles.glb", 1.0)),
         props: [
            ("models/props/VaseRow.glb", 1.0), ("models/props/PlateStack.glb", 1.0),
            ("models/props/barrow/Urns.glb", 1.0), ("models/props/BowlStack.glb", 1.0),
            ("models/props/Chest.glb", 1.0), ("models/props/BrassPans.glb", 1.0),
         ], count: (3, 4),
         clutter: [("models/props/BrassPans.glb", 1.0), ("models/props/PlateStack.glb", 1.0), ("models/props/VasePair.glb", 1.0)], litter: (1, 2),
         scatter: [("models/props/barrow/UrnFallen.glb", 1.0), ("models/props/barrow/Planks.glb", 1.0)], strewn: (1, 1),
         vignette: [
            ("models/props/barrow/Candles.glb", 1.0, (0.0, 0.1)), ("models/props/BowlStack.glb", 1.0, (0.55, 0.2)),
            ("models/props/VaseRow.glb", 1.0, (-0.65, 0.0)),
         ]),
        // A chapel on the way back: an altar and its candles.
        (name: "chapel", roles: [Shortcut],
         hero: [("models/props/barrow/Altar.glb", 1.0)], lamp: Some(("models/props/barrow/Candles.glb", 1.0)),
         props: [("models/props/barrow/Candles.glb", 1.0), ("models/props/barrow/Urns.glb", 1.0)], count: (2, 3),
         clutter: [
            ("models/props/barrow/Candles.glb", 0.8), ("models/props/BowlStack.glb", 1.0),
            ("models/props/PlateStack.glb", 1.0),
         ], litter: (1, 1),
         scatter: [("models/props/barrow/StandFallen.glb", 1.0), ("models/props/barrow/UrnFallen.glb", 0.9)], strewn: (1, 1)),
        // The lord's burial chamber, the relic on its dais its hero: grave goods by the walls.
        (name: "lord's chamber", roles: [Goal],
         props: [
            ("models/props/barrow/Urns.glb", 1.0), ("models/props/VaseRow.glb", 1.0),
            ("models/props/BrassPans.glb", 1.0), ("models/props/barrow/Candles.glb", 1.0),
         ], count: (2, 3),
         clutter: [
            ("models/props/barrow/Candles.glb", 0.8), ("models/props/PlateStack.glb", 1.0),
            ("models/props/barrow/BoneHeap.glb", 1.1),
         ], litter: (1, 1),
         scatter: [("models/props/barrow/StandFallen.glb", 1.0), ("models/props/barrow/BoneHeap.glb", 1.0), ("models/props/barrow/UrnFallen.glb", 1.0)], strewn: (1, 1)),
        // The camp of delvers who came before, round its fire.
        (name: "delvers' camp", roles: [Rest],
         props: [
            ("models/props/Barrel.glb", 1.0), ("models/props/Log.glb", 1.0),
            ("models/props/Buckets.glb", 1.0),
         ], count: (2, 3),
         clutter: [("models/props/BowlStack.glb", 1.0), ("models/props/HandTools.glb", 1.0)], litter: (1, 1),
         scatter: [("models/props/barrow/Planks.glb", 1.0)], strewn: (1, 1),
         // A bedroll laid out from the wall (RugLong, 0.8 by 1.65 m at this scale), its blanket
         // folded at its head, the delver's pack against the wall by it, a lantern.
         vignette: [
            ("models/props/RugLong.glb", 0.55, (0.0, 0.5)), ("models/props/FoldedCloth.glb", 0.8, (0.0, -0.12)),
            ("models/props/Sack.glb", 1.0, (0.8, 0.0)), ("models/props/Lantern.glb", 1.0, (-0.75, 0.1)),
         ]),
    ],
)
