// Creatures that fly (D382, play::fliers): a flier body plan, each kind a model with its
// clips and how it flies (research/2026-10-17-large-flier-motion.md).
//
// model         its file and its scale
// clips         its clips by what they are for: beating its wings in flight, gliding,
//               hovering, breathing fire hovering, breathing fire in a strafing pass, roaring
// cruise_mps    how fast it flies along a course, metres a second; hover_mps the slowest it
//               flies one, as it comes into a hover
// accel_mps2    how hard it gathers speed, and brake_mps2 sheds it, metres a second a second
// most_bank_deg how far it rolls into a turn at most (a vulture circles at 25 to 35, a 45
//               degree bank is 1.4 g), which with its speed sets how tight it can turn;
//               bank_s how long it takes to roll into a bank; turn_deg_s how fast it turns
//               on the spot hovering
// flare_deg     how far it raises its nose braking hard, wings spread against the air
// neck, tail    its neck's and tail's bones, by name and count from the body out
// windup_s      how long it rears back before its breath comes, the tell
// mouth         the model's socket its breath leaves from, along the model's front
// breath        how far its flame reaches in metres, how wide it spreads (the tangent of its
//               half angle), and how hot (heat a second, as a burning cube's full flame gives
//               the cube over it; a log catches at 3)
[
    (
        name: "Dragon",
        model: ("models/creatures/Dragon.glb", 1.3),
        clips: (
            fly: "Fly",
            glide: "Glide",
            hover: "Hover",
            breathe: "Breathe",
            fly_breathe: "FlyBreathe",
            roar: "Roar",
        ),
        cruise_mps: 24.0,
        hover_mps: 3.0,
        accel_mps2: 3.0,
        brake_mps2: 6.0,
        most_bank_deg: 45.0,
        bank_s: 0.9,
        turn_deg_s: 50.0,
        flare_deg: 30.0,
        neck: ("Neck", 6),
        tail: ("Tail", 10),
        windup_s: 0.8,
        mouth: "Mouth",
        breath: (reach_m: 30.0, spread: 0.2, heat: 20.0),
    ),
]
