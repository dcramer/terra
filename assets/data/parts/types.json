    "pick_head": { "made_by": "model", "slot": "working", "origin": "eye.lower", "entry": "eye.lower", "handle_top": "eye.upper", "points": [["eye.lower", "eye"], ["eye.upper", "eye"], ["tip", "tip"]], "roles": ["Metal"], "triangles": "small_triangles" },
