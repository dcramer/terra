{
  "about": "The part types of assembled items (D565, D566; docs/assembled-items.md, The connection-point convention): for each, who makes it, its slot, the point at its frame's origin, the points it must declare, how it is placed and its budgets. Read by the part checker (tools/items/part.ts), the kind check (tools/items/kind.ts) and the assembler (terra_items::assembly). A part's own data is assets/data/parts/<part>.json (part.schema.json).",
  "rules": {
    "join_m": { "value": 0.001, "source": "D566: model meets model within 1 mm, the part checker's bar; a measured opening within 1 mm of its declared size" },
    "proud_m": { "value": 0.004, "source": "D566: a haft stands 4 mm proud of its head's eye.upper, so its end never lies in the head's top face" },
    "trim_cover_m": { "value": 0.01, "source": "D566: a trim covers a join by at least 1 cm (research/2026-10-28-assembled-parts-art.md section 3)" },
    "plane_m": { "value": 0.0002, "source": "two faces closer than 0.2 mm, facing the same line and overlapping, are one plane (z-fighting at a metre's view, the convention's no two surfaces in one plane)" },
    "roles": { "value": ["Wood", "Metal", "Leather", "String", "Trim", "Fire"], "source": "fit_held.py's ROLES (Wood, Metal, Trim, String), terra_walker::character's Tint (Leather) and art-style.md (a part named Fire glows): a material's name before any '.'" },
    "small_triangles": { "value": [300, 800], "source": "docs/art-style.md's budget table: a small item, a tool's head" },
    "board_triangles": { "value": [600, 1500], "source": "docs/art-style.md's budget table: a prop, as a board is of a chair's size" },
    "texture_px": { "value": 1024, "source": "docs/art-style.md: 1K colour and normal maps for a model under 1.5 m (D304); roughness and metal at half" },
    "textures": { "value": 3, "source": "one map set a part, colour, normal and roughness-metal, so parts share a pipeline (research/2026-10-28-assembled-items-pipeline.md verdict 1c)" }
  },
