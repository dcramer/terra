// An earth wall's kit (docs/building-kits.md, D194, D197, D227, D236): cob, earth and straw
// built up in lifts a cube thick, drawn as its cubes' own surface as stone is, but its
// outside edges rounded soft, as earth weathers, and its face lumped by the clay's height.
// It stands on a stone plinth to keep it dry, wears a stone coping with a drip where its top
// is open to the sky, and has oak over and under its openings; its corners and reveals are
// left round, with no quoins. Its roof is thatch (`roof_kind`, D241). What this leaves out
// is the log kit's; logs.ron and stone.ron say what each number is.
//
// bevel       how far its outside edges are rounded: 12 cm, soft, as earth's are (D194)
// tint        its clay warmed and lightened to a dry ochre
// relief      how far its lumps stand out
// textures    its earth (Poly Haven's clay_plaster, CC0), its floors' beaten earth
//             (clay_floor_001), its plinth's and coping's stone (rock_boulder_dry), its
//             lintels', sills', sole plates' and treads' oak (rough_wood)
// cost        a cube in two lifts, each an eighth of a Stone (the grit in it) and of a Fibre
//             (its straw), the earth dug where it stands
// dress       a stone plinth at every foot, stepping with the ground; a stone coping with a
//             drip on every top open to the sky; an oak lintel over and an oak sill under
//             every opening; an oak sole plate where a timber wall stands on it; an oak fascia
//             under an overhang, an oak tread on every step, a stone border round a floor;
//             posts as round-cornered pillars 40 cm square; nothing up its corners or its
//             openings' sides, which stay round; its lifts a little lighter and darker by
//             turns (strata), dirt splashed up its foot
// meets       a block kind as stone is (D232), heavier than timber and running through it,
//             its sole plate under timber standing on it; stone runs through it, so it stands
//             on a stone plinth wall under that wall's cap, and ends against stone
(
    id: 4,
    pattern: Masonry,
    roof_kind: Some(2050),
    bevel: 0.12,
    relief: 0.065,
    tint: (1.16, 1.07, 0.96),
    timber: (
        profile: Hewn,
        notch: Flush,
        relief: 0.0,
        tint: (0.82, 0.7, 0.58),
        end_tint: (0.86, 0.8, 0.72),
        variation: (thickness: 0.04, shade: 0.12, warmth: 0.05),
    ),
    textures: {
        Masonry: (path: "materials/clay_plaster", metres: (1.2, 1.2)),
        Floor: (path: "materials/clay_floor_001", metres: (2.0, 2.0)),
        Dressed: (path: "materials/rock_boulder_dry", metres: (1.4, 1.4)),
        Hewn: (path: "materials/rough_wood", metres: (0.5, 0.5)),
        Board: (path: "materials/weathered_planks", metres: (2.0, 2.0)),
        Log: (path: "materials/rough_wood", metres: (0.5, 0.5)),
        LogEnd: (path: "materials/log_end", metres: (1.0, 1.0)),
    },
    cost: (steps: 2, step: [("Stone", 1, 16), ("Fibre", 1, 16)]),
    dress: (
        pieces: Some("data/kits/pieces/earth.ron"),
        roles: {
            Foot: Profile(name: "plinth", joints: false),
            Crest: Profile(name: "coping"),
            Head: Profile(name: "lintel", extend: 0.22, joints: false, material: Some(Hewn)),
            Sill: Profile(name: "sill", extend: 0.08, joints: false, material: Some(Hewn)),
            Meet: Profile(name: "cap", joints: false, material: Some(Hewn)),
            Soffit: Profile(name: "fascia", joints: false, material: Some(Hewn)),
            Nose: Profile(name: "nose", joints: false, material: Some(Hewn)),
            Border: Profile(name: "border"),
            Post: Pillar(width: 0.4),
        },
        tint: (0.95, 0.9, 0.84),
        masks: (dirt: 0.6, dirt_tint: (0.72, 0.64, 0.54), wear: 0.12, moss: 0.5, moss_tint: (0.7, 0.72, 0.5), strata: 0.12, lift: 0.42),
    ),
    meets: Some((
        weight: 3,
        end: None,
        carries: Cap,
        kinds: {
            // Logs and hewn timber end against it, on its sole plate where they stand on it.
            1: (through: Some(true)),
            3: (through: Some(true)),
            // Stone runs through it: earth stands on a stone wall under its cap, and ends
            // against a stone one.
            2: (through: Some(false), end: Some(None)),
            // Wattle and daub ends against it, on its sole plate over a ground floor of earth.
            5: (through: Some(true)),
        },
    )),
    colours: (
        light: (0.62, 0.5, 0.38),
        dark: (0.42, 0.33, 0.25),
        roof: (0.47, 0.42, 0.37),
        chinking: (0.72, 0.62, 0.5),
    ),
)
