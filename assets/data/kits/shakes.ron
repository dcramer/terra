// A roof of split pine shakes (docs/building-kits.md, D241): a roof kind, laid on cubes by
// hand or by the hammer's "add a roof", cut to slopes and corners, and drawn as a roof from
// each cube's neighbours (crates/terra_build/src/layout/roofs.rs, roofing.rs): its ridges,
// hips and valleys where its slopes meet, eaves and verges where it stops, flashing where
// it meets a wall. The roof over log walls unless another is in hand. Sizes in metres;
// colours as they appear on screen (sRGB). What this leaves out is logs.ron's.
//
// id          the kind it lays (D181): a roof's, numbered from 2048 (D241)
// pattern     Roof
// eaves       how far its covering is carried on past its cubes' open edges, drawn only
//             (D192): down the slope at an eave, level past a verge
// timber      its rafters' timber, as logs.ron's walls are made (D200)
// roof        how it is made (crates/terra_build/src/roofing.rs):
//   rows        courses in one copy of the Covering texture, down the slope, so each
//               course shows its height over the number; phase, where a course's lower
//               edge falls on it, as a fraction down from its top
//   butt        how far each course's lower edge stands out from the one under it
//   thick       how thick the covering is over its battens
//   uneven      how much a course's butt wanders along it, as a fraction
//   tint        what the covering's colour is multiplied by
//   rafter      the rafters' section (Round poles or Hewn) and thickness
//   batten      the battens' width and thickness, one under each course
//   board       the fascia and bargeboards' depth and thickness; board_tint, what their
//               colour is multiplied by, weathered lighter than the bare planks
//   ridge       what caps ridges and hips: Boards, or a Roll of the covering; cap, how
//               wide it is either side
//   fillet      the size of the mortar fillet where the roof meets a wall above it
// textures    its materials (assets/materials): Covering its shakes, Board its battens,
//             boards and underside, Log and LogEnd its rafters' bark and sawn ends,
//             Flashing the mortar against a wall
// cost        a roof's cube goes up in four steps (D241): its frame, its battens, its
//             covering and its trims, each taking so much of each item
// dress       its masks: the shakes mossed toward the eaves, greyed toward the ridge
(
    id: 2048,
    pattern: Roof,
    eaves: 0.5,
    timber: (
        profile: Round,
        notch: Flush,
        relief: 0.015,
    ),
    roof: (
        rows: 6.0,
        phase: 0.145,
        butt: 0.03,
        thick: 0.025,
        uneven: 0.35,
        tint: (1.0, 0.97, 0.93),
        rafter: (Round, 0.14),
        batten: (0.06, 0.025),
        board: (0.22, 0.035),
        board_tint: (1.42, 1.36, 1.26),
        ridge: Boards,
        cap: 0.16,
        fillet: 0.1,
    ),
    textures: {
        Log: (path: "materials/pine_bark", metres: (1.0, 1.0)),
        LogEnd: (path: "materials/log_end", metres: (1.0, 1.0)),
        Board: (path: "materials/weathered_planks", metres: (2.0, 2.0)),
        Covering: (path: "materials/shakes", metres: (3.2, 1.6)),
        Flashing: (path: "materials/white_stucco", metres: (1.0, 1.0)),
    },
    cost: (steps: 4, step: [("Wood", 1, 32)]),
    dress: (
        masks: (weather: 0.3, moss: 0.6, moss_tint: (0.62, 0.74, 0.4)),
    ),
)
