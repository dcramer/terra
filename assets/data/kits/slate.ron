// A roof of grey slates on hewn rafters (docs/building-kits.md, D241, D258), a saddle-backed
// stone ridge and bargeboards, its pieces from art/kits/slate: a roof kind, as shakes.ron says
// what each number is. The roof over stone walls unless another is in hand.
(
    id: 2049,
    pattern: Roof,
    eaves: 0.4,
    timber: (
        profile: Hewn,
        notch: Flush,
        relief: 0.0,
        tint: (0.9, 0.84, 0.76),
        end_tint: (0.86, 0.82, 0.78),
    ),
    roof: (
        rows: 11.0,
        phase: 0.0,
        thick: 0.025,
        relief: 0.02,
        tint: (0.6, 0.62, 0.66),
        rafter: 0.13,
        batten: (0.05, 0.025),
        parts: {
            Ridge: (module: "ridge", material: Piece),
            Hip: (module: "ridge", material: Piece),
            Valley: (module: "valley", material: Piece),
            Eave: (module: "eave", material: Piece, tint: (0.72, 0.68, 0.64)),
            Verge: (module: "verge", material: Piece, tint: (0.72, 0.68, 0.64)),
            Flashing: (module: "flashing", material: Piece, tint: (0.62, 0.6, 0.58)),
            Rafter: (module: "rafter", material: Log, ends: Some(LogEnd), tint: (0.9, 0.84, 0.76)),
            Batten: (module: "batten", material: Board, tint: (0.9, 0.9, 0.9)),
        },
    ),
    textures: {
        Log: (path: "materials/rough_wood", metres: (0.5, 0.5)),
        LogEnd: (path: "materials/log_end", metres: (1.0, 1.0)),
        Board: (path: "materials/weathered_planks", metres: (2.0, 2.0)),
        Piece: (path: "materials/slate_pieces", metres: (1.0, 1.0)),
        Covering: (path: "materials/grey_roof_tiles_02", metres: (1.5, 1.5)),
        Flashing: (path: "materials/white_stucco", metres: (1.0, 1.0)),
    },
    cost: (steps: 4, step: [("Stone", 1, 32), ("Wood", 1, 64)]),
    dress: (
        pieces: Some("data/kits/pieces/slate.ron"),
        masks: (wear: 0.14, moss: 0.5, moss_tint: (1.2, 1.18, 0.9)),
    ),
)
