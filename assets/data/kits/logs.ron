// A log wall's kit (docs/building-kits.md, D178, D200): pine logs in their bark, saddle
// notched, with daub between the courses. Every log is made from these numbers and its own
// seed (crates/terra_build/src/timber.rs), so no two are alike. The game reads it again
// when it is saved, so the look can be tuned while it runs. Sizes are in metres; colours
// as they appear on screen (sRGB).
//
// id          the kind of construction it lays, the number its cubes carry (D181)
// diameter    how thick a log is, in a wall a cube thick (D175, D181)
// course      how far apart the courses are; it must divide the 3 m storey
// overhang    how far a log runs past its corner cube, sawn a little short or long:
//             up to an eighth of a cube, drawn only (D192)
// longest     the longest wall one log spans, as long as a tree gives (D174)
// ragged      how far short of the others' a saddle-notched corner log's end may stop
// chinking    whether there is daub between the courses
// frame       how wide the boards round an opening are
// eaves       how far a roof over these walls overhangs them (D175)
// timber      how each log is made (D200):
//   profile     Round, a log in its bark; or Hewn, a beam squared by the axe
//   notch       Saddle, ends stacked at corners a little ragged; or Flush, sawn square
//   sides       points round a log's section; step, metres between its rings
//   taper       how much thicker its butt is than its middle, as a fraction
//   bend        how far it bows from straight, at most
//   uneven      how uneven its section is; swell, how much it swells along it
//   relief      how far the bark stands out, by the Log material's height map
//   daub        the daub under it: how far out its face is, as a fraction of the log's
//               radius, and how tall it is
//   tint        what its face's colour is multiplied by; end_tint, its sawn ends'
//   variation   how much each log differs by its seed: thickness (either way, as a
//               fraction), shade (how much darker at most), warmth (redder or cooler)
// roof        how a roof over these walls is made (crates/terra_build/src/roofing.rs):
//   rows        courses in one copy of the Covering texture, down the slope, so each
//               course shows its height over the number; phase, where a course's lower
//               edge falls on it, as a fraction down from its top
//   butt        how far each course's lower edge stands out from the one under it
//   thick       how thick the covering is over its battens
//   uneven      how much a course's butt wanders along it, as a fraction
//   tint        what the covering's colour is multiplied by
//   rafter      the rafters' section (Round poles or Hewn) and thickness
//   batten      the battens' width and thickness, one under each course
//   board       the fascia and bargeboards' depth and thickness
//   ridge       what caps ridges and hips: Boards, or a Roll of the covering; cap, how
//               wide it is either side
//   fillet      the size of the mortar fillet where the roof meets a wall above it
// models      the props set into it, from tools/props (D177): a door and a window
// textures    each material's textures (D14; assets/materials): where, how many metres
//             one copy covers, and how deep its parallax reads. Log is the bark, LogEnd
//             the sawn end's grain, Daub what fills the groove between courses, Board
//             trims and a roof's boards, Covering a roof's shakes, Flashing its mortar,
//             Floor a deck's boards, each drawn from one of the planks side by side across
//             its texture (strips: the first's edge and how far apart, as fractions of it)
// colours     plain colours: floors, flat roofs and their sides until they have kits
//             of their own, and the daub's tint
// cost        what building it takes (D139): a cube fills in so many steps, each taking
//             so much of each item, in fractions (item, numerator, denominator), so
//             a log of Wood a sixteenth a step goes in two courses; and each stage of a
//             roof cell over these walls
// dress       each exposed edge dressed by its role (D215): a hewn plate along every
//             wall's top, a hewn sill on what it stands on, hewn posts up every opening's
//             sides, a log along every step's nose, a log up every post (D193); and the
//             dirt rising from the ground and the upper logs weathered grey
(
    id: 1,
    diameter: 0.3,
    course: 0.25,
    overhang: 0.06,
    longest: 4.0,
    ragged: 0.04,
    chinking: true,
    frame: 0.08,
    eaves: 0.5,
    timber: (
        profile: Round,
        notch: Saddle,
        sides: 18,
        step: 0.08,
        taper: 0.07,
        bend: 0.03,
        uneven: 0.035,
        swell: 0.02,
        relief: 0.022,
        daub: (0.7, 0.05),
        tint: (1.0, 0.95, 0.89),
        end_tint: (0.86, 0.82, 0.78),
        variation: (thickness: 0.06, shade: 0.16, warmth: 0.05),
    ),
    roof: (
        rows: 6.0,
        phase: 0.145,
        butt: 0.03,
        thick: 0.025,
        uneven: 0.35,
        tint: (1.0, 0.97, 0.93),
        rafter: (Round, 0.14),
        batten: (0.06, 0.025),
        board: (0.22, 0.035),
        ridge: Boards,
        cap: 0.16,
        fillet: 0.1,
    ),
    models: (
        door: Some("models/kits/Door.glb"),
        window: Some("models/kits/Window.glb"),
    ),
    textures: {
        Log: (path: "materials/pine_bark", metres: (1.0, 1.0)),
        LogEnd: (path: "materials/log_end", metres: (1.0, 1.0)),
        Daub: (path: "materials/white_stucco", metres: (1.0, 1.0)),
        Board: (path: "materials/weathered_planks", metres: (2.0, 2.0)),
        Covering: (path: "materials/shakes", metres: (3.2, 1.6)),
        Flashing: (path: "materials/white_stucco", metres: (1.0, 1.0)),
        Floor: (path: "materials/weathered_planks", metres: (2.0, 2.0), strips: Some((0.0605, 0.1111))),
        Hewn: (path: "materials/rough_wood", metres: (0.6, 0.6)),
    },
    cost: (steps: 2, step: [("Wood", 1, 16)], roof: [("Wood", 1, 32)]),
    dress: (
        roles: {
            Crest: Member(profile: Hewn, scale: 1.12, material: Hewn),
            Foot: Member(profile: Hewn, scale: 1.2, material: Hewn),
            Jamb: Member(profile: Hewn, scale: 0.6, material: Hewn),
            Nose: Member(profile: Round, scale: 1.1, material: Log),
            Post: Member(profile: Round, scale: 0.9, material: Log),
        },
        masks: (dirt: 0.9, dirt_tint: (0.6, 0.54, 0.46), weather: 0.3),
    ),
    colours: (
        light: (0.74, 0.56, 0.37),     // WoodLight: floors
        dark: (0.5, 0.34, 0.22),       // a floor's sides
        roof: (0.47, 0.42, 0.37),      // a flat roof
        chinking: (0.8, 0.75, 0.66),   // the lime daub's tint
    ),
)
