// A log wall's kit (docs/building-kits.md, D177, D178): pine logs, peeled, with daub between the
// courses. The game reads it again when it is saved, so the look can be tuned while it
// runs. Sizes are in metres; colours as they appear on screen (sRGB), from the palette's
// wood roles where they have one (tools/characters/look.py).
//
// id          the kind of construction it lays, the number its cubes carry (D181)
// diameter    how thick a log is, in a wall a cube thick (D175, D181)
// course      how far apart the courses are; it must divide the 3 m storey
// overhang    how far a log runs past its corner cube; none, so it stays in the grid
// longest     the longest wall one log spans, as long as a tree gives (D174)
// facets      how many sides a log's section has, from the first to the second
// taper       how much thicker one end is than the middle, as a fraction
// bend        how far a log bows from straight, at most
// roughness   how uneven a log's section is, as a fraction of its radius
// knots       knots for every metre of log, on average
// ragged      how far short of the others' a corner log's end may stop
// chinking    whether there is daub between the courses
// frame       how wide the boards round an opening are
// eaves       how far a roof over these walls overhangs them (D175)
// models      the props set into it, from tools/props (D177): a door and a window
// textures    each material's textures (D14; assets/materials): where, how many metres
//             one copy covers, and how deep its parallax reads
// cost        what building it takes (D139): a cube fills in so many steps, each taking
//             so much of each item, in fractions (item, numerator, denominator), so
//             a log of Wood a sixteenth a step goes in two courses; and each stage of a
//             roof cell over these walls
(
    id: 1,
    diameter: 0.3,
    course: 0.25,
    overhang: 0.0,
    longest: 4.0,
    facets: (9, 11),
    taper: 0.07,
    bend: 0.035,
    roughness: 0.07,
    knots: 0.5,
    ragged: 0.04,
    chinking: true,
    frame: 0.08,
    eaves: 0.5,
    models: (
        door: Some("models/kits/Door.glb"),
        window: Some("models/kits/Window.glb"),
    ),
    textures: {
        Log: (path: "materials/rough_wood", metres: (0.5, 0.5)),
        LogEnd: (path: "materials/log_end", metres: (1.0, 1.0)),
        Daub: (path: "materials/clay_plaster", metres: (2.0, 2.0)),
        Board: (path: "materials/weathered_planks", metres: (2.0, 2.0)),
        Shakes: (path: "materials/shakes", metres: (3.2, 1.6), depth: 0.04),
        Stone: (path: "materials/rustic_stone_wall", metres: (1.52, 1.52), depth: 0.03),
        Floor: (path: "materials/old_wood_floor", metres: (3.0, 3.0)),
    },
    cost: (steps: 2, step: [("Wood", 1, 16)], roof: [("Wood", 1, 32)]),
    colours: (
        wood: (0.62, 0.43, 0.26),
        light: (0.74, 0.56, 0.37),   // WoodLight
        dark: (0.5, 0.34, 0.22),
        bark: (0.37, 0.26, 0.19),    // WoodDark
        end: (0.8, 0.64, 0.44),
        heart: (0.66, 0.47, 0.3),
        knot: (0.33, 0.22, 0.15),
        chinking: (0.66, 0.6, 0.5),
        board: (0.45, 0.32, 0.22),   // boards round openings, and behind a gable
        roof: (0.47, 0.42, 0.37),    // the roof, until roofs have kits of their own
    ),
)
