// A stone wall's kit (docs/building-kits.md, D179, D197): rough fieldstone, a cube thick,
// drawn not as models but as its cubes' own surface, its outside edges rounded and its
// face displaced by the stone's height, so a wall of any shape is one wall with no seams
// (crates/terra_build/src/surface.rs). Where it meets logs it runs through, and the logs
// end flush against it. Its gables are stone up to the roof, under slate unless another
// roof is in hand. What this leaves out is the log kit's.
//
// id          the kind of construction it lays, the number its cubes carry (D181)
// pattern     how its walls are laid: Masonry, as its cubes' surface
// roof_kind   the roof over these walls, as logs.ron says: slate
// bevel       the radius its outside edges are rounded to
// relief      how far its stone stands out, from the deepest joint to the proudest stone
// timber      its lintels' timber, as logs.ron says
// textures    its stone (assets/materials, CC0): its walls' and footings' fieldstone, its
//             floors' and its walls' tops' flagstones, the Dressed stone round its openings
//             and over its tops; its lintels' wood
// cost        what building it takes (D139): a cube in one step, a quarter of a Stone
//             each
// dress       each exposed edge dressed by its role (D215): its pieces, made by
//             tools/kits/pieces.py from art/kits/stone; a coping on every top, a plinth
//             along every foot stepping with the ground, quoins up every outside corner, a
//             lintel, sill and jamb stones round every opening, a cap under a thinner wall
//             standing on it, a fascia under an overhang, a tread on every step and a border
//             round a floor; posts as pillars 36 cm square, a drum a cube, their base and cap
//             dressed as a foot and a top are (D193); and the dirt rising from the ground,
//             and its corners worn
// meets       as logs.ron says (D232): heavier than timber, so it runs through a joint with
//             it, quoined up its end, and caps its top where timber stands on it
(
    id: 2,
    pattern: Masonry,
    roof_kind: Some(2049),
    bevel: 0.04,
    relief: 0.05,
    timber: (
        profile: Hewn,
        notch: Flush,
        relief: 0.0,
        tint: (0.9, 0.84, 0.76),
        end_tint: (0.86, 0.82, 0.78),
    ),
    textures: {
        Masonry: (path: "materials/stone_wall", metres: (2.0, 2.0)),
        Dressed: (path: "materials/rock_boulder_dry", metres: (1.4, 1.4)),
        Floor: (path: "materials/grey_stone_path", metres: (1.8, 1.8)),
        Log: (path: "materials/rough_wood", metres: (0.5, 0.5)),
        LogEnd: (path: "materials/log_end", metres: (1.0, 1.0)),
    },
    cost: (steps: 1, step: [("Stone", 1, 4)]),
    dress: (
        pieces: Some("data/kits/pieces/stone.ron"),
        roles: {
            Crest: Profile(name: "coping"),
            Nose: Profile(name: "nose"),
            Sill: Profile(name: "sill", extend: 0.06),
            Head: Profile(name: "lintel", extend: 0.2, joints: false),
            Soffit: Profile(name: "fascia"),
            Foot: Profile(name: "plinth"),
            Meet: Profile(name: "cap"),
            Border: Profile(name: "border"),
            Arris: Corners(set: "quoin"),
            Jamb: Corners(set: "jamb"),
            Post: Pillar(width: 0.36),
        },
        tint: (0.93, 0.91, 0.88),
        masks: (dirt: 0.6, dirt_tint: (0.6, 0.56, 0.48), wear: 0.14),
    ),
    meets: Some((weight: 3, end: None, carries: Cap)),
    colours: (
        light: (0.62, 0.6, 0.56),
        dark: (0.4, 0.38, 0.35),
        roof: (0.47, 0.42, 0.37),
        chinking: (0.72, 0.68, 0.6),
    ),
)
