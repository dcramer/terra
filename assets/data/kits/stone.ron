// A stone wall's kit (docs/building-kits.md, D179, D197): rough fieldstone, a cube thick,
// drawn not as models but as its cubes' own surface, its outside edges rounded and its
// face displaced by the stone's height, so a wall of any shape is one wall with no seams
// (crates/terra_build/src/surface.rs). Where it meets logs it runs through, and the logs
// end flush against it. What this leaves out is the log kit's, which a masonry kit does
// not use.
//
// id          the kind of construction it lays, the number its cubes carry (D181)
// pattern     how its walls are laid: Masonry, as its cubes' surface
// eaves       how far a roof over these walls overhangs them (D175)
// bevel       the radius its outside edges are rounded to
// relief      how far its stone stands out, from the deepest joint to the proudest stone
// textures    its stone (assets/materials, CC0), and the roof over it as the log kit's
(
    id: 2,
    pattern: Masonry,
    eaves: 0.5,
    bevel: 0.04,
    relief: 0.05,
    textures: {
        Masonry: (path: "materials/stone_wall", metres: (2.0, 2.0)),
        Board: (path: "materials/weathered_planks", metres: (2.0, 2.0)),
        Shakes: (path: "materials/shakes", metres: (3.2, 1.6), depth: 0.04),
    },
    colours: (
        wood: (0.55, 0.53, 0.5),
        light: (0.62, 0.6, 0.56),
        dark: (0.4, 0.38, 0.35),
        bark: (0.37, 0.26, 0.19),
        end: (0.8, 0.64, 0.44),
        heart: (0.66, 0.47, 0.3),
        knot: (0.33, 0.22, 0.15),
        chinking: (0.72, 0.68, 0.6),
        board: (0.45, 0.32, 0.22),
        roof: (0.47, 0.42, 0.37),
    ),
)
