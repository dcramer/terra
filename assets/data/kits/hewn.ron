// A hewn-timber wall's kit (docs/building-kits.md, D178, D200): beams squared by the axe,
// dovetailed flush at the corners, with a band of lime daub between the courses, under a
// thatched roof on round poles. The same code as the log kit's round logs, another profile
// (crates/terra_build/src/timber.rs): a kind of timber is a file, not code (D136). What
// this leaves out is the log kit's; logs.ron says what each number is.
// Dressed by role (D215) with a heavier plate and sill, posts up its openings and squared
// posts at its corners, as framed squared-log buildings are.
(
    id: 3,
    diameter: 0.3,
    course: 0.25,
    overhang: 0.0,
    longest: 4.0,
    ragged: 0.0,
    chinking: true,
    frame: 0.08,
    eaves: 0.5,
    timber: (
        profile: Hewn,
        notch: Flush,
        sides: 18,
        step: 0.08,
        taper: 0.02,
        bend: 0.02,
        uneven: 0.02,
        swell: 0.01,
        relief: 0.0,
        daub: (0.8, 0.06),
        tint: (1.0, 0.86, 0.7),
        end_tint: (0.9, 0.8, 0.7),
        variation: (thickness: 0.05, shade: 0.14, warmth: 0.06),
    ),
    roof: (
        rows: 4.0,
        phase: 0.0,
        butt: 0.05,
        thick: 0.22,
        uneven: 0.45,
        tint: (1.0, 0.92, 0.8),
        rafter: (Round, 0.12),
        batten: (0.05, 0.03),
        board: (0.2, 0.04),
        ridge: Roll,
        cap: 0.3,
        fillet: 0.12,
    ),
    models: (
        door: Some("models/kits/Door.glb"),
        window: Some("models/kits/Window.glb"),
    ),
    textures: {
        Log: (path: "materials/rough_wood", metres: (0.6, 0.6)),
        LogEnd: (path: "materials/log_end", metres: (1.0, 1.0)),
        Daub: (path: "materials/white_stucco", metres: (1.0, 1.0)),
        Board: (path: "materials/weathered_planks", metres: (2.0, 2.0)),
        Covering: (path: "materials/riet_01", metres: (2.5, 2.5)),
        Flashing: (path: "materials/white_stucco", metres: (1.0, 1.0)),
        Floor: (path: "materials/weathered_planks", metres: (2.0, 2.0), strips: Some((0.0605, 0.1111))),
        Hewn: (path: "materials/rough_wood", metres: (0.5, 0.5)),
    },
    cost: (steps: 2, step: [("Wood", 1, 16)], roof: [("Fibre", 1, 32)]),
    dress: (
        roles: {
            Crest: Member(profile: Hewn, scale: 1.15, material: Hewn),
            Foot: Member(profile: Hewn, scale: 1.2, material: Hewn),
            Jamb: Member(profile: Hewn, scale: 0.6, material: Hewn),
            Arris: Member(profile: Hewn, scale: 0.6, material: Hewn),
            Nose: Member(profile: Hewn, scale: 1.0, material: Hewn),
            Post: Member(profile: Hewn, scale: 0.85, material: Hewn),
        },
        masks: (dirt: 0.9, dirt_tint: (0.6, 0.54, 0.46), weather: 0.25, moss: 0.5, moss_tint: (0.66, 0.7, 0.46)),
    ),
    colours: (
        light: (0.74, 0.56, 0.37),
        dark: (0.5, 0.34, 0.22),
        roof: (0.47, 0.42, 0.37),
        chinking: (0.84, 0.8, 0.72),
    ),
)
