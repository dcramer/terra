#![enable(implicit_some)]
// Every kind of thing that grows or lies about the ground (D39, D127, D136): trees, rocks,
// bushes, plants and flowers. A new kind is an entry here, with its models in
// assets/models/nature or how it is grown; no code names one. Where things grow is worked
// out layer by layer (crates/terra_world/src/flora.rs); each layer chooses among the kinds
// that grow in it.
//
// Each kind:
//   name     what it is called
//   models   the models it is drawn from, in assets/models/nature, for one that is modelled
//   grown    how it is grown, for one that is (D222, crates/terra_world/src/grown):
//            Tree: its habit (Spreading as an oak, Conical as a pine, Upright as a birch),
//              its bark (a material in assets/materials) and how many metres its picture
//              covers, its leaves (a card in assets/data/foliage.ron) and their tint, how
//              big a spray of them is, and its trunk's radius against its height;
//            Bush: its leaf card and tint, how many clumps of cards, its width against its
//              height;
//            Rosette, a herb or fern: its card and tint, how many leaves, how steeply they
//              rise (degrees), and where the leaf's stalk and tip are in the card's picture;
//            Tuft, a flower: its cards, a variant to each in turn, their tint, and how many
//              cross at its foot
//   variants how many different ones of a grown kind there are (4 if not given)
//   colours  our colour for each material its models name, whether that part is foliage,
//            which catches the wind, or Firm, and the real material it is drawn in, if any,
//            a layer of assets/materials/flora (pine_bark, bark_brown_02, leaves, mossy_rock,
//            lichen_rock, rock_boulder_dry), its own colour swapped for ours; * is any material. Materials not
//            named here take the shared colours below.
//   sway     how it moves in the wind: Tree, Bush, Plant or Still
//   grows    the layer it grows in: Trees, Rocks, Bushes, Plants or Flowers, or
//            ByTheDoor(east, south, height) for one placed by the base's door
//   size     its height, in metres, from and to; a rock's comes from its layer
//   below, above, grass_above, size_above, chance
//            when its layer chooses it: the layer tries its kinds in the order here and
//            takes the first whose noise is below or above so much, whose ground is grassier
//            than so much, whose size is over so much, and that wins a roll of chance; the
//            last of a layer, with none of these, is what grows otherwise
//   cut      what cutting it takes and gives: the sort of thing it is (as items.ron's
//            tools cut), the item it gives as so many plus so many more a metre of its
//            size, rounded, the seconds it takes likewise, and the size from which it is
//            cut as a greater sort, such as a great tree that only iron fells (D96)
(
    shared_colours: [
        ("Wood", (0.36, 0.28, 0.22), Firm, "bark_brown_02"),
        ("LightWood", (0.78, 0.62, 0.44), Firm),
        ("Mushroom_Top", (0.84, 0.32, 0.22), Firm),
        ("Mushroom_Bottom", (0.93, 0.88, 0.78), Firm),
        ("DarkGreen", (0.25, 0.36, 0.18), Foliage, "leaves"),
        ("Leaves", (0.34, 0.45, 0.22), Foliage, "leaves"),
        ("*", (0.4, 0.56, 0.24), Foliage),
    ],
    kinds: [
        (
            name: "Pine",
            grown: Tree((
                habit: Conical,
                bark: "pine_bark",
                bark_m: 2.0,
                leaves: "pine",
                tint: (1.2, 1.25, 1.15),
                clump_m: 2.4,
                trunk: 0.022,
            )),
            variants: 6,
            sway: Tree,
            grows: Trees,
            below: -0.06,
            size: (16.0, 27.0),
            cut: (what: Tree, gives: ("Wood", 0.0, 0.18), seconds: (1.0, 0.065), greater: (22.0, GreatTree)),
        ),
        (
            name: "Birch",
            grown: Tree((
                habit: Upright,
                bark: "birch_bark",
                bark_m: 1.0,
                leaves: "birch",
                clump_m: 1.6,
                trunk: 0.017,
            )),
            variants: 4,
            sway: Tree,
            grows: Trees,
            above: 0.1,
            size: (13.0, 20.0),
            cut: (what: Tree, gives: ("Wood", 0.0, 0.18), seconds: (1.0, 0.065), greater: (22.0, GreatTree)),
        ),
        (
            name: "Leafy tree",
            grown: Tree((
                habit: Spreading,
                bark: "bark_brown_02",
                bark_m: 1.0,
                leaves: "oak",
                clump_m: 2.6,
                trunk: 0.034,
            )),
            variants: 6,
            sway: Tree,
            grows: Trees,
            size: (11.0, 19.0),
            cut: (what: Tree, gives: ("Wood", 0.0, 0.18), seconds: (1.0, 0.065), greater: (22.0, GreatTree)),
        ),

        // Rock with ore in it: the same shapes, in a colour that gives it away.
        (
            name: "Ore rock",
            models: ["Rock_1", "Rock_3", "Rock_4", "Rock_5", "Rock_7", "Rock_9"],
            colours: [("*", (0.5, 0.36, 0.3), Firm, "lichen_rock")],
            sway: Still,
            grows: Rocks,
            size_above: 0.7,
            chance: 0.18,
            cut: (what: Ore, gives: ("Ore", 0.5, 1.0), seconds: (1.2, 0.6)),
        ),
        (
            name: "Mossy rock",
            models: ["Rock_Moss_1", "Rock_Moss_2", "Rock_Moss_3", "Rock_Moss_4", "Rock_Moss_5"],
            colours: [("*", (0.38, 0.39, 0.31), Firm, "mossy_rock")],
            sway: Still,
            grows: Rocks,
            grass_above: 0.6,
            chance: 0.6,
            cut: (what: Rock, gives: ("Stone", 0.5, 1.5), seconds: (0.8, 0.5)),
        ),
        (
            name: "Rock",
            models: ["Rock_1", "Rock_2", "Rock_3", "Rock_4", "Rock_5", "Rock_6", "Rock_7", "Rock_8", "Rock_9", "Rock_10"],
            colours: [("*", (0.4, 0.37, 0.33), Firm, "rock_boulder_dry")],
            sway: Still,
            grows: Rocks,
            cut: (what: Rock, gives: ("Stone", 0.5, 1.5), seconds: (0.8, 0.5)),
        ),

        // The first food to be found.
        (
            name: "Berry bush",
            grown: Bush((leaves: "berry", clumps: (7, 10), spread: 1.1)),
            variants: 3,
            sway: Bush,
            grows: Bushes,
            chance: 0.33,
            size: (0.7, 1.5),
            cut: (what: Plant, gives: ("Berries", 3.0, 0.0), seconds: (0.7, 0.0)),
        ),
        (
            name: "Bush",
            grown: Bush((leaves: "hazel", tint: (0.72, 0.8, 0.66), clumps: (7, 11), spread: 1.25)),
            variants: 4,
            sway: Bush,
            grows: Bushes,
            size: (0.7, 1.5),
            cut: (what: Plant, gives: ("Fibre", 1.0, 0.0), seconds: (0.7, 0.0)),
        ),
        // Dwarf birch and bilberry on the heath past the trees, knee-high and lower, turning
        // crimson and rust in early autumn as the dwarf birch's year says (plant_years.ron).
        (
            name: "Dwarf shrub",
            grown: Bush((leaves: "berry", tint: (0.85, 0.82, 0.72), clumps: (5, 8), spread: 1.7)),
            variants: 4,
            sway: Bush,
            grows: Heath,
            size: (0.18, 0.45),
            cut: (what: Plant, gives: ("Fibre", 0.5, 0.0), seconds: (0.5, 0.0)),
        ),
        (
            name: "Fern",
            grown: Rosette((card: "fern", leaves: (7, 11), tilt: (25.0, 55.0), stalk: (0.03, 0.97), tip: (0.97, 0.03))),
            sway: Plant,
            grows: Plants,
            chance: 0.55,
            size: (0.4, 0.8),
            cut: (what: Plant, gives: ("Fibre", 1.0, 0.0), seconds: (0.4, 0.0)),
        ),
        (
            name: "Plant",
            grown: Rosette((card: "herb", leaves: (4, 6), tilt: (15.0, 40.0), stalk: (0.5, 0.97), tip: (0.5, 0.05))),
            sway: Plant,
            grows: Plants,
            size: (0.3, 0.55),
            cut: (what: Plant, gives: ("Fibre", 1.0, 0.0), seconds: (0.4, 0.0)),
        ),
        (
            name: "Flower",
            grown: Tuft((cards: ["daisy", "buttercup", "campion"], planes: 2)),
            variants: 6,
            sway: Plant,
            grows: Flowers,
            size: (0.4, 0.62),
        ),

        // A stump and a mossy log by the door, as if the clearing had been cut.
        (
            name: "Stump",
            models: ["TreeStump"],
            sway: Still,
            grows: ByTheDoor(1.0, 11.0, 0.7),
            cut: (what: Tree, gives: ("Wood", 2.0, 0.0), seconds: (1.0, 0.0)),
        ),
        (
            name: "Log",
            models: ["WoodLog_Moss"],
            sway: Still,
            grows: ByTheDoor(-2.5, 12.5, 0.9),
            cut: (what: Tree, gives: ("Wood", 2.0, 0.0), seconds: (1.0, 0.0)),
        ),
    ],
)
