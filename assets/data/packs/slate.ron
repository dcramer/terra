// Slate's reference pack (D241, D258, D290): Poly Haven's `grey_roof_tiles_02` (CC0), eleven
// courses a copy laid 2.4 m across, so its slates are a real slate's size, a course 22 cm
// and a slate about 28 cm wide, each butt standing 3 cm proud; 2.5 cm thick; its own modelled ridge tiles, valley, fascia, bargeboard and
// flashing (art/kits/slate); hewn oak rafters; pale lichen toward the eaves.
(
    eaves: 0.4,
    roof: (
        rows: 11.0,
        phase: 0.005,
        thick: 0.025,
        relief: 0.032,
        tint: (0.6, 0.64, 0.72),
        rafter: 0.13,
        batten: (0.05, 0.025),
        parts: {
            Rafter: (tint: (0.9, 0.84, 0.76)),
            Ridge: (tint: (0.62, 0.64, 0.7)),
            Hip: (tint: (0.62, 0.64, 0.7)),
        },
    ),
    textures: {
        Covering: (path: "materials/grey_roof_tiles_02", metres: (2.4, 2.4)),
        Piece: (path: "materials/slate_pieces", metres: (1.0, 1.0)),
        Log: (path: "materials/rough_wood", metres: (0.5, 0.5)),
    },
    details: {
        Covering: (path: "materials/detail_stone", metres: 0.5, strength: 0.8),
        Log: (path: "materials/detail_wood", metres: 0.4, strength: 0.8),
    },
    dress: (
        own: Some("data/kits/pieces/slate.ron"),
        masks: (wear: 0.14, moss: 0.3, moss_tint: (1.15, 1.15, 1.0)),
    ),
)
