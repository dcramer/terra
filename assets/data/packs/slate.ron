// Slate's reference pack (D241, D258, D290): Poly Haven's `grey_roof_tiles_02` (CC0), eleven
// courses a copy, 2.5 cm thick; its own modelled ridge tiles, valley, fascia, bargeboard and
// flashing (art/kits/slate); hewn oak rafters; pale lichen toward the eaves.
(
    eaves: 0.4,
    timber: (
        profile: Hewn,
        relief: 0.0,
        tint: (0.9, 0.84, 0.76),
        end_tint: (0.86, 0.82, 0.78),
    ),
    roof: (
        rows: 11.0,
        phase: 0.0,
        thick: 0.025,
        relief: 0.02,
        tint: (0.6, 0.62, 0.66),
        rafter: 0.13,
        batten: (0.05, 0.025),
        parts: { Rafter: (tint: (0.9, 0.84, 0.76)) },
    ),
    textures: {
        Covering: (path: "materials/grey_roof_tiles_02", metres: (1.5, 1.5)),
        Piece: (path: "materials/slate_pieces", metres: (1.0, 1.0)),
        Log: (path: "materials/rough_wood", metres: (0.5, 0.5)),
    },
    dress: (
        pieces: Some("data/kits/pieces/slate.ron"),
        masks: (wear: 0.14, moss: 0.5, moss_tint: (1.2, 1.18, 0.9)),
    ),
)
