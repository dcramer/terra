// Packed earth's reference pack (D236, D290): cob or rammed earth, ambientCG's `Ground104`
// (CC0, as `packed_earth`), its yellow taken to a grey-brown, packed by hand in its shape
// (`packed`: lumps and each lift rounded out between its seams), weathered by where it
// stands (its masks). Its own trims, an override of the block pattern's: a rubble plinth
// and a stone coping with a drip from its own pieces (art/kits/earth), and oak lintels,
// sills, sole plates, fascias and treads, each run whole across an opening.
(
    bevel: 0.12,
    // Packed earth crumbles when it comes down (D305).
    toughness: (breaks: Crumbs),
    relief: 0.07,
    tint: (0.98, 0.95, 1.08),
    packed: Some((lumps: 0.05, lump: 0.6, ridge: 0.035, step: 0.03)),
    timber: (
        tint: (0.82, 0.7, 0.58),
        end_tint: (0.86, 0.8, 0.72),
        variation: (thickness: 0.04, shade: 0.12, warmth: 0.05),
    ),
    textures: {
        Masonry: (path: "materials/packed_earth", metres: (2.6, 2.6), depth: 0.016),
        Floor: (path: "materials/clay_floor_001", metres: (2.0, 2.0)),
        Hewn: (path: "materials/rough_wood", metres: (0.5, 0.5)),
        Board: (path: "materials/weathered_planks", metres: (2.0, 2.0)),
    },
    dress: (
        own: Some("data/kits/pieces/earth.ron"),
        roles: {
            Foot: Profile(name: "plinth", joints: false),
            Head: Profile(name: "lintel", extend: 0.12, joints: false, material: Some(Hewn)),
            Sill: Profile(name: "sill", extend: 0.08, joints: false, material: Some(Hewn)),
            Meet: Profile(name: "cap", joints: false, material: Some(Hewn)),
            Soffit: Profile(name: "fascia", joints: false, material: Some(Hewn)),
            Nose: Profile(name: "nose", joints: false, material: Some(Hewn)),
            Post: Pillar(width: 0.4),
            Arris: None,
            Jamb: None,
        },
        tint: (0.95, 0.9, 0.84),
        masks: (
            dirt: 0.9,
            dirt_tint: (0.6, 0.56, 0.53),
            wear: 0.3,
            moss: 0.5,
            moss_tint: (0.7, 0.72, 0.5),
            strata: 0.08,
            lift: 0.42,
            dry: 0.3,
            dry_reach: 1.2,
            splash: 0.6,
            streaks: 0.6,
            streak_reach: 1.4,
        ),
    ),
    colours: (light: (0.62, 0.5, 0.38), dark: (0.42, 0.33, 0.25), chinking: (0.72, 0.62, 0.5)),
)
