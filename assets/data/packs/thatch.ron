// Thatch's reference pack (D241, D258, D290): water reed, Poly Haven's `riet_01` (CC0), four
// courses a copy, 26 cm thick; its own modelled sedge ridge, bound verge bundle and cut eave
// (art/kits/thatch), and a valley and ridge of the reed itself; round pole rafters.
(
    timber: (
        relief: 0.0,
        tint: (1.0, 0.86, 0.7),
        end_tint: (0.9, 0.8, 0.7),
    ),
    roof: (
        rows: 4.0,
        phase: 0.0,
        thick: 0.26,
        relief: 0.05,
        tint: (1.0, 0.92, 0.8),
        rafter: 0.12,
        batten: (0.05, 0.03),
        parts: {
            Ridge: (material: Covering, tint: (0.86, 0.8, 0.66)),
            Hip: (material: Covering, tint: (0.86, 0.8, 0.66)),
            Valley: (material: Covering, tint: (1.0, 0.92, 0.8)),
            Verge: (material: Covering, tint: (0.96, 0.88, 0.76)),
            Eave: (material: Covering, on_roof: true, tint: (1.0, 1.0, 1.0)),
            Flashing: (material: Flashing, tint: (1.0, 1.0, 1.0)),
            Rafter: (tint: (1.0, 0.86, 0.7)),
        },
    ),
    textures: {
        Covering: (path: "materials/riet_01", metres: (2.5, 2.5)),
        Piece: (path: "materials/thatch_pieces", metres: (1.0, 1.0)),
        Log: (path: "materials/rough_wood", metres: (0.6, 0.6)),
    },
    dress: (
        pieces: Some("data/kits/pieces/thatch.ron"),
        masks: (weather: 0.25, moss: 0.5, moss_tint: (0.66, 0.7, 0.46)),
    ),
)
