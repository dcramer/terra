// Old red brick's reference pack (D290): Poly Haven's `medieval_red_brick` (CC0), its edges
// rounded less than stone's and its relief shallower, dressed in the block pattern's stone
// warmed toward the brick; mossed a little low down.
(
    bevel: 0.02,
    relief: 0.03,
    tint: (1.0, 0.97, 0.95),
    textures: {
        Masonry: (path: "materials/medieval_red_brick", metres: (2.0, 2.0), depth: 0.015),
        Floor: (path: "materials/medieval_red_brick", metres: (2.0, 2.0)),
    },
    dress: (
        tint: (1.02, 0.98, 0.92),
        masks: (dirt: 0.55, dirt_tint: (0.5, 0.42, 0.36), wear: 0.12, moss: 0.3, moss_tint: (0.62, 0.64, 0.46)),
    ),
    colours: (light: (0.62, 0.36, 0.28), dark: (0.4, 0.22, 0.17), chinking: (0.74, 0.7, 0.62)),
)
