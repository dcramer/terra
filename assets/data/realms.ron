// Realms (D17, D642; docs/realm-two.md): what a world of a kind is, beyond its seed. A realm
// changes parts, materials and light, never the rules (docs/art-style.md). A kind with no row
// here is the first realm's: the land's own light and colours.
//   kind          the world's kind, as a save and a gate name it
//   name          what a player is told it is
//   beyond        the kind of the realm its gate leads to (D641)
//   plants_hue    how far its plants' own colours are turned round the hue circle, radians
//   grass_hue     how much further its grass and ground cover are turned, radians
//   ground        its ground's layers, a stack among the materials; the first realm's if not given
//   animals       the kinds of creature that live in it, by name; every kind if not given
//   sun, sky      its light against the first realm's: the sun's colour and the sky's (the
//                 horizon, the zenith, the shade), multiplied in, linear, red green blue
//   ground_low, ground_high, ground_steep, grass_dry, grass_lush, sand
//                 the land's colours, sRGB red green blue; left out, the land's own
//   foliage       its plants' leaves: a card atlas among the data, the first realm's cards' names
//   ground_cover  how much of the grass and sand the ground could have is shown, 0 to 1
//   plants        the share of the first realm's trees and undergrowth that grow, 0 to 1
//   parts         what stands on its land by rule, each a catalogue item's model file
//                 (data/builds.ron), how many of it a square kilometre holds, and from how
//                 many metres off it is drawn (seen_m, by its size)
//   undergrowth   its own undergrowth, in place of the first realm's: `keeps`, the first
//                 realm's kinds that still grow there, by their names on the floor, and
//                 `kinds`, its own, each a row: its models (files of models/nature/far, each
//                 with its far level <file>_far.glb, tools/props' `far`), how many clumps
//                 are tried a hectare, how many plants a clump has and how far they spread,
//                 how much of the model's size a plant has grown to, from how far it is
//                 drawn and where its far level takes over, how broad its drifts are, and
//                 how much it likes dry ground and damp hollows, 0 to 1 each
[
    (kind: "world", name: "the first realm", beyond: "industrial"),
    (
        kind: "industrial",
        name: "the far realm",
        beyond: "world",
        // Another world's day: the sun a little cold and rose, the sky deepened toward
        // violet (the developers, 2026-11-08: fantasy and science fiction, where the first
        // realm is real and medieval).
        sun: Some((1.05, 0.95, 1.1)),
        sky: Some((1.45, 1.3, 2.0)),
        // Dark violet soil and pale lilac sand under grass that is rose and plum.
        ground_low: Some((0.2, 0.17, 0.29)),
        ground_high: Some((0.24, 0.2, 0.33)),
        ground_steep: Some((0.17, 0.15, 0.24)),
        grass_dry: Some((0.56, 0.36, 0.6)),
        grass_lush: Some((0.6, 0.22, 0.5)),
        sand: Some((0.62, 0.54, 0.72)),
        ground_cover: Some(1.0),
        // Its leaves are its own: an atlas of teal and blue-green broadleaves, violet
        // needles and plum bushes (assets/data/foliage_far.ron, art/textures/cards_far).
        foliage: Some("foliage_far"),
        // And every leaf and blade is turned a fifth of the way round the hue circle: its
        // greens are teal, and the atlas's blue-violet bushes come out magenta and plum.
        plants_hue: Some(1.25),
        // Its grass is turned further, to the rose and plum its ground is past the blades
        // (the blades were teal on a magenta land): green's 100 degrees to rose's 310.
        grass_hue: Some(2.42),
        // Its own deer and hare, the first realm's bodies in coats of this one (D642), and its
        // monster, the Drillhog (D250; here for now, D650).
        animals: Some(["Glimmerhorn", "Glimmerdoe", "Moonhare", "Drillhog"]),
        // No bird of the first realm sings here: its cap forest rings.
        birdsong: Some(0.0),
        chimes: Some(0.45),
        // All the first realm's undergrowth and none of its trees: its cap trees, spires
        // and fans are its forest (the developers, 2026-11-09: "its not lush", "mostly
        // normal realm stuff").
        plants: Some(1.0),
        trees: Some(0.0),
        // Cap trees through the forest with small great fungi under them, crystal here and there, a monolith now and then,
        // and the few machines of an older making that still stand.
        parts: [
            (grown: Some("Cap tree"), tall_m: Some((9.0, 22.0)), a_km2: 2600.0, seen_m: Some(450.0)),
            (grown: Some("Frond spire"), tall_m: Some((7.0, 15.0)), a_km2: 1500.0, seen_m: Some(320.0)),
            (grown: Some("Fan tree"), tall_m: Some((5.0, 10.0)), a_km2: 1200.0, seen_m: Some(280.0)),
            (file: "FarGiantFungus", a_km2: 300.0, seen_m: Some(190.0)),
            (file: "FarCrystalSpire", a_km2: 120.0, seen_m: Some(230.0)),
            (file: "FarMonolith", a_km2: 12.0, seen_m: Some(280.0)),
            (file: "IndustrialPylon", a_km2: 5.0, seen_m: Some(420.0)),
            (file: "IndustrialSign", a_km2: 6.0, seen_m: Some(250.0)),
        ],
        // Its floor is its own (the developers, 2026-11-09: "the scifi realm shoudl be exotic
        // too", "mostly normal realm stuff"): lantern bulbs and spore pods in the damp
        // hollows, coral fans on the dry ground, coil tendrils over both, head high; of the
        // first realm's kinds only the scrub and bramble its own leaf atlas turns plum.
        undergrowth: Some((
            keeps: ["Bush", "Bramble"],
            kinds: [
                (name: "Lantern bulb", models: ["FarLanternBulb"], tries_ha: 600.0, clump: (4, 10), spread_m: 1.2,
                 grown: (0.7, 1.3), seen_m: 55.0, near_m: 14.0, drift_m: 12.0, dry: 0.4, wet: 1.0),
                (name: "Spore pods", models: ["FarSporePods"], tries_ha: 520.0, clump: (2, 6), spread_m: 1.6,
                 grown: (0.6, 1.3), seen_m: 65.0, near_m: 16.0, drift_m: 16.0, dry: 0.3, wet: 1.0),
                (name: "Coral fan", models: ["FarCoralFan"], tries_ha: 520.0, clump: (2, 7), spread_m: 1.8,
                 grown: (0.7, 1.4), seen_m: 75.0, near_m: 18.0, drift_m: 18.0, dry: 1.0, wet: 0.25),
                (name: "Coil tendril", models: ["FarCoilTendril"], tries_ha: 380.0, clump: (2, 5), spread_m: 2.0,
                 grown: (0.7, 1.35), seen_m: 90.0, near_m: 22.0, drift_m: 22.0, dry: 0.9, wet: 0.6),
            ],
        )),
    ),
]
