// A settlement built from a bare clearing into a market town in a day, as a city-builder's
// time-lapse shows one (D381, terra_folk::rising): the claim stone set at the heart of it, then
// every building of the town from the square out, each from its plan to its last trim by the
// building system's own steps, the first house alone at first and then the rest spreading
// outward ever faster; each finished house's hearth smoking, its yard, fences and torch
// there; the well, benches and stalls as the settlement reaches them. The buildings alone,
// with nobody about (`people: false`). Times are seconds after it rolls.
#![enable(implicit_some)]
(
    about: "a market town rising from its clearing in a day",
    seconds: 20.0,
    // Into dusk: the sun from about 24 degrees up, low in the west behind the camera's left,
    // to about 3 degrees under the horizon at the end, so the last seconds are the afterglow,
    // the land in the sky's light and the homes' windows lit (settlement r31, after the
    // developer: "we can try going into dusk too"); to about 2.3 degrees under since round 32,
    // whose blue-hour sky stays as bright as the land it lights (D432). The hills to the west shade the town
    // from about 17.3 h, 7 s in; the sun sets about 17 s in; the windows' glow is full from
    // a 6-degree sun, about 13 s in (town/windows.rs). Ending at 17.18 h, the sun 15 degrees
    // up, the film never reached dusk and the windows read only faintly (settlement r30).
    hours: (16.4, 18.7),
    claim: 0.0,
    first: 0.3,
    last: 11.0,
    takes: (2.0, 3.5),
    growth: 0.4,
    settled_after: 0.6,
    gather: 0.3,
    pace: 3.0,
    builders: 0,
    people: false,
    common: (5.0, 12.0),
    // Before each building's door while it goes up: a stack of logs (a bucket of tools read
    // from high as stakes stood in the grass).
    site: [
        (item: "Log", at: (1.9, 1.5)),
        (item: "Log", at: (1.9, 1.95)),
        (item: "Log", at: (1.9, 2.4)),
        (item: "Log", at: (1.9, 1.72), lift: 0.4),
        (item: "Log", at: (1.9, 2.17), lift: 0.4),
    ],
    steps_a_frame: 6000,
    // Grown big, as the camera goes far out (the developer: "settlement can be bigger since
    // we are moving far far away, you can even imagine it finishing off with like castle
    // and walls"): eighty to ninety houses along streets half as long again as a market
    // town's, then its wall, towers and gates going up from 10.5 s, the castle beside it last
    // from 12 s, finished with its scaffold struck by about 18 s.
    town: (buildings: (80, 90), streets: 1.6, walls: (10.5, 12.0)),
)
