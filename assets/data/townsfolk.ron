// How a town's people look, by role (play::townsfolk, docs/demos.md): the bodies a role is
// shaped as (templates of models/character/templates.json, each mixed with a little of
// another), and what it wears, each item's main material dyed one of a few colours. Someone's
// look is drawn from these by their seed, so a role reads at a glance by what it wears and
// no two people of it are alike: a woman's body (the `female` template) wears `women` where a
// role gives it, each garment by its `chance`, and of a `group` (a shirt or a coat) one. Colours are sRGB: undyed wool and linen, madder, woad,
// weld, walnut and oak-gall browns, as a market town's would be.
#![enable(implicit_some)]
(
    // How each kind of the town's animals is drawn (terra_life's `animals`): its model, its
    // scale, its clips, and its walk's own pace in metres a second. A kind not here is kept
    // by the town but not drawn until it has a model.
    animals: {
        "Hen": (model: "models/creatures/Chicken.glb", idle: "Idle", walk: "Walk", rest: "Peck", pace: 0.375),
        "Dog": (model: "models/creatures/Dog.glb", idle: "Idle", walk: "Walk", run: "Run", rest: "Sit", pace: 0.938),
    },
    // A body's mix: a template, and up to this much of one other template's morphs.
    mix: 0.45,
    // What is carried in the right hand for an activity, on the way to it and at it, by held
    // item (models/held/<item>.glb), so what someone is about shows from across the square.
    holds: {
        "Smith": "hammer",
        "Chop": "iron_axe",
        "Guard": "spear",
        "Browse": "basket",
    },
    roles: {
