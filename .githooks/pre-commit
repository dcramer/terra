#!/usr/bin/env bash
# Runs the gate before every commit (D37). Any `cargo xtask` task switches this on for a clone;
# `git commit --no-verify` skips it. It checks the working tree, so unstaged changes count too.
set -euo pipefail
cargo=cargo
command -v cargo >/dev/null || cargo="$HOME/.cargo/bin/cargo"
exec "$cargo" xtask check
