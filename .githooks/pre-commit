#!/usr/bin/env bash
# Runs the quick check before every commit (D37, D398): linters and fast unit tests of what the
# change touches, in a budget of a few tens of seconds it reports against: formatting, the
# code-health gates, clippy and the tests but `SLOW_TESTS` of the crates changed, the changed
# tools' tests and the docs check. The big suites run before every push (pre-push). Any
# `cargo xtask` task switches the hooks on for a clone. It reads the working tree, so unstaged
# changes count too. It prints a line a stage and, for a stage that fails, only what fixes it,
# with its log in target/check/ (D388); TERRA_VERBOSE=1 git commit streams everything. Never
# skip it with --no-verify.
set -euo pipefail
cargo=cargo
command -v cargo >/dev/null || cargo="$HOME/.cargo/bin/cargo"
exec "$cargo" xtask check --quick
