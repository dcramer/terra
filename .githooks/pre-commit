#!/usr/bin/env bash
# Runs the quick check before every commit (D37): formatting, lints, the tests but the slow
# sweeps, the kit, foliage and docs checks. The full check runs before every push (pre-push). Any `cargo xtask`
# task switches the hooks on for a clone. It checks the working tree, so unstaged changes count
# too. It prints a line a stage and, for a stage that fails, only what fixes it, with its log in
# target/check/ (D388); TERRA_VERBOSE=1 git commit streams everything. Never skip it with --no-verify.
set -euo pipefail
cargo=cargo
command -v cargo >/dev/null || cargo="$HOME/.cargo/bin/cargo"
exec "$cargo" xtask check --quick
