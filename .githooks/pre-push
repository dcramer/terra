#!/usr/bin/env bash
# Formatting and clippy of the crates changed since the merge-base with origin/main, before
# every push to origin (D37), in seconds. A push elsewhere, such as remote-render sending a job's
# commit to the render worker, is not landing and goes through unchecked (tools/git/guarded.ts).
# Tests are yours to run for what you changed; the full check, `cargo xtask check --all`, is run
# by hand (no CI while we are pre-release). It reads the working tree, and prints a line a stage
# (D388; TERRA_VERBOSE=1 streams everything). Never skip it with --no-verify. With
# TERRA_REMOTE_CHECKS=1 (.env) the same check runs on the render worker at each commit pushed,
# for a machine that must not build (tools/git/remote-check.ts). Once the checks pass, git-lfs
# uploads the LFS objects the commits point to (D525), as its own pre-push hook would.
set -euo pipefail
node tools/git/guarded.ts "$1" "$2" || exit 0
pushed=$(cat)
cargo=cargo
command -v cargo >/dev/null || cargo="$HOME/.cargo/bin/cargo"
# A warning, never a failure: a commit that silently undoes another's recent one (D431).
node tools/git/undone.ts origin/main..HEAD || true
node tools/git/lfs.ts --push <<<"$pushed"
if grep -q 'filter=lfs' .gitattributes && ! git lfs version >/dev/null 2>&1; then
  echo "✗ git-lfs is not installed, so the LFS objects cannot be uploaded (docs/development.md: mise use -g git-lfs@latest, then git lfs install --skip-repo)"
  exit 1
fi
if node tools/git/remote-check.ts --enabled; then
  node tools/git/remote-check.ts <<<"$pushed"
else
  "$cargo" xtask check
fi
if grep -q 'filter=lfs' .gitattributes; then
  git lfs pre-push "$1" "$2" <<<"$pushed"
fi
