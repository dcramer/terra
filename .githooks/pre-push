#!/usr/bin/env bash
# Runs the full check before every push (D37): everything the quick check before each commit
# runs, and the slow sweeps, the artifacts ratchet and the Blender scripts' check. It
# checks the working tree, so run it on what you push: commit, `git pull --rebase origin main`,
# then push. It takes several minutes, and prints as the quick check does (D388; TERRA_VERBOSE=1
# streams everything). Never skip it with --no-verify.
set -euo pipefail
cargo=cargo
command -v cargo >/dev/null || cargo="$HOME/.cargo/bin/cargo"
exec "$cargo" xtask check
