#!/usr/bin/env bash
# Runs the push's check before every push (D37, D398): over everything that differs from the
# merge-base with origin/main, formatting, the code-health gates, the baselines, clippy and the
# fast tests of the crates changed and of those reading a changed file, the tools changed and
# the docs check; no slow test (SLOW_TESTS), dependents' tests, kits, foliage, artifacts, fuzz
# or Blender check. GitHub Actions runs those, the full `cargo xtask check --all`, on every push
# to main and bisects a failure to its commit (.github/workflows/main.yml). It checks the
# working tree, so run it on what you push: commit, then `cargo xtask land`, which rebases,
# checks, takes this machine's turn to land and pushes (D413); a plain push to main takes the
# same turn here, or stops before checking when another checkout holds it or main has moved.
# It prints as the quick check does (D388; TERRA_VERBOSE=1 streams everything). A pass stamps
# the tree, so after a refused push and `git pull --rebase` it runs only what the rebase
# changed; one that builds or tests waits for a machine-wide slot (D413). Never skip it with
# --no-verify.
set -euo pipefail
cargo=cargo
command -v cargo >/dev/null || cargo="$HOME/.cargo/bin/cargo"
# Git names each ref pushed on stdin: "<local ref> <sha> <remote ref> <sha>".
to_main=
while read -r _ _ remote_ref _; do
    if [ "$remote_ref" = refs/heads/main ]; then to_main=1; fi
done
if [ -n "$to_main" ]; then
    exec "$cargo" xtask check --pushing
fi
exec "$cargo" xtask check
