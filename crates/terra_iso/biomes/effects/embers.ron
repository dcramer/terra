// Embers drifting up off a fire in a loop (kit/effects.rs): slow streaks, rising, cooling.
(
    cue: Loop(2.5),
    at: Ground,
    still: 1.0,
    life: 2.5,
    sparks: (count: 20, speed: (0.2, 0.6), life: (1.2, 2.4), width: 0.012, spread: 0.6,
        gravity: -0.8, shutter: 0.06, hot: Srgb(1.0, 0.7, 0.35), hot_nits: 1200.0,
        cool: Srgb(1.0, 0.25, 0.05), cool_nits: 150.0, area: 0.25),
)
