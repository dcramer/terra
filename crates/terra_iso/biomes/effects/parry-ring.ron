// A blow on the hero parried (demo/blows.rs, kit/effects.rs `Cue::Parry`), steel on steel at
// the blade: a small white-hot point flash where the blades meet, gone in a fifteenth of a
// second, a cold light set out toward the camera as the hit's is (iso-kit j50) and a pool on
// the ground under it, and two jets of fast short streaks thrown along the blade to either
// side of the blow (`sides`), cooling to steel blue, as Diablo IV's and Path of Exile 2's
// parries spark. j26 to j29 drew a 1.2 m halo at 1.8 then 1.45 times: j29's judge saw "a soft
// blue-white disc with radial white spikes round the hero ... a programmer-art shield". It
// plays beside the hit's spark, which the blow sets off too. Its feel holds both a tenth of a
// second and shakes the view a little more than a light blow (terra_motion::contact's parry
// stops 0.12 s).
(
    cue: Parry,
    at: Strike,
    still: 0.05,
    life: 0.4,
    flash: (core: Srgb(0.95, 0.97, 1.0), core_nits: 14000.0, rim: Srgb(0.7, 0.82, 1.0), rim_nits: 500.0,
        size: 0.42, core_size: 0.25, falloff: 6.0, swell: 0.15, fall: 0.06),
    lamps: [
        (lm: 90000.0, colour: Srgb(0.75, 0.85, 1.0), up: 0.6, toward: 1.1, range: 4.0, fall: 0.1),
        (lm: 10000.0, colour: Srgb(0.75, 0.85, 1.0), up: 1.0, toward: 0.4, ground: true, range: 2.5,
            fall: 0.12),
    ],
    sparks: (count: 36, speed: (4.0, 9.0), life: (0.05, 0.16), width: 0.012, spread: 0.3,
        gravity: 6.0, shutter: 0.035, hot: Srgb(1.0, 0.98, 0.92), hot_nits: 9000.0,
        cool: Srgb(0.55, 0.7, 1.0), cool_nits: 600.0, area: 0.03, delay: 0.03, sides: 75.0),
    feel: (stop: (0.1, 0.12), shake: (0.06, 0.08), fall: 0.12, hz: 18.0),
)
