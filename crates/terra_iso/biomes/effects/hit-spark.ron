// The knight's blow biting the ogre (kit/effects.rs): a small white-hot core in a warm halo,
// a light at the bite and a pool on the floor under it, and a spray of short stubby sparks
// thrown over 0.05 s, falling, cooling white-yellow to orange to dark. iso-kit j43 cut the
// starburst (48 long streaks born together, 4 to 11 m/s, a 0.03 s shutter) and the 0.9 m halo
// for realism: smaller and subtler beats bigger.
(
    cue: Blow,
    at: Strike,
    still: 0.1,
    life: 0.5,
    flash: (core: Srgb(1.0, 0.95, 0.85), core_nits: 5000.0, rim: Srgb(1.0, 0.6, 0.28), rim_nits: 300.0,
        size: 0.5, core_size: 0.12, falloff: 7.0, swell: 0.3, fall: 0.08),
    // Its flash light set 1.1 m out toward the camera and 0.6 m over the bite (iso-kit j50):
    // at the bite it lit the faces knight and ogre turn to each other, which the camera does
    // not see; out here it lights the near ones, in a short reach and an eighth of a second's
    // fade, a spark's: twice the lumens it had at the bite (60k showed nothing on the bodies
    // in the forest's day, round 261107-0505). The pool 1 m over the ground, not 0.5: so close
    // it lit the dust under the blow to a flat orange disc (the marsh's judge).
    lamps: [
        (lm: 110000.0, colour: Srgb(1.0, 0.8, 0.55), up: 0.6, toward: 1.1, range: 4.5, fall: 0.12),
        (lm: 12000.0, colour: Srgb(1.0, 0.62, 0.32), up: 1.0, toward: 0.4, ground: true, range: 3.0,
            fall: 0.18),
    ],
    sparks: (count: 22, speed: (1.5, 5.0), life: (0.2, 0.5), width: 0.014, spread: 0.9,
        gravity: 9.8, shutter: 0.02, hot: Srgb(1.0, 0.93, 0.72), hot_nits: 5000.0,
        cool: Srgb(1.0, 0.38, 0.08), cool_nits: 700.0, area: 0.05, delay: 0.06),
)
