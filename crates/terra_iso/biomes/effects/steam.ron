// Steam rising in a loop (kit/effects.rs): pale soft puffs, lit by what is near, no light.
(
    cue: Loop(3.0),
    at: Ground,
    still: 1.4,
    life: 3.0,
    puffs: (count: 14, size: (0.3, 1.4), life: (2.0, 3.0), rise: 0.6, spread: 0.12,
        albedo: Srgb(0.85, 0.87, 0.9), density: 0.22, delay: 0.0,
        glow: Srgb(1.0, 1.0, 1.0), glow_nits: 0.0, grain: 0.7, soft: 0.5),
)
