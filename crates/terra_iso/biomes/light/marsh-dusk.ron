// Moonrise over the marsh at dusk (iso-art): a cold moon up behind the fight to the
// north-west keys the hummocks and rims every body against the warm fire and lantern in
// front of them, the water mirrors it as a sheen over the frame's top, and a cold blue sky's
// fill keeps the shade under the reeds and trees near black (vr-pond-slash: p5 0.0036, p50
// 0.038, p95 0.184). Moved from marsh/light.rs and marsh/mod.rs (iso-kit j1), not retuned.
// The marsh's water reads the key's direction and colour for its moon lane (marsh/land.rs).
(
    hour: Dusk,
    key: (
        // 42 degrees up behind the fight, left of the camera's line, so its mirror falls on
        // the far channel's left reach a seventh down the frame, a fifth of the frame left of
        // the caster, its lane down the water toward the eye clear of the fight
        // (marsh/light.rs's test; at 34 degrees it was over the frame's top and the water read
        // flat, blind-marsh6; 10 degrees to the right it lay behind the caster and the bolts
        // lost their contrast, the judge 2026-11-06).
        toward: Vector(-0.492, 0.670, -0.556),
        // sRGB 0.49, 0.64, 1 (was 0.6, 0.72, 1 to iso-art j48).
        colour: Linear(0.2, 0.37, 1.0),
        // Raised with the colours' turn bluer (iso-art j49) so each lights as brightly as
        // before (luminance 1100 x 0.48 and 22 x 0.25 of their sRGB 0.6, 0.72, 1 and 0.35,
        // 0.5, 1).
        lux: 1420.0,
        shadows: (cascades: 2, first: 30.0, far: 60.0, soft: 1.0),
    ),
    // Cold against the fires' amber, as V Rising's marsh.
    sky: (colour: Srgb(0.22, 0.36, 1.0), nits: 34.0),
    // Dusk's, between the ruin's night (8) and the forest's day (7.5 with a brighter sun).
    ev100: 7.5,
    curve: TonyMcMapface,
    // The haze over the far marsh, and its colour toward the moon.
    haze: Some((
        colour: Srgb(0.05, 0.07, 0.12),
        toward_key: Srgb(0.2, 0.26, 0.38),
        exponent: 12.0,
        start: -3.0,
        end: 34.0,
    )),
)
