// A city street at night after rain (iso-kit j11): a kerbed road between pavements, tall
// fronts to the north with storeys of windows, low shops to the south, sodium lamps over the
// road and neon signs on the walls, each lighting the wet asphalt in its colour. Drawn by the
// kit's Street layout (kit/street.rs); rain, steam, holograms, drones and litter are later
// jobs. The schema: crates/terra_iso/src/kit/biome.rs; how to add a biome: the iso-art skill's kit.md.
(
    kind: [Night, Rain],
    refs: "neon-street",
    layout: Street,
    street: (
        road: 7.0,
        walk: 3.2,
        kerb: (0.3, 0.15),
        length: 70.0,
        focus: (0.0, -4.0),
        // Just after rain: a film of the water (8 mm, a third of a puddle's mirror at its
        // 2 cm shore) over all the paving, so the lights streak across the whole wet road.
        film: 0.008,
        // Puddles standing over a little more of the street than the kit's 0.64 (iso-kit
        // j46, the judge's "road matte and dry"); at 0.58 those under the camera, mirroring
        // only the dark sky, read as black holes.
        puddles: 0.61,
        // Overhead (kit/cables.rs, iso-kit j46; the refs' Shibuya wires): black wires in
        // twos and threes strung from the north fronts at 5.6 to 6.4 m down to the low south
        // shops' eaves, hanging half a metre; a pair of feeds along the north face over the
        // shops; grey downpipes at the middle front's ends and a conduit up from the utility box.
        // Their radii 0.8 to 1.1 cm (iso-kit j49, the judge's "thick even black strokes
        // slicing the frame"), and the single wire moved off the left walker.
        cables: [
            (from: (-7.8, 5.7, -6.9), to: (-3.2, 3.4, 6.9), sag: 0.45, radius: 0.009,
             count: 3, every: (0.28, 0.1, 0.0)),
            (from: (0.3, 5.9, -6.9), to: (3.6, 3.3, 6.9), sag: 0.55, radius: 0.011,
             count: 2, every: (0.4, -0.12, 0.0)),
            (from: (6.6, 6.4, -6.9), to: (10.8, 3.3, 6.9), sag: 0.4, radius: 0.009,
             count: 2, every: (0.3, 0.08, 0.0)),
            (from: (-1.2, 5.9, -6.9), to: (8.5, 3.4, 6.9), sag: 0.6, radius: 0.008),
            (from: (-9.0, 3.6, -6.6), to: (6.0, 3.55, -6.6), sag: 0.14, radius: 0.009,
             count: 2, every: (0.0, -0.07, 0.03)),
            (from: (-8.72, 18.0, -6.84), to: (-8.72, 0.15, -6.84), radius: 0.05,
             colour: Srgb(0.2, 0.2, 0.19), rough: 0.5),
            (from: (5.72, 18.0, -6.84), to: (5.72, 0.15, -6.84), radius: 0.05,
             colour: Srgb(0.2, 0.2, 0.19), rough: 0.5),
            (from: (1.05, 1.1, -6.86), to: (1.05, 3.15, -6.86), radius: 0.025,
             colour: Srgb(0.35, 0.36, 0.34), rough: 0.55, count: 2, every: (0.3, 0.0, 0.0)),
        ],
        // The road: Poly Haven's worn Asphalt 02 at its 3 m, its own long cracks a little
        // darker (`joints` darkens what its occlusion marks: 1 clean, 0 black), none of the
        // kit's crack web (crazing reads as dried mud on asphalt), the detail grain fine as
        // its aggregate; wet all over and standing in patches and along the gutters.
        asphalt: (
            material: "asphalt_02",
            metres: 3.0,
            joints: 0.6,
            cracks: 1.0,
            grain: (0.2, 0.7),
            wet: Site("puddled"),
            dirt: 0.3,
            grit: 0.25,
            damp: 0.9,
            feet: Site("walls"),
            // Its grime (iso-kit j65, the judges' "too clean, no grime where the walls meet
            // the ground"): blotches of tyre and oil grime, wet dirt banked in the gutters,
            // oil dripped in spots up to 20 cm.
            grime: (blotch: 0.5, spots: 1.5, size: 0.2),
            // A city road's marks (kit/laid.rs), the road along x, its lanes' middles at z
            // ±1.75: three patched repairs; dripped oil down each lane's middle and the
            // wheel paths' rubber either side; worn white centre dashes (3 m every 9 m), a
            // zebra crossing (seven 0.5 m stripes a metre apart) with a stop line each side,
            // and double yellow lines along both kerbs.
            // After them (iso-kit j46, the judge's "a clean sheet, crisp stripes"): a
            // utility trench cut across the north lane from the kerb and filled darker, a
            // pothole's square repair, oil where cars stand and wait at the stop line; the
            // paint worn half away, and the wheel paths' rubber laid over it last, so the
            // crossing's stripes are grey where the tyres run.
            marks: [
                (kind: Patch, at: (-7.5, 1.4), size: (3.2, 1.1), amount: 0.9),
                (kind: Patch, at: (7.5, -1.6), size: (1.6, 1.4), turn: 4.0, amount: 0.8),
                (kind: Patch, at: (-10.5, -2.4), size: (0.9, 0.7), turn: -6.0, amount: 0.7),
                (kind: Patch, at: (2.3, -1.9), size: (0.55, 3.3), turn: 2.0, amount: 0.85),
                (kind: Patch, at: (-5.0, -1.1), size: (1.0, 0.8), turn: 14.0, amount: 0.75),
                (kind: Stain, at: (0.0, 0.0), size: (80.0, 0.7), every: (0.0, 3.5),
                 count: (1, 2), amount: 0.6),
                (kind: Stain, at: (3.4, -1.8), size: (1.4, 0.9), turn: 8.0, amount: 0.85),
                (kind: Stain, at: (6.3, -2.2), size: (1.0, 0.7), turn: -12.0, amount: 0.75),
                (kind: Stain, at: (-9.6, -1.4), size: (1.6, 0.8), amount: 0.7),
                (kind: White, at: (3.0, 0.0), size: (3.0, 0.12), every: (9.0, 0.0),
                 count: (9, 1), amount: 0.6),
                (kind: White, at: (-1.5, 0.0), size: (3.0, 0.5), every: (0.0, 1.0),
                 count: (1, 7), amount: 0.62),
                (kind: White, at: (-4.0, 1.75), size: (0.3, 3.3), amount: 0.55),
                (kind: White, at: (1.0, -1.75), size: (0.3, 3.3), amount: 0.55),
                (kind: Stain, at: (0.0, 1.75), size: (80.0, 0.45), every: (0.0, 1.7),
                 count: (1, 2), amount: 0.6),
                (kind: Stain, at: (0.0, -1.75), size: (80.0, 0.45), every: (0.0, 1.7),
                 count: (1, 2), amount: 0.6),
                // The gutters: the last 0.3 m of road at each kerb, where the run-off
                // and its silt lie, darker under the double yellows.
                (kind: Stain, at: (0.0, 0.0), size: (80.0, 0.3), every: (0.0, 6.7),
                 count: (1, 2), amount: 0.8),
                (kind: Yellow, at: (0.0, 0.0), size: (80.0, 0.1), every: (0.0, 6.5),
                 count: (1, 2), amount: 0.65),
                (kind: Yellow, at: (0.0, 0.0), size: (80.0, 0.1), every: (0.0, 6.1),
                 count: (1, 2), amount: 0.65),
            ],
        ),
        kerbs: (
            material: "granite_tile_04",
            metres: 2.0,
            joints: 0.3,
            cracks: 1.0,
            grain: (0.4, 0.5),
            wet: Site("gutter"),
            damp: 0.6,
            grime: (blotch: 0.4),
        ),
        // The north fronts' faces are bays of Poly Haven's apartments facade (kit/facade.rs,
        // iso-kit j26), its scenes: 0 door-large, 1 door-small, 2 shop-window (two sash
        // windows to the ground), 3 plain, 4 window-large, 5 window-double, 6 window-small,
        // 7 window-offset, 8 crown, 9 pier. The street storey's plain bays stand behind the
        // rollershutters (their models' middles 1 m along from their `at`), its shop windows
        // under the signs; heights are whole 3 m storeys. Behind the glass each bay is a room
        // 2.2 m deep (kit/rooms.rs, iso-kit j37): lit warm or cold, some by a TV's blue
        // alone, some with blinds or curtains part drawn, some dark or shuttered, by a hash.
        // A lit shop window's light spills out onto the pavement before it, a warm pool
        // 2.2 m out (rooms `spill`, iso-kit j49), dark between the shops. A room's glow is
        // emissive, which the camera's exposure does not scale: at 6 nits every lit room
        // passed the tone curve's shoulder into one cream (the judge's "identical peach
        // windows"), so they glow at 1.4 to 1.6 (the shops 3), each in one of tungsten,
        // halogen, cold and green fluorescent, at its own brightness (iso-kit j69).
        fronts: [
            (side: North, along: (-35.0, -9.0), height: 15.0, material: "concrete_wall_006",
             metres: 2.0, roof: "asphalt_02",
             bays: (model: "models/iso/city/facade-apartments.glb",
                    ground: [2, 1, 2, 3, 0, 2, 3, 2, 1], upper: [5, 4, 5, 6], top: 8, pier: 9,
                    lit: 0.4, shops: (0.85, 3.0), nits: 1.6,
                    colours: [Srgb(1.0, 0.62, 0.32), Srgb(1.0, 0.82, 0.6),
                              Srgb(0.72, 0.88, 1.0), Srgb(0.8, 1.0, 0.84)],
                    paint: Srgb(0.78, 0.5, 0.4), grime: 0.35,
                    back: 2.2,
                    wall: (scan: "concrete_wall_006", contrast: 1.2, streaks: 0.7, foot: 0.6),
                    rooms: (tv: 0.2, blinds: 0.25, curtains: 0.25, shut: 0.3,
                            cloth: [Srgb(0.55, 0.12, 0.1), Srgb(0.75, 0.62, 0.4)],
                            shutters: [Srgb(0.42, 0.45, 0.43), Srgb(0.45, 0.35, 0.25)],
                            spill: (60000.0, 2.2), windows: [2]))),
            // 18 m (was 9): the road's mirror rises 55 to 64 degrees at this camera, so its
            // middle meets the north fronts 9 to 25 m up; over a 9 m roof it mirrored only
            // the 2-nit sky, black at Fresnel's 2% (iso-kit j72). Its roof is never in frame.
            (side: North, along: (-9.0, 6.0), height: 18.0, material: "rusty_corrugated_iron",
             metres: 2.0, tint: (0.7, 0.7, 0.72), roof: "asphalt_02",
             bays: (model: "models/iso/city/facade-apartments.glb",
                    ground: [3, 2, 1, 3, 2], upper: [6, 7], top: 8, pier: 9,
                    lit: 0.4, shops: (1.0, 3.0), nits: 1.4,
                    colours: [Srgb(1.0, 0.62, 0.32), Srgb(1.0, 0.82, 0.6),
                              Srgb(0.8, 1.0, 0.84)],
                    paint: Srgb(0.9, 0.84, 0.68), grime: 0.45,
                    back: 2.2,
                    wall: (scan: "concrete_wall_006", contrast: 1.4, streaks: 0.8, foot: 0.7),
                    rooms: (tv: 0.25, blinds: 0.3, curtains: 0.15, shut: 0.45,
                            cloth: [Srgb(0.2, 0.35, 0.3)],
                            shutters: [Srgb(0.3, 0.38, 0.42), Srgb(0.42, 0.45, 0.43)],
                            spill: (60000.0, 2.2), windows: [2]))),
            (side: North, along: (6.0, 35.0), height: 21.0, material: "concrete_wall_006",
             metres: 2.0, tint: (0.85, 0.8, 0.74), roof: "asphalt_02",
             bays: (model: "models/iso/city/facade-apartments.glb",
                    ground: [2, 2, 3, 0, 3, 2, 1, 2, 0, 2], upper: [4, 5, 4, 7], top: 8, pier: 9,
                    lit: 0.35, shops: (0.85, 3.0), nits: 1.6,
                    colours: [Srgb(1.0, 0.62, 0.32), Srgb(0.72, 0.88, 1.0),
                              Srgb(1.0, 0.86, 0.68), Srgb(0.8, 1.0, 0.84)],
                    paint: Srgb(0.6, 0.66, 0.72), grime: 0.35,
                    back: 2.2,
                    wall: (scan: "concrete_wall_006", contrast: 1.2, streaks: 0.7, foot: 0.6),
                    rooms: (tv: 0.2, blinds: 0.3, curtains: 0.2, shut: 0.25,
                            cloth: [Srgb(0.75, 0.62, 0.4), Srgb(0.3, 0.2, 0.45)],
                            shutters: [Srgb(0.42, 0.45, 0.43)],
                            spill: (60000.0, 2.2), windows: [2]))),
            (side: South, along: (-35.0, -4.0), height: 4.0, material: "concrete_wall_006",
             metres: 2.0, roof: "asphalt_02"),
            (side: South, along: (-4.0, 35.0), height: 3.6, material: "rusty_corrugated_iron",
             metres: 2.0, tint: (0.7, 0.7, 0.72), roof: "asphalt_02"),
        ],
        // Sodium lamps (about 2000 K) over the road, sides taking turns: each a pool about
        // 6 m across under its head (a 42 degree cone, out to 10.5 m, so it falls to dark
        // before the next; iso-kit j40, the judge's "a frame-wide wash, not pools").
        lamps: (every: 16.0, start: -24.0, height: 6.5, reach: 1.6,
                colour: Srgb(1.0, 0.62, 0.25), lumens: 600000.0, angle: 42.0, range: 10.5,
                shadows: true),
        // Textures from text by ffmpeg (assets/models/iso/city/README.md, signs). Each a
        // spot down onto the pavement under it (`pool`: its cone's half angle, metres out,
        // lumens) and a short glow on the wall about it (`lumens`, `range`), so the face
        // above and between the signs falls dark (iso-kit j42). The cones 58-62 degrees
        // spread the BAR's and the drug sign's light into one teal wash over the pavement
        // and road (judge 261107-0426): at 30-34 each is a pool some 6 m across, its core
        // half that, dark between them; the glows lift the wall about each sign.
        signs: [
            (texture: "models/iso/city/signs/ramen.png", side: North, at: -12.0, height: 6.5,
             size: (0.9, 3.15), blade: true, colour: Srgb(1.0, 0.16, 0.55), nits: 30.0,
             lumens: 50000.0, range: 5.0, shadows: true, pool: (32.0, 2.0, 120000.0)),
            (texture: "models/iso/city/signs/bar.png", side: North, at: -3.0, height: 4.6,
             size: (2.9, 1.1), colour: Srgb(0.1, 0.82, 1.0), nits: 30.0, lumens: 45000.0,
             range: 3.5, shadows: true, pool: (38.0, 2.5, 150000.0)),
            (texture: "models/iso/city/signs/drug.png", side: North, at: 3.6, height: 5.6,
             size: (1.0, 2.0), colour: Srgb(0.22, 1.0, 0.42), nits: 30.0, lumens: 25000.0,
             range: 3.2, shadows: true, pool: (38.0, 1.8, 70000.0)),
            (texture: "models/iso/city/signs/24h.png", side: North, at: 9.0, height: 4.4,
             size: (2.2, 1.0), colour: Srgb(1.0, 0.19, 0.09), nits: 30.0, lumens: 50000.0,
             range: 5.0, shadows: true, pool: (32.0, 1.8, 100000.0)),
            // Signs up the fronts, 9.5 to 15 m, as a neon street's climb its storeys (the
            // refs' Shibuya): above the frame, they are what the near road and its puddles
            // mirror (iso-kit j72: the puddle under the camera mirrored the 21 m front 11 m
            // up, a dark wall, and nothing lit stood where the rest of the road's mirror
            // looked). Flat, so the mirror sees their faces; a small glow each on its wall.
            (texture: "models/iso/city/signs/bar.png", side: North, at: 8.8, height: 11.8,
             size: (4.0, 1.6), colour: Srgb(0.1, 0.82, 1.0), nits: 30.0, lumens: 6000.0,
             range: 2.5),
            (texture: "models/iso/city/signs/ramen.png", side: North, at: 11.6, height: 9.6,
             size: (1.0, 3.5), colour: Srgb(1.0, 0.16, 0.55), nits: 30.0, lumens: 6000.0,
             range: 2.5),
            (texture: "models/iso/city/signs/24h.png", side: North, at: -5.0, height: 12.0,
             size: (3.6, 1.6), colour: Srgb(1.0, 0.19, 0.09), nits: 30.0, lumens: 6000.0,
             range: 2.5),
            (texture: "models/iso/city/signs/drug.png", side: North, at: 1.0, height: 13.5,
             size: (1.6, 3.2), colour: Srgb(0.22, 1.0, 0.42), nits: 30.0, lumens: 6000.0,
             range: 2.5),
            (texture: "models/iso/city/signs/ramen.png", side: North, at: -15.5, height: 11.0,
             size: (1.1, 3.85), colour: Srgb(1.0, 0.16, 0.55), nits: 30.0, lumens: 6000.0,
             range: 2.5),
            (texture: "models/iso/city/signs/bar.png", side: North, at: -19.0, height: 12.0,
             size: (3.4, 1.3), colour: Srgb(0.1, 0.82, 1.0), nits: 30.0, lumens: 6000.0,
             range: 2.5),
        ],
        props: [
            (model: "models/iso/city/rollershutter-door.glb", side: North, line: Wall,
             at: [-17.22, -8.5, 12.25, 18.05], out: -0.2),
            // Wheelie bins against the wall (two side by side, one rusted), under the bar's
            // sign and by the 24H shop; scanned, where the bin bags read as smooth blobs.
            (model: "models/iso/city/trash-can.glb", side: North, line: Wall,
             at: [-4.7, 10.6], out: 0.05),
            (model: "models/iso/city/propane-tank.glb", side: North, line: Wall, at: [-8.6]),
            // Hung on the middle front (iso-kit j46, the refs' clutter): air conditioners on
            // brackets under the first floor's windows (its bays 3 m, centred -7.5 to 4.5),
            // a payphone by the shutter; a jerrycan by the tank, crates by the 24H shop.
            (model: "models/iso/city/aircon-unit.glb", side: North, line: Wall,
             at: [-7.5, -1.5, 4.5], out: -0.05, up: 3.2),
            (model: "models/iso/city/trash-bag.glb", side: North, line: Wall,
             at: [-5.75, -3.7, 11.55], out: 0.1, turn: 35.0),
            (model: "models/iso/city/payphone.glb", side: North, line: Wall, at: [-6.1],
             out: -0.19, up: 0.95),
            (model: "models/iso/city/jerrycan.glb", side: North, line: Wall, at: [-8.05],
             out: 0.1, turn: 20.0),
            (model: "models/iso/city/military-crate.glb", side: North, line: Wall, at: [7.6],
             out: 0.05, turn: 4.0),
            (model: "models/iso/city/utility-box.glb", side: North, line: Wall, at: [1.2]),
            (model: "models/iso/city/oil-barrel.glb", side: South, line: Wall, at: [-9.0, -8.3]),
            (model: "models/iso/city/trash-can.glb", side: South, line: Wall, at: [-2.0, 5.5],
             out: 0.05),
            (model: "models/iso/city/old-tyre.glb", side: South, line: Kerb, at: [-5.5],
             turn: 30.0),
            // A car parked at the north kerb before the crossing, a 1980s compact Japanese
            // sedan in deep red gloss paint, its glass, lamps and interior real (1.77 m wide,
            // 4.35 m long, -8.2 to -3.8, clear of the zebra; was a car under a black tarp, every
            // judge's "featureless black capsule", iso-kit j77), its near side 0.25 m off the
            // kerb's face, where the frame shows the most road.
            (model: "models/iso/city/sedan.glb", side: North, line: Road, at: [-6.0],
             out: 2.36, turn: 90.0),
            (model: "models/iso/city/manhole-cover.glb", side: North, line: Road, at: [4.0],
             out: 1.2),
            // People, for the street's scale (the iso hero, 1.85 m, held in his clips):
            // each in a pool (iso-kit j42, the judge's "near-black on near-black"): one walking
            // the pavement in the sodium lamp's pool at x 8, one in the BAR's cyan pool, each
            // edged by a faint cold rim (about a third of the ruin's fighters' at this ev).
            // In a film each strolls the frame's length of pavement (it shows x -11 to 9.4
            // on this line), one each way, so neither leaves it in the 16 s (walking on from
            // where they stand, both had by 5 s, round 261107-1627's film); the one going west
            // nearer the kerb, so they pass 0.8 m apart, starting short of the pole at x 8.
            (model: "models/iso/knight.glb", side: North, line: Wall, at: [6.8], out: 1.4,
             turn: 75.0, pose: ("walk", 0.4), rim: 0.35,
             walk: Some((from: (-15.0, 0.0), to: (2.6, 0.0)))),
            (model: "models/iso/knight.glb", side: North, line: Wall, at: [-2.4], out: 1.5,
             turn: -60.0, pose: ("walk", 1.5), rim: 0.35,
             walk: Some((from: (9.9, 0.8), to: (-7.6, 0.8)))),
            // The film's fight, as play's (play.rs: the hero against two ogres, one 2.4 m off
            // swinging, one behind him), in the road below the focus, clear of the strollers;
            // a film only, so the still is as it was. The hero walks in up the road's south
            // lane (ruin/walk.rs), then chops (fight.rs's 1.3 s).
            (model: "models/iso/knight.glb", side: North, line: Road, at: [0.5], out: 1.6,
             turn: 125.0, pose: ("attack", 1.3), rim: 0.35, film: true,
             walk: Some((from: (1.5, 3.5), fight: true))),
            (model: "models/iso/ogre.glb", side: North, line: Road, at: [2.5], out: 3.0,
             turn: -55.0, pose: ("attack", 0.45), rim: 0.35, film: true),
            (model: "models/iso/ogre.glb", side: North, line: Road, at: [-1.7], out: -0.2,
             turn: 129.0, pose: ("idle", 0.0), rim: 0.35, film: true),
        ],
    ),
    // The city's own glow off the low cloud a little up from the preset's 1.5 nits (iso-kit
    // j51), so the bins, the car and the fronts' foot read as forms between the pools.
    light: (preset: "city-night-rain", overrides: (nits: 2.0)),
    // The kit's water (kit/water.rs) standing in the street's `puddled` patches, a few
    // millimetres over the road and the pavements: a clear film on the dark wet floor that
    // mirrors the lamps, signs and fronts (at the marsh's lift), each light's streak long
    // toward the eye; near still, no rain's rings yet.
    water: (
        kind: Puddles,
        level: 0.004,
        film: 0.01,
        deep: Srgb(0.02, 0.02, 0.022),
        shore: 0.02,
        mirror: (lift: 3.0, distort: 0.04, smear: 0.04),
        ripples: (fine: 1.3, broad: 5.5, steep: 0.06, calm: 0.5),
        // Rain's rings in the puddles (kit/water.wesl), a few a square metre.
        rain: 4.0,
        // Each lamp's highlight a long streak toward the eye, as on a wet road at night:
        // the lobe spread along the view 2.5 times the default's, three times its gain.
        streaks: (along: 0.25, across: 0.04, gain: 3.0),
    ),
    // Rain falling (kit/weather.rs, iso-kit j19): streaks seen only in the lamps' and signs'
    // light, splashes on the paving.
    weather: (wind: (0.6, 0.2), rain: 0.7, drops: (bright: 0.06, splashes: 0.7)),
    ground: (
        // The pavements: Poly Haven's Concrete Pavement flags laid at 2.7 m, so each is a
        // street's 900 x 450 mm flag (its 1.8 m made them 600 x 300 mm block pavers), their
        // straight joints grimed; no crack web (crazing reads as dried mud).
        laid: (
            material: "concrete_pavement",
            metres: 2.7,
            joints: 0.3,
            cracks: 1.0,
            grain: (0.3, 0.6),
            wet: Site("puddled"),
            dirt: 0.4,
            grit: 0.2,
            damp: 0.7,
            feet: Site("walls"),
            // A city pavement's grime (iso-kit j65, the judges' "a clean, even grid of
            // flags"): dirt soaked up to 6 cm in from the joints, each flag dirtier or
            // cleaner than the next, blotches trodden in, wet dirt banked at the fronts'
            // feet, and chewing gum, thirty spots a square metre up to 4 cm.
            grime: (edges: 0.06, blotch: 0.6, spots: 30.0, size: 0.04),
            // The scan's six courses of flags in a running bond, off its colour map, so
            // each flag is its own (iso-kit j49, the judge's "no paving joints"): its value
            // and roughness its own, a few relaid off-tone, one in ten cracked across, and
            // the joints opened 1.5 cm and grimed, where the scan's 8 mm hairline fell under
            // a pixel at the camera.
            courses: [
                (0.0, [0.166, 0.5, 0.833]),
                (0.168, [0.0, 0.334, 0.668]),
                (0.335, [0.166, 0.5, 0.833]),
                (0.502, [0.0, 0.334, 0.668]),
                (0.669, [0.166, 0.5, 0.833]),
                (0.835, [0.0, 0.334, 0.668]),
            ],
            spread: (0.24, 0.4),
            wear: (split: 0.06, tilt: 0.03, broken: 0.1, gap: 0.015),
            // The flags' stains and repairs (iso-kit j46): the road's trench run on across
            // the north pavement to the wall, relaid darker; bin juice under the bins, drips
            // under the air conditioners, spills and a shop's doorstep worn dark.
            marks: [
                (kind: Patch, at: (2.3, -5.4), size: (0.6, 3.2), turn: 2.0, amount: 0.8),
                (kind: Patch, at: (-1.2, 5.0), size: (1.8, 0.9), amount: 0.7),
                (kind: Stain, at: (-4.7, -6.3), size: (1.7, 1.0), amount: 0.85),
                (kind: Stain, at: (10.6, -6.3), size: (1.2, 0.9), amount: 0.8),
                (kind: Stain, at: (-7.5, -6.55), size: (1.5, 0.4), amount: 0.75),
                (kind: Stain, at: (4.5, -6.55), size: (1.5, 0.4), amount: 0.75),
                (kind: Stain, at: (-0.4, -5.0), size: (0.8, 0.55), turn: 25.0, amount: 0.7),
                (kind: Stain, at: (6.2, -4.6), size: (0.6, 0.45), turn: -30.0, amount: 0.65),
                (kind: Stain, at: (-1.5, -6.3), size: (1.4, 0.9), amount: 0.6),
            ],
        ),
    ),
    // Litter by the wall feet and the kerbs (kit/scatter.rs on the street's `walls` map):
    // boxes left out in clumps, each flat on the paving (a 25 degree lean stood one on a
    // corner in mid-air), on its contact shadow and stain (kit/contact.rs, iso-kit j40).
    scatter: [
        (models: ["models/iso/city/cardboard-box.glb"], density: 0.25, scale: (0.6, 1.3),
            on: Site("walls"), clump: (4.0, 0.8, 0.9), tilt: 3.0, sink: 0.01, seed: 7),
        // Bin bags heaped by the walls and kerbs in their own clumps (iso-kit j46).
        (models: ["models/iso/city/trash-bag.glb"], density: 0.12, scale: (0.8, 1.2),
            on: Site("walls"), clump: (5.0, 1.0, 0.92), tilt: 10.0, sink: 0.02, seed: 23),
    ],
    // Play's blows (play.rs, play/strike.rs): the sword's trail and the sparks where it
    // bites. Only play adds the effects to the street (it stages no fight), so a still is
    // as before. The lights dimmed from the presets' (tuned in the ruin's day): at full,
    // the night street's near wall flashed orange for a few frames, the sparks' (iso-play
    // j5) and the trail's through the whole swing (iso-play j8: at 0.2 the wall's red still
    // tripled, 0.05 to 0.16, over a swing).
    effects: [(preset: "slash", light: 0.05), (preset: "hit-spark", light: 0.25)],
    // The street captured from a car roof's height in the road's middle, lit back as the
    // view's environment map (kit/reflect.rs, uc-reflect j1): the sedan's paint and glass
    // and the shop windows mirror the lamps, signs and fronts, not black. Its diffuse at
    // 0.4 (j2): at the full 1 it lifted all the shade alike, the lamps' pools against the
    // dark between them flattened and the saturation fell 0.08 (round 261107-1545).
    // Boxed to the street (j4): the north fronts' faces at z -6.9, the south shops' at
    // 6.9, its 70 m length, 24 m up, so the fronts and lamps mirror where they stand.
    reflect: (at: (0.0, 1.5, -0.5), diffuse: 0.4, bounds: (70.0, 24.0, 15.0)),
)
