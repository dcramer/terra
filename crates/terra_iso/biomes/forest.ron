// The temperate wood by day (iso-art): the glade's land, oaks, grass, pond and beasts, and
// in its clearing by the pond the knight fighting tree creatures; a moose on the far bank,
// birds, pollen in the sun. `--biome forest`, or `--scene forest`; `--hour dusk|night`
// runs the glade's light at that hour instead of this preset.
// The schema: crates/terra_iso/src/kit/biome.rs; how to add a biome: the iso-art skill's kit.md.
(
    kind: [Day, Water],
    refs: "forest",
    // Its scatter and life are still wood/'s and the glade's own code; they move here as
    // the kit's jobs land (j7 on).
    layout: Forest,
    light: (preset: "forest-day"),
    // The kit's ground (kit/ground.rs) over the glade's own maps (terrain.rs `SITES`).
    // The tints bring each scan, photographed under cloud, to its stuff's albedo in the
    // open (grass greener, moss far lighter). The grass's (1.55, 2.1, 1.2) read as a lime
    // blur at the paths' edges in the sun (judge 261107-0556): an olive green now.
    ground: (
        layers: [
            (material: "leafy_grass", mask: Site("grass"), tint: (1.6, 1.75, 1.3)),
            // Fallen leaves, fresh or dry in drifts.
            (material: "forest_leaves_04", mask: Site("leaves"), tint: (1.5, 1.45, 1.35),
                breakup: (0.21, 0.9, 0.65, 0.35)),
            (material: "dry_decay_leaves", mask: Site("leaves"), tint: (1.45, 1.4, 1.3),
                breakup: (0.21, 0.9, 0.35, 0.65)),
            (material: "moss_004", mask: Site("moss"), tint: (5.0, 6.0, 3.2)),
            (material: "rock_face_03", mask: Site("rock"), tint: (1.35, 1.35, 1.4),
                triplanar: true),
            // Wet mud by the water: darker and glossier.
            (material: "brown_mud_02", mask: Site("mud"), wets: 1.0),
            (material: "roots", mask: Site("roots"), tint: (1.3, 1.3, 1.3)),
            // The trodden clearing and the paths off it: earth with grit and pebbles kicked
            // up, in patches through the litter (judge 261107-0250: "one flat dark-brown
            // sheet ... no path wear"; fine detail 0.111 against the refs' 0.149).
            // At amount 0.9 and a band 0.38 to 0.62 the litter won the height blend nearly
            // everywhere (round 261107-0343): only the camp's earth showed it. Its grey grit
            // under the sky's blue fill read "blue-grey gravel, not packed brown dirt"
            // (judge 261107-0358-2): tinted toward a loam's warm brown.
            (material: "rocks_ground_01", mask: Wear, amount: 1.6, tint: (1.45, 1.2, 0.9),
                breakup: (0.3, 1.4, 0.3, 0.55)),
        ],
        // The camp's fire (scene::FIRE).
        scorch: [(0.0, 3.0)],
    ),
    // The pond, the kit's water (kit/water.rs, wood/pond.rs, iso-kit j28, j33): still,
    // peaty and deep, as the refs' forest ponds: the bed shows only in a hand's breadth at
    // the bank, the rest a near-black green-brown body under the canopy's and the
    // forest-day sky's mirror; the breeze barely moves it; the sun's lane off a stand-in
    // glint (pond.rs), faint.
    water: (
        kind: Pond,
        level: -0.55,
        // The body is lit as the ground (the shader's PBR pass), so by day its colour is an
        // albedo under the 4,200 lux sun: j28's Linear(0.025, 0.035, 0.02) and absorb
        // 3.5/2.2/2.0 read as sunlit dark soil with the bed through it, "a milky grey sheet
        // like concrete" (round 261107-0220, lift 1, gain 0.15, key 0.1); the marsh's night
        // hides the same body. Real peaty water scatters well under 1%: near black, the
        // mirror the brightest part of it.
        deep: Srgb(0.035, 0.04, 0.025),
        absorb: (14.0, 11.0, 10.0),
        // The face is drawn over the marsh's shelving depth (wood/pond.rs), so it fades in
        // over about half a metre of mud; drowned leaf litter mats that margin and fallen
        // oak leaves float in the shallows, brown and olive, a hand across (the drone refs'
        // forest ponds; judge 261107-0507: "no muddy shelf, lily edge or leaf drift").
        shore: 0.12,
        film: 0.0,
        scum: (colour: Linear(0.045, 0.035, 0.018), amount: 0.45, reach: 0.18, size: 0.9),
        // At count 5 and linear 0.11, 0.075, 0.03 they were sunlit yellow confetti (round
        // 261107-0549): fewer, larger, darker and wet.
        pads: (count: 3.0, radius: 0.09, colour: Linear(0.05, 0.035, 0.015)),
        // A broad lane (along 0.15, across 0.06, steep 0.12) and glitter 0.3 drew a milky
        // sheet under rain-like dashes over the whole pond, its mean sRGB 168, 161, 137
        // against the bridge pond ref's 59, 71, 77 (round 261107-0155): a calm face, a
        // narrow lane, a little glitter, no dashes.
        // The stand-in glint's lane (pond.rs) at gain 0.15 was the grey sheet itself once
        // the body was dark: a broad tan glow over the pond's middle, box mean sRGB 126,
        // 120, 105 (round 261107-0248). A still pond with the sun out of its mirror shows
        // none, so the lane is off and the mirror carries the face.
        mirror: (lift: 2.5, distort: 0.04),
        ripples: (fine: 0.7, broad: 3.0, steep: 0.05, calm: 0.9),
        streaks: (along: 0.06, across: 0.025, cell: 0.1, glitter: 0.08, gain: 0.0, key: 0.1, dash: 1.0),
    ),
    // Play's mobs (demo/mobs.rs): the wood's creatures in three packs along a route south
    // from the hero's start and then west (`at` is off it; the start is (4, 5.5)), each pack
    // on open ground of the nav grid and footprints (iso-forest-demo j10's map): the first
    // about the camp, 7 to 8 m off him on three sides, out of the trees, waking at once (the
    // iso-hero films' foes); the second in the clearing south past the camp's gap (about
    // (11, 23)); the third west of it in the south-west meadow (about (-10, 25)), each 17 to
    // 20 m on from where the last is fought, so it stands until he comes within mobs.rs
    // `WAKE` and a breather lies between. `walk` is the ledger's speeds.walk, held by tools/iso-art/roster.test.ts.
    // `tone` darker than the still's (`bodies`): at those the tree monster stood 0.9 L* and
    // the treant 5.7 L* lighter than a 10 px ring about them; at 0.12 2.5 darker and 2.9
    // lighter (play frame 140, iso-forest-demo j8). In the open meadow 0.12 stood packs 1 and
    // 2 near black, 12.4 and 8.5 L* under the ring (route frame 560); at 0.2 8.7 and 6.0, in
    // the 5 to 10 aimed at; pack 0, in the camp's shade, stays 0.12, where 0.2 stood it 1 to
    // 2.6 lighter (iso-forest-demo j12). Albedo is a weak lever: 0.06 moved
    // neither further; their light is mostly not their albedo's. The rim band was most of it
    // and its white streaks (iso-forest-demo j14): at rim 0.35 with a fill light of 2.0
    // (rim.rs `Fighter::with_fill`) the route's frames 560, 650, 1030 stand them 0.7 lighter
    // to 12.3 darker than their ring (rim 0.35 alone: 7.7 to 20.5 darker, medians 8 to 29 L*,
    // now 24 to 34), streaks 0.2 to 1.4% of a body; fill 4.0 stood two in shade 4 to 6 lighter
    // and 1.0 left the meadow's 11 to 15 darker (iso-forest-demo j15). `radius` is each
    // model's standing pose's, 95% of its points from 5 to 95% of its height within it of its
    // middle: treant-a 0.67, treant-b 0.66, tree-monster 0.81 (the 0.45 every creature had
    // let the hero stand and roll inside their bark, iso-forest-demo j18). Rim 0.15 with
    // treant-b and the tree monster leaf-trimmed (`iso-art trim --keep 0`): their bark at
    // 0.35 took white streaks on every fold, and from above their crowns read as bushes
    // (route frame 200's blind pair won clear and slight over both, iso-forest-art j2).
    // treant-c, made through the concept's creature path (a bark trunk, face and limbs, a
    // small crown), takes treant-b's first slot: its bark reads from above where the trimmed
    // one's sank (route frame 200, blind pair clear, iso-forest-art j3); radius treant-b's
    // (its standing depth 0.90 m is treant-a's 0.87). treant-d, the same with a broken leafy
    // crown, took that slot in j4: treant-c's sawn-flat top read as a stump from above (route
    // frame 200, blind pair clear). Walk 0.71, its planted foot's speed.
    foes: [
        (model: "models/iso/treant-a.glb", at: (6.5, -5.0), walk: 0.96, tone: (value: 0.12, rim: 0.15, fill: 2.0), radius: 0.65),
        (model: "models/iso/treant-d.glb", at: (-7.0, -3.0), walk: 0.71, tone: (value: 0.12, rim: 0.15, fill: 2.0), radius: 0.65),
        (model: "models/iso/tree-monster.glb", at: (3.0, 7.0), walk: 1.27, tone: (value: 0.12, rim: 0.15, fill: 2.0), radius: 0.8),
        (model: "models/iso/tree-monster.glb", at: (-13.0, 9.5), walk: 1.27, tone: (value: 0.2, rim: 0.15, fill: 2.0), pack: 1, radius: 0.8),
        (model: "models/iso/treant-a.glb", at: (-11.5, 12.0), walk: 0.96, tone: (value: 0.2, rim: 0.15, fill: 2.0), pack: 1, radius: 0.65),
        (model: "models/iso/treant-b.glb", at: (6.5, 18.5), walk: 0.84, tone: (value: 0.2, rim: 0.15, fill: 2.0), pack: 2, radius: 0.65),
        (model: "models/iso/tree-monster.glb", at: (9.0, 17.0), walk: 1.27, tone: (value: 0.2, rim: 0.15, fill: 2.0), pack: 2, radius: 0.8),
    ],
    // The staged fight's effects (biomes/effects/, kit/effects.rs). The hit's spark grown to read
    // at the route's 10 m camera (iso-forest-demo j26): as the preset is, a blow's burst was 15
    // to 20 px of 1080 and its streaks 1.5 px thick (route frames 182, 254, 289, 550), so the
    // judge saw no hit at all; the ARPGs' sparks are large and bright. The parry's flash as its
    // preset is (j30): grown, its halo read as a disc about him.
    effects: [(preset: "slash"), (preset: "hit-spark", scale: 2.5), (preset: "parry-ring"), (preset: "smoke-puff"), (preset: "spell-burst"), (preset: "bolt")],
    // How the fighters stand off the floor (ruin/fight.rs `cast`): darker than the ground
    // about them, as the ruin's (iso-art j34). The treants at the ruin's 0.2 and 0.35 read
    // as black cut-outs on the shaded floor by day, no lit form (judges 261107-0437 and
    // 0507, iso-kit j50): their bark lifted most of the way back (0.85 of the root of it),
    // so the sun models their limbs, still under the trodden earth's value.
    bodies: {
        "models/iso/treant-a.glb": (value: 0.38013),
        "models/iso/treant-b.glb": (value: 0.50287),
        "models/iso/tree-monster.glb": (value: 0.35, rim: 0.35),
    },
    // The foes' attack tell (demo/tell.rs): the ember-red default is the orange litter's hue,
    // only darker or lighter (dE 14 and 21 from lit and dark litter, iso-forest-hits j21), so
    // a crimson fill with a crimson rim, apart from it in hue (iso-forest-demo j23). The fill
    // a sixth of its j23 strength: tell.wesl adds it as light, and at full it was a flat magenta
    // wedge (f-0584 fill L 35 a* 52, dE 61 from dark litter; now L 23 a* 19, dE 25; j31). The
    // rim a twelfth of j23's (6, 1.8, 2.6), which blew out to a pink neon arc (f-0584 rim L 74
    // a* 25 C 25, dE 70 from litter); now a red line on the ground (L 35 a* 35, dE 47; j32).
    tell: (fill: Linear(0.24, 0.02, 0.05), edge: Linear(0.5, 0.075, 0.1)),
)
