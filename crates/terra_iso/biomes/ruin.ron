// The ruin at night (iso-art): an action RPG's night fight in a ruined court, a knight
// against an ogre and a tree monster on broken flagstones between fallen walls, lit by the
// moon and by braziers and torches. `--biome ruin`, or `--scene ruin`.
// The schema: crates/terra_iso/src/kit/biome.rs; how to add a biome: the iso-art skill's kit.md.
(
    kind: [Night],
    refs: "ruin",
    // Its scatter, decals, water, effects and life are still ruin/'s own code; they move here
    // as the kit's jobs land. The court's paving and its maps are the layout's (ruin/ground.rs).
    layout: Ruin,
    light: (preset: "ruin-night"),
    ground: (
        // The court's flags (kit/laid.rs): Poly Haven's Large Grey Tiles at their true 3 m,
        // grime in the joints, cracks, the stone grain, moss and puddles where the court's
        // maps lay them.
        laid: (
            material: "large_grey_tiles",
            metres: 3.0,
            joints: 0.3,
            // Sand and soil in the joints, not black lines (the open court read clean CG,
            // judge 261107-0250-ruin): dark loam and grit, sand where it dried, moss in
            // tufts along them (kit/laid.wesl).
            sand: 0.75,
            // No darkened hairlines (at 0.25 "crack lines that look drawn on", judge
            // 261107-0150); the moss still grows in the crack web, which the judges keep:
            // without it the court lost slight in both orders ("intact, clean slabs", 261107-1015).
            cracks: 1.0,
            grain: (0.5, 0.6),
            moss: Site("mossy"),
            wet: Site("puddled"),
            // The scan's three courses and their joints, off its colour map: each flag its
            // own value, warmth and roughness.
            courses: [
                (0.008, [0.069, 0.443, 0.705]),
                (0.345, [0.086, 0.399, 0.726]),
                (0.677, [0.005, 0.337, 0.630]),
            ],
            spread: (0.4, 0.4),
            // An old court's flags (judge 261107-0358-2-ruin: "a regular grid of same-size,
            // same-tone flags ... reads as one tiled texture"): nearly half split in two (a
            // half again), so they vary in size; settled out of true up to 4.5 degrees; one in
            // seven cracked across, its far side sunk, or a corner gone; one in twenty gone
            // to soil and moss; more of each by the walls' feet. Their joints opened 1-3 cm
            // and earthed, each unit's its own width, the arrises worn round 4 cm in
            // (judge 261107-0507: "a regular grid of clean rectangular flags with crisp pale
            // joints"); tilted up to 7 degrees, one in five broken, one in twelve gone.
            wear: (split: 0.45, tilt: 0.12, broken: 0.2, missing: 0.08, gap: 0.02, uneven: 0.6, round: 0.04),
            dirt: 0.7,
            damp: 0.6,
            feet: Site("walls"),
            // An abandoned court's grime (iso-kit j67, every ruin judge's first gap: "clean
            // flat slabs with crack decals"): earth and dark moss soaked 15 cm in from the
            // joints, blotches a metre to a hand, each flag its own staining; lichen crusts in
            // patches, dark damp spots 3-10 cm (under ~5 cm blurs away at the camera); dead
            // leaves drifted at the walls' feet and in the broken corners.
            grime: (edges: 0.15, blotch: 0.8, spots: 4.0, size: 0.1, earth: 1.0, lichen: 0.35, litter: 60.0),
        ),
    ),
    // The rain pool by the west brazier, the kit's water (kit/water.rs, ruin/water.rs, iso-kit
    // j38): a skin 2 cm over the flags (their settling is 1.5 cm about 0.01), so its line is
    // the face's fade over ruin/water.rs's depth, out on whole flags, not the paving's cut
    // ("stepped polygon rims and no wet edge", judge 261107-0302). Dark and still: a few cm
    // over the sunk flags shows them dim, black where they broke; the fires and the fight in
    // its mirror, each fire's streak across it, the moon's lane faint (as the marsh's).
    water: (
        kind: Pond,
        level: 0.03,
        deep: Srgb(0.02, 0.019, 0.018),
        absorb: (14.0, 13.0, 12.0),
        // Its face fades in over 3 cm, so the shallows shelve off the wet flags, and it
        // mirrors a dim moonlit sky and the walls (judge 261107-0507: "a black ink hole
        // with a hard ragged edge ... no sky, wall or wet-rim reflection").
        shore: 0.03,
        mirror: (lift: 5.0, distort: 0.02, sky: Linear(0.3, 0.36, 0.5), nits: 40.0),
        ripples: (fine: 0.7, broad: 3.0, steep: 0.02, calm: 0.9),
        streaks: (glitter: 0.1, gain: 0.6, key: 0.1, dash: 1.0),
    ),
    // The staged fight's effects (biomes/effects/, kit/effects.rs).
    effects: [(preset: "slash"), (preset: "hit-spark"), (preset: "smoke-puff"), (preset: "spell-burst"), (preset: "bolt")],
    // How the fighters stand off the court (ruin/fight.rs `cast`): Tripo's hide and bark
    // are the ground's value, so each is taken darker than the ground about it as the ARPGs'
    // creatures are (their crops: refs/creatures.json), measured on a magenta mask of each
    // body against a 10 px ring of ground (iso-art j34). The tree monster's crown is all
    // leaf edges, each taking the rim band, so it frosts: a share of it.
    bodies: {
        "models/iso/ogre.glb": (value: 0.5),
        "models/iso/tree-monster.glb": (value: 0.35, rim: 0.35),
    },
)
